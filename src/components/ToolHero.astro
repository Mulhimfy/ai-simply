---
/**
 * Tool page hero: breadcrumb, 72px logo, name + verified badge, one-liner,
 * category / subcategory / pricing pills, stars, updated date, and the CTA row
 * (Visit · Save · Compare · Share). Right column: the screenshot in a browser
 * frame that opens the site (lettermark placeholder when no screenshot exists).
 *
 * Contracts preserved from the old page:
 *   - Visit links use `affiliateUrl ?? url`, add rel="sponsored" when affiliate,
 *     and carry data-track="visit" → GA4 `outbound_click` event.
 *   - Save uses the same [data-save] attributes as ToolCard (localStorage 'aib-saved').
 *   - Compare uses the CompareTray contract ([data-compare] + name + logo).
 * Also renders the mobile sticky CTA bar (shown once the hero CTAs scroll away).
 */
import { CATEGORY_ICONS } from '../consts';
import Breadcrumb from './Breadcrumb.astro';
import ToolLogo from './ToolLogo.astro';
import Stars from './Stars.astro';
import Icon from './Icon.astro';

interface Props {
	slug: string;
	name: string;
	description: string;
	category?: { slug: string; name: string };
	subcategory?: string;
	subHref?: string;
	pricing: 'free' | 'freemium' | 'paid';
	rating?: number;
	ratingCount?: number;
	verified?: boolean;
	featured?: boolean;
	sponsored?: boolean;
	updated: Date;
	/** the tool's own site (used for the address bar) */
	url: string;
	/** affiliateUrl ?? url */
	visitUrl: string;
	isAffiliate: boolean;
	/** /tools/<slug>.jpg or null */
	shot?: string | null;
	/** /logos/<slug>.png or null — passed to the compare tray */
	logo?: string | null;
	shareUrl: string;
	crumbs: { name: string; href?: string }[];
}
const {
	slug, name, description, category, subcategory, subHref, pricing, rating, ratingCount,
	verified, featured, sponsored, updated, url, visitUrl, isAffiliate, shot, logo, shareUrl, crumbs,
} = Astro.props;

const label = { free: 'Free', freemium: 'Freemium', paid: 'Paid' }[pricing];
const host = new URL(url).hostname.replace(/^www\./, '');
const rel = `noopener noreferrer${isAffiliate ? ' sponsored' : ''}`;
const updatedText = updated.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
---
<section class="th">
	<div class="container th__inner">
		<div class="th__main">
			<Breadcrumb items={crumbs} class="th__crumbs" />

			<div class="th__id">
				<ToolLogo slug={slug} name={name} size={72} class="th__logo" />
				<div class="th__name-wrap">
					<h1 class="th__name">
						<span>{name}</span>
						{verified && <span class="th__verified" title="Tested hands-on by AI Briefs"><Icon name="badge-check" size={22} /><span class="sr-only">Verified</span></span>}
					</h1>
					<p class="th__desc">{description}</p>
				</div>
			</div>

			<div class="th__pills">
				{category && (
					<a href={`/tools/category/${category.slug}/`} class="pill pill--outline th__pill-link">
						<Icon name={CATEGORY_ICONS[category.slug] ?? 'boxes'} size={12} /> {category.name}
					</a>
				)}
				{subcategory && (subHref
					? <a href={subHref} class="pill pill--outline th__pill-link">{subcategory}</a>
					: <span class="pill pill--outline">{subcategory}</span>)}
				<span class:list={['pill', `pill--${pricing}`]}>{label}</span>
				{sponsored && <span class="pill pill--ink">Sponsored</span>}
				{!sponsored && featured && <span class="pill pill--accent"><Icon name="star" size={10} /> Editor's pick</span>}
			</div>

			<div class="th__meta">
				{rating
					? <span class="th__rating"><Stars rating={rating} count={ratingCount} size={16} /><a href="/rating-methodology/" class="th__score">Editorial score</a></span>
					: <span class="th__unrated"><Icon name="clock" size={14} /> Not yet rated</span>}
				<span class="th__dot" aria-hidden="true"></span>
				<span class="th__updated">Updated <time datetime={updated.toISOString()}>{updatedText}</time></span>
			</div>

			<div class="th__ctas" data-hero-ctas>
				<a href={visitUrl} target="_blank" rel={rel} class="btn btn--accent btn--lg th__visit" data-track="visit">
					Visit {name} <Icon name="arrow-up-right" class="icon--arrow" />
				</a>
				<button type="button" class="btn btn--ghost btn--lg th__save" data-save={slug} data-save-name={name} aria-pressed="false" title="Save to My tools">
					<Icon name="bookmark" /><span class="th__save-off">Save</span><span class="th__save-on">Saved</span>
				</button>
				<button type="button" class="btn btn--ghost btn--lg th__compare" data-compare={slug} data-compare-name={name} data-compare-logo={logo ?? undefined} aria-pressed="false" title="Add to compare">
					<Icon name="git-compare" /><span data-compare-label>Compare</span>
				</button>
				<button
					type="button" class="btn btn--ghost btn--lg th__share"
					data-hero-share data-share-title={`${name} review — AI Briefs`} data-share-url={shareUrl}
					data-share-text={`${name}: our review, pros and cons, and what to use instead.`}
					title="Share this review"
				>
					<Icon name="share" /><span class="th__share-label">Share</span>
				</button>
			</div>
		</div>

		<div class="th__side" data-reveal="right">
			<a href={visitUrl} target="_blank" rel={rel} class="frame" data-tilt data-track="visit" aria-label={`Open ${name} in a new tab`}>
				<span class="frame__bar" aria-hidden="true">
					<span class="frame__dots"><i></i><i></i><i></i></span>
					<span class="frame__url"><Icon name="lock" size={10} /> {host}</span>
					<span class="frame__ext"><Icon name="arrow-up-right" size={14} /></span>
				</span>
				{shot
					? <img class="frame__shot" src={shot} alt={`${name} screenshot`} width="1200" height="630" loading="eager" fetchpriority="high" decoding="async" />
					: (
						<span class="frame__empty bg-dots" aria-hidden="true">
							<ToolLogo slug={slug} name={name} size={96} />
							<span class="frame__empty-host meta">{host}</span>
						</span>
					)}
				<span class="frame__hint"><Icon name="arrow-up-right" size={14} /> Open site</span>
			</a>
		</div>
	</div>
</section>

<!-- Mobile sticky CTA bar: appears once the hero CTAs have scrolled out of view -->
<div class="cta-bar glass" data-cta-bar aria-hidden="true">
	<div class="cta-bar__inner">
		<a href={visitUrl} target="_blank" rel={rel} class="btn btn--accent cta-bar__visit" data-track="visit" tabindex="-1">
			Visit {name} <Icon name="arrow-up-right" />
		</a>
		<button type="button" class="btn btn--ghost btn--icon" data-save={slug} data-save-name={name} aria-pressed="false" aria-label={`Save ${name}`} tabindex="-1"><Icon name="bookmark" /></button>
		<button type="button" class="btn btn--ghost btn--icon" data-compare={slug} data-compare-name={name} data-compare-logo={logo ?? undefined} aria-pressed="false" aria-label={`Compare ${name}`} tabindex="-1"><Icon name="git-compare" /></button>
	</div>
</div>

<script>
	/* GA4: outbound "visit" clicks (same event + payload as the old page). */
	function bindVisit() {
		if ((document as any).__visitBound) return;
		(document as any).__visitBound = true;
		document.addEventListener('click', (e) => {
			const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('[data-track="visit"]');
			if (!a) return;
			const g = (window as any).gtag;
			if (typeof g === 'function') g('event', 'outbound_click', { url: a.href });
		});
	}

	/* Save (bookmark) — identical contract to ToolCard so the two stay in sync. */
	const KEY = 'aib-saved';
	function saved(): Record<string, string> { try { return JSON.parse(localStorage.getItem(KEY) || '{}'); } catch { return {}; } }
	function paintSaved() {
		const s = saved();
		document.querySelectorAll<HTMLButtonElement>('[data-save]').forEach((b) => b.setAttribute('aria-pressed', String(!!s[b.dataset.save!])));
		document.querySelectorAll<HTMLElement>('[data-saved-count]').forEach((el) => { const n = Object.keys(s).length; el.textContent = String(n); el.toggleAttribute('hidden', n === 0); });
	}
	function bindSave() {
		if ((document as any).__saveBound) { paintSaved(); return; }
		(document as any).__saveBound = true;
		document.addEventListener('click', (e) => {
			const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-save]');
			if (!b) return;
			e.preventDefault();
			const s = saved(); const slug = b.dataset.save!;
			const on = !s[slug];
			if (on) s[slug] = b.dataset.saveName || slug; else delete s[slug];
			try { localStorage.setItem(KEY, JSON.stringify(s)); } catch {}
			b.classList.remove('is-pop'); void b.offsetWidth; b.classList.add('is-pop');
			paintSaved();
			(window as any).__aib?.toast(on ? `Saved ${b.dataset.saveName} · view in My tools` : 'Removed from saved');
			document.dispatchEvent(new CustomEvent('aib:saved-change', { detail: s }));
		});
		document.addEventListener('astro:page-load', paintSaved);
		paintSaved();
	}

	/* Mobile sticky CTA bar: show when the hero CTA row is above the viewport. */
	function bindBar() {
		const bar = document.querySelector<HTMLElement>('[data-cta-bar]:not([data-bound])');
		const ctas = document.querySelector<HTMLElement>('[data-hero-ctas]');
		if (!bar || !ctas) return;
		bar.dataset.bound = '1';
		const set = (show: boolean) => {
			bar.classList.toggle('is-in', show);
			bar.setAttribute('aria-hidden', String(!show));
			bar.querySelectorAll<HTMLElement>('a, button').forEach((el) => el.tabIndex = show ? 0 : -1);
		};
		if (!('IntersectionObserver' in window)) { set(true); return; }
		new IntersectionObserver(([en]) => set(!en.isIntersecting && en.boundingClientRect.top < 0), { threshold: 0 }).observe(ctas);
	}

	/* Hero share: native sheet where the OS has one, clipboard + toast everywhere else. */
	function bindShare() {
		document.querySelectorAll<HTMLButtonElement>('[data-hero-share]:not([data-bound])').forEach((btn) => {
			btn.dataset.bound = '1';
			btn.addEventListener('click', async () => {
				const d = btn.dataset;
				const payload = { title: d.shareTitle, text: d.shareText, url: d.shareUrl };
				const nav = navigator as any;
				if (typeof nav.share === 'function') {
					try { await nav.share(payload); (window as any).gtag?.('event', 'share', { method: 'native', content_id: d.shareUrl }); return; } catch { return; }
				}
				try { await navigator.clipboard.writeText(d.shareUrl!); } catch { return; }
				btn.classList.add('is-copied');
				setTimeout(() => btn.classList.remove('is-copied'), 1600);
				(window as any).__aib?.toast('Link copied');
				(window as any).gtag?.('event', 'share', { method: 'copy', content_id: d.shareUrl });
			});
		});
	}

	function init() { bindVisit(); bindSave(); bindBar(); bindShare(); }
	init();
	document.addEventListener('astro:page-load', init);
</script>

<style>
	.th { position: relative; padding: var(--s-8) 0 var(--s-12); border-bottom: 1px solid var(--line); overflow: hidden; }
	.th::before {
		content: ''; position: absolute; right: -10%; top: -40%; width: 48%; aspect-ratio: 1; border-radius: 50%; pointer-events: none;
		background: radial-gradient(closest-side, var(--accent-soft), transparent 72%); filter: blur(40px); opacity: 0.8;
	}
	.th__inner { position: relative; display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr); gap: var(--s-16); align-items: center; }
	.th__main { display: grid; gap: var(--s-6); align-content: start; }
	.th__main :global(.th__crumbs) { margin-bottom: var(--s-2); }
	.th__id { display: flex; gap: var(--s-5); align-items: flex-start; }
	/* <ToolLogo> is a child component root — scoped selectors never reach it. */
	.th__id :global(.th__logo) { box-shadow: var(--shadow-sm); }
	.th__name-wrap { display: grid; gap: var(--s-3); min-width: 0; }
	.th__name { display: flex; align-items: center; gap: var(--s-2); flex-wrap: wrap; font-size: var(--text-4xl); letter-spacing: -0.035em; line-height: 1.02; margin-top: 2px; }
	.th__verified { display: inline-flex; color: var(--info); flex-shrink: 0; }
	.th__desc { font-size: var(--text-lg); line-height: 1.5; color: var(--ink-2); max-width: 52ch; text-wrap: pretty; }
	.th__pills { display: flex; flex-wrap: wrap; gap: 8px; }
	.th__pill-link { transition: border-color var(--dur-2), color var(--dur-2), background-color var(--dur-2); }
	.th__pill-link:hover { border-color: var(--ink); color: var(--ink); background: var(--surface-2); }
	.th__meta { display: flex; align-items: center; flex-wrap: wrap; gap: var(--s-3); font-size: var(--text-sm); color: var(--ink-3); }
	.th__rating { display: inline-flex; align-items: center; gap: var(--s-3); }
	.th__rating :global(.rating__num) { font-weight: 600; color: var(--ink); }
	.th__score { font-size: var(--text-xs); color: var(--ink-3); text-decoration: underline; text-decoration-color: var(--line-strong); text-underline-offset: 3px; transition: color var(--dur-2); }
	.th__score:hover { color: var(--ink); }
	.th__unrated { display: inline-flex; align-items: center; gap: 6px; }
	.th__dot { width: 3px; height: 3px; border-radius: 50%; background: var(--ink-4); }
	.th__updated time { color: var(--ink-2); }
	.th__ctas { display: flex; align-items: center; flex-wrap: wrap; gap: var(--s-3); margin-top: var(--s-2); }
	.th__share.is-copied { --btn-fg: var(--good); border-color: var(--good); }
	.th__save[aria-pressed='true'] { --btn-fg: var(--accent-ink); border-color: var(--accent-soft-2); background: var(--accent-soft); }
	.th__save[aria-pressed='true'] :global(svg) { fill: currentColor; }
	.th__save-on { display: none; }
	.th__save[aria-pressed='true'] .th__save-off { display: none; }
	.th__save[aria-pressed='true'] .th__save-on { display: inline; }
	.th__save.is-pop { animation: th-pop 420ms var(--ease-spring); }
	@keyframes th-pop { 40% { transform: scale(1.06); } }
	.th__compare[aria-pressed='true'] { --btn-fg: var(--ink); border-color: var(--ink); }

	/* browser frame */
	.th__side { justify-self: end; width: 100%; max-width: 600px; }
	.frame {
		--rx: 0deg; --ry: 0deg;
		position: relative; display: block; border-radius: var(--r-lg); overflow: hidden;
		background: var(--surface); border: 1px solid var(--line); box-shadow: var(--shadow-lg);
		color: inherit;
	}
	.frame::after { content: ''; position: absolute; inset: 0; border-radius: inherit; pointer-events: none; background: radial-gradient(420px circle at var(--mx, 50%) var(--my, 50%), rgba(255,255,255,0.10), transparent 60%); opacity: 0; transition: opacity var(--dur-3); }
	.frame:hover::after { opacity: 1; }
	.frame__bar { display: flex; align-items: center; gap: var(--s-3); height: 40px; padding: 0 12px; background: var(--surface-2); border-bottom: 1px solid var(--line); }
	.frame__dots { display: inline-flex; gap: 5px; }
	.frame__dots i { width: 9px; height: 9px; border-radius: 50%; background: var(--line-strong); opacity: 0.6; }
	.frame__url { flex: 1; display: inline-flex; align-items: center; justify-content: center; gap: 6px; height: 24px; max-width: 320px; margin-inline: auto; padding: 0 12px; border-radius: var(--r-full); background: var(--surface); border: 1px solid var(--line); font-family: var(--font-mono); font-size: 0.6875rem; color: var(--ink-3); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
	.frame__ext { color: var(--ink-4); display: inline-flex; }
	.frame__shot { display: block; width: 100%; height: auto; aspect-ratio: 1200 / 630; object-fit: cover; object-position: top; background: var(--surface-2); transition: transform var(--dur-5) var(--ease-out); }
	.frame:hover .frame__shot { transform: scale(1.02); }
	.frame__empty { display: grid; place-items: center; align-content: center; gap: var(--s-4); aspect-ratio: 1200 / 630; background-color: var(--surface-2); }
	.frame__hint {
		position: absolute; right: 14px; bottom: 14px; display: inline-flex; align-items: center; gap: 6px; height: 32px; padding: 0 12px;
		border-radius: var(--r-full); background: var(--ink); color: var(--bg); font-size: var(--text-xs); font-weight: 600;
		opacity: 0; transform: translateY(6px); transition: opacity var(--dur-2), transform var(--dur-3) var(--ease-out);
	}
	.frame:hover .frame__hint, .frame:focus-visible .frame__hint { opacity: 1; transform: none; }

	/* mobile sticky CTA bar */
	.cta-bar {
		position: fixed; left: 0; right: 0; bottom: 0; z-index: calc(var(--z-header) - 1);
		border-top: 1px solid var(--line); padding: 10px var(--gutter) calc(10px + env(safe-area-inset-bottom));
		transform: translateY(110%); transition: transform var(--dur-4) var(--ease-out);
		display: none;
	}
	.cta-bar.is-in { transform: none; }
	.cta-bar__inner { display: flex; gap: 8px; align-items: center; }
	.cta-bar__visit { flex: 1; }
	.cta-bar [data-save][aria-pressed='true'] { --btn-fg: var(--accent-ink); background: var(--accent-soft); border-color: transparent; }
	.cta-bar [data-save][aria-pressed='true'] :global(svg) { fill: currentColor; }
	.cta-bar [data-compare][aria-pressed='true'] { --btn-fg: var(--ink); border-color: var(--ink); }

	@media (max-width: 1080px) { .th__inner { gap: var(--s-10); } }
	@media (max-width: 960px) {
		.th__inner { grid-template-columns: 1fr; gap: var(--s-8); }
		.th__side { justify-self: stretch; max-width: none; }
	}
	@media (max-width: 860px) {
		.cta-bar { display: block; }
		.th { padding-bottom: var(--s-8); }
	}
	@media (max-width: 640px) {
		.th__id { gap: var(--s-4); }
		/* ToolLogo writes --mark inline from its `size` prop, so the override needs !important. */
		.th__id :global(.th__logo) { --mark: 56px !important; }
		.th__name { font-size: var(--text-3xl); }
		.th__desc { font-size: var(--text-base); }
		.th__ctas { gap: 8px; }
		.th__ctas .btn--lg { height: 46px; padding-inline: var(--s-4); font-size: var(--text-sm); }
		.th__visit { width: 100%; }
	}
</style>
