---
/**
 * Article card. variants: 'feature' (large, image-led), 'grid' (default), 'row' (compact list), 'text' (no image)
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { BLOG_CATEGORIES } from '../consts';
import Icon from './Icon.astro';

interface Props {
	slug: string;
	title: string;
	description: string;
	category: string;
	pubDate: Date;
	readingTime?: string;
	heroImage?: ImageMetadata;
	author?: string;
	variant?: 'feature' | 'grid' | 'row' | 'text';
	index?: number;
	eager?: boolean;
	class?: string;
}
const { slug, title, description, category, pubDate, readingTime, heroImage, author, variant = 'grid', index, eager = false, class: className } = Astro.props;
const cat = BLOG_CATEGORIES[category] ?? { name: category.replace(/-/g, ' '), icon: 'file-text' };
const date = pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
const widths = variant === 'feature' ? [640, 960, 1400] : [400, 640, 960];
const sizes = variant === 'feature' ? '(max-width: 900px) 100vw, 60vw' : variant === 'row' ? '200px' : '(max-width: 640px) 100vw, 33vw';
---
<article class:list={['ac', `ac--${variant}`, className]} data-category={category}>
	<a href={`/blog/${slug}/`} class="ac__link">
		{variant !== 'text' && (
			<div class="ac__media">
				{heroImage
					? <Image src={heroImage} alt="" widths={widths} sizes={sizes} loading={eager ? 'eager' : 'lazy'} decoding="async" />
					: <div class="ac__placeholder"><Icon name={cat.icon} size={28} /></div>}
				<span class="ac__kicker pill pill--ink">{cat.name}</span>
			</div>
		)}
		<div class="ac__body">
			{variant === 'text' && (
				<div class="ac__meta-top">
					{index != null && <span class="ac__index tnum">{String(index).padStart(2, '0')}</span>}
					<span class="eyebrow">{cat.name}</span>
				</div>
			)}
			<h3 class="ac__title">{title}</h3>
			{variant !== 'row' && <p class="ac__desc">{description}</p>}
			<div class="ac__meta">
				<time datetime={pubDate.toISOString()}>{date}</time>
				{readingTime && <><span class="ac__dot" aria-hidden="true">·</span><span>{readingTime}</span></>}
				{author && variant === 'feature' && <><span class="ac__dot" aria-hidden="true">·</span><span>{author}</span></>}
				<span class="ac__read">Read <Icon name="arrow-right" size={14} /></span>
			</div>
		</div>
	</a>
</article>

<style>
	.ac { position: relative; display: flex; }
	.ac__link { display: flex; flex-direction: column; flex: 1; gap: var(--s-4); color: inherit; }
	.ac__media { position: relative; overflow: hidden; border-radius: var(--r-md); background: var(--surface-2); border: 1px solid var(--line); aspect-ratio: 16 / 10; }
	.ac__media :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform var(--dur-5) var(--ease-out), filter var(--dur-5) var(--ease-out); }
	.ac:hover .ac__media :global(img) { transform: scale(1.035); }
	.ac__placeholder { width: 100%; height: 100%; display: grid; place-items: center; color: var(--ink-4); background: linear-gradient(135deg, var(--surface-2), var(--surface-3)); }
	.ac__kicker { position: absolute; left: 12px; top: 12px; }
	.ac__body { display: grid; gap: var(--s-2); align-content: start; }
	.ac__title { font-size: var(--text-lg); font-weight: 600; letter-spacing: -0.02em; line-height: 1.25; transition: color var(--dur-2); }
	.ac:hover .ac__title { color: var(--accent-ink); }
	.ac__desc { font-size: var(--text-sm); color: var(--ink-3); line-height: 1.55; display: -webkit-box; -webkit-line-clamp: 2; line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
	.ac__meta { display: flex; align-items: center; gap: var(--s-2); font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.04em; text-transform: uppercase; color: var(--ink-3); margin-top: var(--s-1); }
	.ac__dot { color: var(--ink-4); }
	.ac__read { margin-left: auto; display: inline-flex; align-items: center; gap: 4px; font-family: var(--font-sans); text-transform: none; letter-spacing: 0; font-size: var(--text-xs); font-weight: 600; color: var(--ink-3); opacity: 0; transform: translateX(-4px); transition: opacity var(--dur-2), transform var(--dur-2), color var(--dur-2); }
	.ac:hover .ac__read { opacity: 1; transform: none; color: var(--accent-ink); }

	/* feature */
	.ac--feature .ac__link { gap: var(--s-6); }
	.ac--feature .ac__media { aspect-ratio: 16 / 9; border-radius: var(--r-xl); }
	.ac--feature .ac__title { font-size: var(--text-3xl); letter-spacing: -0.03em; line-height: 1.08; }
	.ac--feature .ac__desc { font-size: var(--text-base); -webkit-line-clamp: 3; line-clamp: 3; color: var(--ink-2); }
	@media (min-width: 900px) {
		.ac--feature .ac__link { display: grid; grid-template-columns: 1.4fr 1fr; align-items: center; gap: var(--s-10); }
	}

	/* row */
	.ac--row .ac__link { flex-direction: row; align-items: center; gap: var(--s-4); padding: var(--s-3); margin: calc(var(--s-3) * -1); border-radius: var(--r-md); transition: background-color var(--dur-2); }
	.ac--row:hover .ac__link { background: var(--surface-2); }
	.ac--row .ac__media { width: 120px; aspect-ratio: 4 / 3; flex-shrink: 0; border-radius: var(--r-sm); }
	.ac--row .ac__kicker { display: none; }
	.ac--row .ac__title { font-size: var(--text-base); }
	.ac--row .ac__meta { margin: 0; }

	/* text */
	.ac--text { padding: var(--s-5) 0; border-top: 1px solid var(--line); }
	.ac--text:last-child { border-bottom: 1px solid var(--line); }
	.ac__meta-top { display: flex; align-items: center; gap: var(--s-3); }
	.ac__index { font-family: var(--font-serif); font-style: italic; font-size: var(--text-xl); color: var(--ink-4); line-height: 1; }
	.ac--text .ac__title { font-size: var(--text-xl); }
</style>
