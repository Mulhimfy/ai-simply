---
import { SITE_TITLE, TOOL_CATEGORIES, TOOL_LISTING, BEEHIIV_FORM_URL } from '../consts';
import Icon from './Icon.astro';
import BrandIcon from './BrandIcon.astro';
import Logo from './Logo.astro';
import Newsletter from './Newsletter.astro';

interface Props { noNudge?: boolean }
const { noNudge = false } = Astro.props;
const year = new Date().getFullYear();
const cats = TOOL_CATEGORIES.slice(0, 10);
---
<footer class="site-footer" role="contentinfo">
	<div class="container container--wide">
		<div class="footer-top">
			<div class="footer-brand">
				<a href="/" aria-label={`${SITE_TITLE} — home`}><Logo /></a>
				<p class="footer-tag">Know what matters in AI.<br />In <em class="serif">three minutes</em>. Every day.</p>
				<div class="footer-nl">
					<span class="footer-h">The brief</span>
					<Newsletter variant="inline" />
				</div>
			</div>
			<nav class="footer-cols" aria-label="Footer">
				<div class="footer-col">
					<span class="footer-h">Toolbox</span>
					<ul role="list">
						<li><a href="/tools/">All tools</a></li>
						<li><a href="/tools/quiz/">What to try</a></li>
						<li><a href="/tools/top-rated/">Top rated</a></li>
						<li><a href="/tools/new/">New tools</a></li>
						<li><a href="/tools/collections/">Collections</a></li>
						<li><a href="/tools/vs/">Comparisons</a></li>
						<li><a href="/tools/alternatives/">Alternatives</a></li>
					</ul>
				</div>
				<div class="footer-col">
					<span class="footer-h">Categories</span>
					<ul role="list">
						{cats.map((c) => <li><a href={`/tools/category/${c.slug}/`}>{c.name}</a></li>)}
					</ul>
				</div>
				<div class="footer-col">
					<span class="footer-h">Read</span>
					<ul role="list">
						<li><a href="/news/">Daily briefs</a></li>
						<li><a href="/blog/">Explainers</a></li>
						<li><a href="/reviews/">Reviews</a></li>
						<li><a href="/tutorials/">Tutorials</a></li>
						<li><a href="/rating-methodology/">How we rate</a></li>
						<li><a href="/author/">Authors</a></li>
						<li><a href="/rss.xml">RSS</a></li>
					</ul>
				</div>
				<div class="footer-col">
					<span class="footer-h">Company</span>
					<ul role="list">
						<li><a href="/about/">About</a></li>
						<li><a href="/contact/">Contact</a></li>
						<li><a href="/submit/">Submit a tool</a></li>
						<li><a href="/pricing/">Pricing</a></li>
						<li><a href="/privacy/">Privacy</a></li>
						<li><a href="/terms/">Terms</a></li>
						<li><a href={TOOL_LISTING.portalUrl} target="_blank" rel="noopener noreferrer">Manage or cancel listing</a></li>
					</ul>
				</div>
			</nav>
		</div>

		<div class="footer-bottom">
			<p class="footer-copy">© {year} {SITE_TITLE}. All rights reserved.</p>
			<div class="footer-meta">
				<a href="https://twitter.com/getaibriefs" target="_blank" rel="noopener noreferrer" class="footer-social" aria-label="AI Briefs on X"><BrandIcon name="x" size={15} /></a>
				<a href="/rss.xml" class="footer-social" aria-label="RSS feed"><Icon name="rss" size={16} /></a>
				<a href="/sitemap-index.xml" class="footer-link-sm">Sitemap</a>
				<a href="/proxy/" class="footer-link-sm">Proxy tool</a>
				<button type="button" class="footer-theme" data-theme-toggle>
					<Icon name="sun-moon" size={14} /> Theme
				</button>
			</div>
		</div>
	</div>

	{!noNudge && (
		<aside class="nudge" id="nl-nudge" hidden aria-label="Newsletter">
			<button type="button" class="nudge__close" data-nudge-close aria-label="Dismiss"><Icon name="x" size={16} /></button>
			<span class="eyebrow">Reading this?</span>
			<p class="nudge__title">Get the brief in your inbox. <em class="serif">Free.</em></p>
			<form class="nudge__form" action={BEEHIIV_FORM_URL} method="POST" target="_blank" rel="noopener" data-nl>
				<label class="sr-only" for="nudge-email">Email</label>
				<input id="nudge-email" class="input" type="email" name="email" required placeholder="you@example.com" />
				<button type="submit" class="btn btn--accent btn--icon" aria-label="Subscribe"><Icon name="arrow-right" /></button>
			</form>
		</aside>
	)}
</footer>

<script>
	// Newsletter nudge: shows once after 45% scroll, respects dismissals for 14 days and skips subscribers.
	function nudge() {
		const el = document.getElementById('nl-nudge');
		if (!el || (el as any).__bound) return;
		(el as any).__bound = true;
		try {
			if (localStorage.getItem('nl-subscribed')) return;
			const dismissed = Number(localStorage.getItem('nl-nudge-dismissed') || 0);
			if (Date.now() - dismissed < 14 * 864e5) return;
			// Don't ask on a first visit. The page already carries a newsletter band and
			// a footer form; a third ask to someone who has read nothing yet is noise.
			// Ask once the reader has come back — they have shown the habit is forming.
			const days = JSON.parse(localStorage.getItem('aib-news-days') || '[]');
			if (!Array.isArray(days) || days.length < 2) return;
		} catch { return; }
		let shown = false;
		function onScroll() {
			const p = scrollY / (document.documentElement.scrollHeight - innerHeight || 1);
			if (!shown && p > 0.45) {
				shown = true; el.hidden = false;
				document.body.classList.add('has-nudge');
				requestAnimationFrame(() => el.classList.add('is-in'));
				removeEventListener('scroll', onScroll);
			}
		}
		addEventListener('scroll', onScroll, { passive: true });
		el.querySelector('[data-nudge-close]')?.addEventListener('click', () => {
			el.classList.remove('is-in'); document.body.classList.remove('has-nudge');
			setTimeout(() => (el.hidden = true), 300);
			try { localStorage.setItem('nl-nudge-dismissed', String(Date.now())); } catch {}
		});
		el.querySelector('form')?.addEventListener('submit', () => setTimeout(() => {
			el.classList.remove('is-in'); document.body.classList.remove('has-nudge');
		}, 1200));
		// never sit on top of the footer — the footer has its own form
		addEventListener('scroll', () => {
			const f = document.querySelector('.site-footer');
			if (!f) return;
			el.classList.toggle('is-tucked', f.getBoundingClientRect().top < innerHeight - 40);
		}, { passive: true });
	}
	nudge();
	document.addEventListener('astro:page-load', nudge);
</script>

<style>
	.site-footer { border-top: 1px solid var(--line); background: var(--bg-sunk); margin-top: var(--section); }
	.footer-top { display: grid; grid-template-columns: 1.3fr 2fr; gap: var(--s-16); padding-block: var(--s-16) var(--s-12); }
	.footer-brand { display: grid; gap: var(--s-5); align-content: start; }
	.footer-tag { color: var(--ink-3); font-size: var(--text-base); line-height: 1.5; max-width: 32ch; }
	.footer-tag .serif { color: var(--ink); }
	.footer-nl { display: grid; gap: var(--s-3); margin-top: var(--s-2); }
	.footer-h { display: block; font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-3); margin-bottom: var(--s-4); }
	.footer-cols { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--s-8); }
	.footer-col ul { display: grid; gap: 10px; }
	.footer-col a { font-size: var(--text-sm); color: var(--ink-2); transition: color var(--dur-2); }
	.footer-col a:hover { color: var(--accent-ink); }
	.footer-bottom { display: flex; align-items: center; justify-content: space-between; gap: var(--s-4); flex-wrap: wrap; padding-block: var(--s-6); border-top: 1px solid var(--line); }
	.footer-copy { font-size: var(--text-xs); color: var(--ink-3); }
	.footer-meta { display: flex; align-items: center; gap: var(--s-3); }
	.footer-social { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; border: 1px solid var(--line-2); color: var(--ink-2); transition: all var(--dur-2); }
	.footer-social:hover { border-color: var(--ink); color: var(--ink); transform: translateY(-2px); }
	.footer-link-sm { font-size: var(--text-xs); color: var(--ink-3); }
	.footer-link-sm:hover { color: var(--ink); }
	.footer-theme { display: inline-flex; align-items: center; gap: 6px; font-size: var(--text-xs); color: var(--ink-3); padding: 6px 10px; border-radius: var(--r-full); border: 1px solid var(--line-2); }
	.footer-theme:hover { color: var(--ink); border-color: var(--line-strong); }

	.nudge {
		position: fixed; right: 20px; bottom: 20px; z-index: var(--z-toast); width: min(360px, calc(100vw - 40px));
		padding: var(--s-5); border-radius: var(--r-lg); background: var(--bg-elev); border: 1px solid var(--line); box-shadow: var(--shadow-lg);
		display: grid; gap: var(--s-3);
		opacity: 0; transform: translateY(16px) scale(0.98);
		transition: opacity var(--dur-3) var(--ease-out), transform var(--dur-4) var(--ease-spring);
	}
	.nudge.is-in { opacity: 1; transform: none; }
	.nudge.is-tucked { opacity: 0; transform: translateY(16px) scale(0.98); pointer-events: none; }
	.nudge__close { position: absolute; top: 10px; right: 10px; width: 28px; height: 28px; display: grid; place-items: center; border-radius: 50%; color: var(--ink-3); }
	.nudge__close:hover { background: var(--surface-2); color: var(--ink); }
	.nudge__title { font-size: var(--text-lg); font-weight: 600; letter-spacing: -0.02em; line-height: 1.2; }
	.nudge__form { display: flex; gap: var(--s-2); }
	.nudge__form .input { height: 44px; }

	@media (max-width: 1024px) { .footer-top { grid-template-columns: 1fr; gap: var(--s-10); } }
	@media (max-width: 640px) { .footer-cols { grid-template-columns: repeat(2, 1fr); } .nudge { display: none; } }
</style>
