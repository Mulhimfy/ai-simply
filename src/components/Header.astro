---
import { getCollection } from 'astro:content';
import { SITE_TITLE, TOOL_CATEGORIES, CATEGORY_ICONS, BEEHIIV_FORM_URL } from '../consts';
import Icon from './Icon.astro';
import Logo from './Logo.astro';

const pathname = Astro.url.pathname;
const tools = await getCollection('tools');
const counts: Record<string, number> = {};
for (const t of tools) counts[t.data.category] = (counts[t.data.category] ?? 0) + 1;
const topCats = [...TOOL_CATEGORIES].sort((a, b) => (counts[b.slug] ?? 0) - (counts[a.slug] ?? 0));
const is = (p: string) => (p === '/' ? pathname === '/' : p === '/tools/' ? pathname.startsWith('/tools/') && !pathname.startsWith('/tools/quiz') : pathname.startsWith(p));

const primary = [
	{ href: '/', label: 'Today' },
	{ href: '/news/', label: 'Briefs' },
	{ href: '/blog/', label: 'Explainers' },
	{ href: '/tools/', label: 'Toolbox', mega: true },
	{ href: '/tools/quiz/', label: 'What to try' },
];
---
<header class="site-header" role="banner" transition:persist="header">
	<div class="site-header__inner container container--wide">
		<a href="/" class="brand" aria-label={`${SITE_TITLE} — home`}>
			<Logo />
		</a>

		<nav class="nav" aria-label="Primary">
			<ul role="list" class="nav__list">
				{primary.map((item) => (
					<li class:list={['nav__item', { 'nav__item--mega': item.mega }]}>
						<a href={item.href} class:list={['nav__link', { 'is-active': is(item.href) }]} aria-current={is(item.href) ? 'page' : undefined}>
							{item.label}
							{item.mega && <Icon name="chevron-down" size={14} class="nav__caret" />}
						</a>
						{item.mega && (
							<div class="mega" role="region" aria-label="Browse AI tools">
								<div class="mega__inner">
									<div class="mega__cats">
										<div class="mega__head">
											<span class="eyebrow">Categories</span>
											<a href="/tools/" class="link-arrow">All {tools.length} tools <Icon name="arrow-right" /></a>
										</div>
										<ul role="list" class="mega__grid">
											{topCats.map((c) => (
												<li>
													<a href={`/tools/category/${c.slug}/`} class="mega__cat">
														<span class="mega__icon"><Icon name={CATEGORY_ICONS[c.slug] ?? 'box'} size={16} /></span>
														<span class="mega__cat-name">{c.name.replace(/^AI /, '')}</span>
														<span class="mega__count tnum">{counts[c.slug] ?? 0}</span>
													</a>
												</li>
											))}
										</ul>
									</div>
									<div class="mega__side">
										<a href="/tools/quiz/" class="mega__promo">
											<span class="eyebrow">Not sure where to start?</span>
											<span class="mega__promo-title">Find <em class="serif">your</em> tool in 60 seconds</span>
											<span class="mega__promo-cta">Take the quiz <Icon name="arrow-right" size={14} /></span>
										</a>
										<ul role="list" class="mega__links">
											<li><a href="/tools/top-rated/"><Icon name="trophy" size={16} /> Top rated</a></li>
											<li><a href="/tools/new/"><Icon name="sparkles" size={16} /> New this month</a></li>
											<li><a href="/tools/collections/"><Icon name="layers" size={16} /> Collections</a></li>
											<li><a href="/tools/alternatives/"><Icon name="shuffle" size={16} /> Alternatives</a></li>
											<li><a href="/submit/"><Icon name="plus-circle" size={16} /> Submit a tool</a></li>
										</ul>
									</div>
								</div>
							</div>
						)}
					</li>
				))}
			</ul>
		</nav>

		<div class="header-actions">
			<button type="button" class="search-trigger" data-palette-open aria-label="Search (⌘K)">
				<Icon name="search" size={16} />
				<span class="search-trigger__label">Search</span>
				<span class="search-trigger__kbd"><kbd class="kbd">⌘</kbd><kbd class="kbd">K</kbd></span>
			</button>
			<button type="button" class="icon-btn" data-theme-toggle aria-label="Toggle theme">
				<Icon name="sun" size={18} class="icon-sun" />
				<Icon name="moon" size={18} class="icon-moon" />
			</button>
			<a href="/saved/" class:list={['icon-btn', 'icon-btn--saved', { 'is-active': is('/saved/') }]} aria-label="My saved tools" title="My tools (g s)" aria-current={is('/saved/') ? 'page' : undefined}>
				<Icon name="bookmark" size={18} class="icon-bookmark" />
				<span class="saved-badge tnum" data-saved-count hidden aria-hidden="true">0</span>
			</a>
			<a href="#newsletter" class="btn btn--accent btn--sm header-cta" data-nl-focus>Get the brief</a>
			<button type="button" class="icon-btn menu-btn" data-menu-toggle aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
				<span class="menu-btn__bar"></span><span class="menu-btn__bar"></span>
			</button>
		</div>
	</div>

	<!-- Mobile drawer -->
	<div class="drawer" id="mobile-menu" hidden>
		<div class="drawer__inner container">
			<button type="button" class="drawer__search" data-palette-open><Icon name="search" size={18} /> Search tools, articles, news…</button>
			<nav aria-label="Mobile">
				<ul role="list" class="drawer__list">
					{primary.map((item, i) => (
						<li style={`--i:${i}`}><a href={item.href} class:list={['drawer__link', { 'is-active': is(item.href) }]}>{item.label}<Icon name="arrow-up-right" size={18} /></a></li>
					))}
					<li style="--i:5"><a href="/reviews/" class="drawer__link">Reviews<Icon name="arrow-up-right" size={18} /></a></li>
					<li style="--i:6"><a href="/submit/" class="drawer__link">Submit a tool<Icon name="arrow-up-right" size={18} /></a></li>
				</ul>
			</nav>
			<div class="drawer__cats">
				<span class="eyebrow">Categories</span>
				<div class="drawer__chips">
					{topCats.map((c) => <a href={`/tools/category/${c.slug}/`} class="chip"><Icon name={CATEGORY_ICONS[c.slug] ?? 'box'} size={14} />{c.name.replace(/^AI /, '')}</a>)}
				</div>
			</div>
			<a href={BEEHIIV_FORM_URL} target="_blank" rel="noopener" class="btn btn--accent btn--lg w-full">Get the daily brief</a>
		</div>
	</div>
</header>

<script>
	function bind() {
		const header = document.querySelector<HTMLElement>('.site-header');
		if (!header || (header as any).__bound) return;
		(header as any).__bound = true;
		const btn = header.querySelector<HTMLButtonElement>('[data-menu-toggle]');
		const drawer = header.querySelector<HTMLElement>('#mobile-menu');
		const bars = btn?.querySelectorAll('.menu-btn__bar');
		function setOpen(open: boolean) {
			if (!btn || !drawer) return;
			btn.setAttribute('aria-expanded', String(open));
			btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
			document.body.classList.toggle('menu-open', open);
			if (open) { drawer.hidden = false; requestAnimationFrame(() => drawer.classList.add('is-open')); }
			else { drawer.classList.remove('is-open'); setTimeout(() => { if (!drawer.classList.contains('is-open')) drawer.hidden = true; }, 360); }
		}
		btn?.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
		document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
		drawer?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
		document.addEventListener('astro:before-swap', () => setOpen(false));
		// mega menu: keyboard + touch friendliness
		header.querySelectorAll<HTMLElement>('.nav__item--mega').forEach((li) => {
			const link = li.querySelector('a');
			link?.addEventListener('keydown', (e: KeyboardEvent) => { if (e.key === 'ArrowDown') { e.preventDefault(); li.classList.add('is-open'); li.querySelector<HTMLElement>('.mega a')?.focus(); } });
			li.addEventListener('focusout', (e: FocusEvent) => { if (!li.contains(e.relatedTarget as Node)) li.classList.remove('is-open'); });
		});
		// Subscribe: scroll to the newsletter section on the page if present, else the footer form
		header.querySelector('[data-nl-focus]')?.addEventListener('click', (e) => {
			const target = document.querySelector<HTMLElement>('#newsletter') || document.querySelector<HTMLElement>('.footer-nl');
			if (target) { e.preventDefault(); target.scrollIntoView({ behavior: 'smooth', block: 'center' }); setTimeout(() => target.querySelector<HTMLInputElement>('input[type=email]')?.focus({ preventScroll: true }), 500); }
		});
	}
	bind();
	document.addEventListener('astro:page-load', bind);
</script>

<style>
	.site-header {
		--header-h: 64px;
		position: fixed; inset: 0 0 auto 0; z-index: var(--z-header);
		height: var(--header-h);
		border-bottom: 1px solid transparent;
		transition: transform var(--dur-3) var(--ease-out), background-color var(--dur-3) var(--ease-out), border-color var(--dur-3) var(--ease-out), box-shadow var(--dur-3) var(--ease-out);
	}
	.site-header.is-scrolled { background: var(--glass); backdrop-filter: blur(18px) saturate(1.6); -webkit-backdrop-filter: blur(18px) saturate(1.6); border-color: var(--line); }
	.site-header.is-hidden { transform: translateY(-100%); }
	body.menu-open .site-header { background: var(--bg); }
	.site-header__inner { height: 100%; display: flex; align-items: center; gap: var(--s-6); }
	.brand { display: inline-flex; align-items: center; flex-shrink: 0; }

	/* nav */
	.nav { display: flex; flex: 1; justify-content: center; }
	.nav__list { display: flex; align-items: center; gap: var(--s-1); }
	.nav__item { position: relative; }
	.nav__link {
		display: inline-flex; align-items: center; gap: 4px; height: 36px; padding: 0 var(--s-3);
		border-radius: var(--r-full); font-size: var(--text-sm); font-weight: 500; color: var(--ink-2);
		transition: color var(--dur-2) var(--ease-out), background-color var(--dur-2) var(--ease-out);
	}
	.nav__link:hover, .nav__item:hover > .nav__link, .nav__item.is-open > .nav__link { color: var(--ink); background: var(--surface-2); }
	.nav__link.is-active { color: var(--ink); }
	.nav__link.is-active::after { content: ''; position: absolute; left: 50%; bottom: -14px; width: 4px; height: 4px; border-radius: 50%; background: var(--accent); transform: translateX(-50%); }
	:global(.nav__caret) { transition: transform var(--dur-2) var(--ease-out); opacity: 0.6; }
	.nav__item:hover :global(.nav__caret), .nav__item.is-open :global(.nav__caret) { transform: rotate(180deg); }

	/* mega */
	.mega {
		position: absolute; top: calc(100% + 10px); left: 50%; transform: translateX(-50%) translateY(6px);
		width: min(880px, calc(100vw - 32px));
		opacity: 0; visibility: hidden; pointer-events: none;
		transition: opacity var(--dur-2) var(--ease-out), transform var(--dur-3) var(--ease-out), visibility 0s linear var(--dur-2);
	}
	.mega::before { content: ''; position: absolute; top: -14px; left: 0; right: 0; height: 14px; }
	.nav__item:hover > .mega, .nav__item.is-open > .mega, .nav__item:focus-within > .mega { opacity: 1; visibility: visible; pointer-events: auto; transform: translateX(-50%) translateY(0); transition-delay: 0s; }
	.mega__inner {
		display: grid; grid-template-columns: 1fr 260px;
		background: var(--bg-elev); border: 1px solid var(--line); border-radius: var(--r-lg);
		box-shadow: var(--shadow-lg); overflow: hidden;
	}
	.mega__cats { padding: var(--s-5) var(--s-6); }
	.mega__head { display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--s-4); }
	.mega__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px; }
	.mega__cat {
		display: flex; align-items: center; gap: var(--s-3); padding: 8px 10px; border-radius: var(--r-sm);
		font-size: var(--text-sm); color: var(--ink-2); transition: background-color var(--dur-1), color var(--dur-1);
	}
	.mega__cat:hover { background: var(--surface-2); color: var(--ink); }
	.mega__icon { display: grid; place-items: center; width: 28px; height: 28px; border-radius: 8px; background: var(--surface-2); color: var(--ink-3); flex-shrink: 0; transition: background-color var(--dur-2), color var(--dur-2); }
	.mega__cat:hover .mega__icon { background: var(--accent-soft); color: var(--accent-ink); }
	.mega__cat-name { flex: 1; font-weight: 500; }
	.mega__count { font-family: var(--font-mono); font-size: 0.6875rem; color: var(--ink-4); }
	.mega__side { background: var(--surface-2); border-left: 1px solid var(--line); padding: var(--s-5); display: grid; gap: var(--s-4); align-content: start; }
	.mega__promo {
		display: grid; gap: var(--s-2); padding: var(--s-4); border-radius: var(--r-md);
		background: var(--ink); color: var(--bg); position: relative; overflow: hidden;
	}
	.mega__promo::after { content: ''; position: absolute; right: -40px; top: -40px; width: 140px; height: 140px; border-radius: 50%; background: radial-gradient(closest-side, rgba(var(--accent-rgb), 0.6), transparent); filter: blur(10px); }
	.mega__promo .eyebrow { color: var(--accent); }
	.mega__promo-title { font-size: var(--text-lg); font-weight: 600; letter-spacing: -0.02em; line-height: 1.15; }
	.mega__promo-cta { display: inline-flex; align-items: center; gap: 6px; font-size: var(--text-sm); font-weight: 600; color: var(--accent); }
	.mega__links { display: grid; gap: 2px; }
	.mega__links a { display: flex; align-items: center; gap: var(--s-3); padding: 8px 10px; border-radius: var(--r-sm); font-size: var(--text-sm); color: var(--ink-2); }
	.mega__links a:hover { background: var(--surface-3); color: var(--ink); }

	/* actions */
	.header-actions { display: flex; align-items: center; gap: var(--s-2); flex-shrink: 0; }
	.search-trigger {
		display: inline-flex; align-items: center; gap: var(--s-2); height: 36px; padding: 0 10px 0 12px;
		border-radius: var(--r-full); border: 1px solid var(--line-2); background: var(--surface);
		color: var(--ink-3); font-size: var(--text-sm); transition: border-color var(--dur-2), color var(--dur-2), background-color var(--dur-2);
	}
	.search-trigger:hover { border-color: var(--line-strong); color: var(--ink); }
	.search-trigger__kbd { display: inline-flex; gap: 3px; margin-left: 6px; }
	.icon-btn {
		display: grid; place-items: center; width: 36px; height: 36px; border-radius: var(--r-full);
		color: var(--ink-2); transition: background-color var(--dur-2), color var(--dur-2);
	}
	.icon-btn:hover { background: var(--surface-2); color: var(--ink); }
	/* `class` on an <Icon> lands on a child component's <svg>, which never carries this
	   component's scope id — these rules must be :global() or they silently do nothing
	   (which left both theme glyphs stacked and overflowing the button). */
	.icon-btn :global(.icon-sun), .icon-btn :global(.icon-moon) { grid-area: 1 / 1; transition: transform var(--dur-3) var(--ease-spring), opacity var(--dur-2); }
	.icon-btn--saved { position: relative; }
	.icon-btn--saved :global(.icon-bookmark) { transition: transform var(--dur-2) var(--ease-spring), fill var(--dur-2); }
	.icon-btn--saved:hover :global(.icon-bookmark) { transform: translateY(-1px); }
	.icon-btn--saved.is-active { color: var(--accent-ink); }
	.icon-btn--saved.is-active :global(.icon-bookmark) { fill: currentColor; }
	.saved-badge {
		position: absolute; top: 3px; right: 1px; min-width: 16px; height: 16px; padding: 0 4px;
		display: grid; place-items: center; border-radius: var(--r-full);
		background: var(--accent); color: var(--on-accent); font-family: var(--font-mono); font-size: 0.625rem; font-weight: 700; line-height: 1;
		box-shadow: 0 0 0 2px var(--bg); pointer-events: none;
	}
	.site-header.is-scrolled .saved-badge { box-shadow: 0 0 0 2px var(--bg-elev); }
	:root[data-theme='dark'] .icon-btn :global(.icon-sun),
	:root:not([data-theme='dark']) .icon-btn :global(.icon-moon) { opacity: 0; transform: rotate(-90deg) scale(0.6); }
	.menu-btn { display: none; position: relative; }
	.menu-btn__bar { position: absolute; left: 10px; width: 16px; height: 1.5px; background: currentColor; border-radius: 2px; transition: transform var(--dur-3) var(--ease-out), top var(--dur-3) var(--ease-out); }
	.menu-btn__bar:nth-child(1) { top: 14px; } .menu-btn__bar:nth-child(2) { top: 20px; }
	.menu-btn[aria-expanded='true'] .menu-btn__bar:nth-child(1) { top: 17px; transform: rotate(45deg); }
	.menu-btn[aria-expanded='true'] .menu-btn__bar:nth-child(2) { top: 17px; transform: rotate(-45deg); }

	/* drawer */
	.drawer {
		position: fixed; inset: var(--header-h) 0 0 0; z-index: var(--z-drawer); background: var(--bg);
		overflow-y: auto; opacity: 0; transform: translateY(-8px);
		transition: opacity var(--dur-3) var(--ease-out), transform var(--dur-3) var(--ease-out);
	}
	.drawer.is-open { opacity: 1; transform: none; }
	.drawer__inner { padding-block: var(--s-6) var(--s-10); display: grid; gap: var(--s-8); }
	.drawer__search { display: flex; align-items: center; gap: var(--s-3); height: 52px; padding: 0 var(--s-4); border-radius: var(--r-md); border: 1px solid var(--line-2); background: var(--surface); color: var(--ink-3); text-align: left; width: 100%; }
	.drawer__list { display: grid; }
	.drawer__list li { opacity: 0; transform: translateY(10px); transition: opacity var(--dur-4) var(--ease-out), transform var(--dur-4) var(--ease-out); transition-delay: calc(var(--i) * 40ms + 60ms); }
	.drawer.is-open .drawer__list li { opacity: 1; transform: none; }
	.drawer__link { display: flex; align-items: center; justify-content: space-between; padding: var(--s-4) 0; border-bottom: 1px solid var(--line); font-size: var(--text-2xl); font-weight: 600; letter-spacing: -0.03em; }
	.drawer__link .icon { color: var(--ink-4); }
	.drawer__link.is-active { color: var(--accent-ink); }
	.drawer__cats { display: grid; gap: var(--s-3); }
	.drawer__chips { display: flex; flex-wrap: wrap; gap: var(--s-2); }

	@media (max-width: 1024px) {
		.nav { display: none; }
		.menu-btn { display: grid; }
		.header-cta { display: none; }
	}
	@media (max-width: 640px) {
		.search-trigger { width: 36px; padding: 0; justify-content: center; }
		.search-trigger__label, .search-trigger__kbd { display: none; }
	}
	@media (min-width: 1025px) { .drawer { display: none; } }
</style>
