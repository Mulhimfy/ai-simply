---
/**
 * Share bar: copy link, X, LinkedIn, WhatsApp, Reddit, native share (mobile).
 * Every share is a growth loop — keep it one tap. Brand glyphs come from
 * BrandIcon (Lucide has no brand icons; using it would render blank circles).
 */
import Icon from './Icon.astro';
import BrandIcon from './BrandIcon.astro';

interface Props {
	title: string;
	url?: string;
	/** the sentence that gets posted — write it for a human, not for SEO */
	text?: string;
	compact?: boolean;
	class?: string;
	label?: string;
}
const { title, url, text, compact = false, class: className, label = 'Share' } = Astro.props;
const shareUrl = url ?? new URL(Astro.url.pathname, Astro.site).toString();
const shareText = text ?? title;
const t = encodeURIComponent(shareText);
const u = encodeURIComponent(shareUrl);
const links = [
	{ name: 'X', href: `https://twitter.com/intent/tweet?text=${t}&url=${u}&via=getaibriefs`, icon: 'x' },
	{ name: 'LinkedIn', href: `https://www.linkedin.com/sharing/share-offsite/?url=${u}`, icon: 'linkedin' },
	{ name: 'WhatsApp', href: `https://wa.me/?text=${t}%20${u}`, icon: 'whatsapp' },
	{ name: 'Reddit', href: `https://www.reddit.com/submit?url=${u}&title=${encodeURIComponent(title)}`, icon: 'reddit' },
];
---
<div
	class:list={['share', { 'share--compact': compact }, className]}
	data-share
	data-share-title={title}
	data-share-url={shareUrl}
	data-share-text={shareText}
>
	{!compact && <span class="share__label">{label}</span>}
	<button type="button" class="share__btn share__copy" data-copy={shareUrl} data-copy-msg="Link copied — go on, send it" aria-label="Copy link">
		<Icon name="link" size={16} /><span class="share__txt">Copy link</span>
	</button>
	{links.map((l) => (
		<a href={l.href} target="_blank" rel="noopener noreferrer" class="share__btn share__net" aria-label={`Share on ${l.name}`} title={`Share on ${l.name}`} data-share-net={l.name}>
			<BrandIcon name={l.icon} size={15} />
		</a>
	))}
	<button type="button" class="share__btn share__net share__native" data-share-native aria-label="Share…" title="Share" hidden>
		<Icon name="share" size={16} />
	</button>
</div>

<script>
	function bind() {
		document.querySelectorAll<HTMLElement>('[data-share]:not([data-bound])').forEach((el) => {
			el.dataset.bound = '1';
			const native = el.querySelector<HTMLButtonElement>('[data-share-native]');
			if (native && (navigator as any).share) {
				native.hidden = false;
				native.addEventListener('click', () =>
					(navigator as any)
						.share({ title: el.dataset.shareTitle, text: el.dataset.shareText, url: el.dataset.shareUrl })
						.then(() => (window as any).gtag?.('event', 'share', { method: 'native', content_id: el.dataset.shareUrl }))
						.catch(() => {}),
				);
			}
			el.querySelectorAll('[data-share-net]').forEach((a) =>
				a.addEventListener('click', () =>
					(window as any).gtag?.('event', 'share', { method: (a as HTMLElement).dataset.shareNet, content_id: el.dataset.shareUrl }),
				),
			);
		});
	}
	bind();
	document.addEventListener('astro:page-load', bind);
</script>

<style>
	.share { display: inline-flex; align-items: center; gap: 6px; flex-wrap: wrap; }
	.share__label {
		font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.1em; text-transform: uppercase;
		color: var(--ink-3); margin-right: 6px;
	}
	.share__btn {
		display: inline-flex; align-items: center; justify-content: center; gap: 6px;
		height: 36px; padding: 0 12px; border-radius: var(--r-full);
		border: 1px solid var(--line-2); color: var(--ink-2); background: var(--surface);
		font-size: var(--text-xs); font-weight: 600;
		transition: color var(--dur-2), border-color var(--dur-2), transform var(--dur-2) var(--ease-out), background-color var(--dur-2);
	}
	.share__net { width: 36px; padding: 0; }
	.share__btn:hover { color: var(--ink); border-color: var(--ink); transform: translateY(-1px); }
	.share__btn:active { transform: translateY(0) scale(0.96); }
	.share__copy.is-copied { color: var(--good); border-color: var(--good); }
	.share--compact .share__txt { display: none; }
	.share--compact .share__copy { width: 36px; padding: 0; }
	@media (pointer: coarse) {
		.share__btn { height: 44px; }
		.share__net, .share--compact .share__copy { width: 44px; }
	}
</style>
