---
/** Accessible star rating with half-star support. */
interface Props { rating: number; count?: number; size?: number; showNumber?: boolean; class?: string; }
const { rating, count, size = 14, showNumber = true, class: className } = Astro.props;
const r = Math.max(0, Math.min(5, rating));
const stars = [1, 2, 3, 4, 5].map((i) => (r >= i ? 'full' : r >= i - 0.5 ? 'half' : 'empty'));
const uid = Math.random().toString(36).slice(2, 7);
---
<span class:list={['rating', className]} aria-label={`Rated ${r.toFixed(1)} out of 5${count ? ` from ${count.toLocaleString()} ratings` : ''}`}>
	<span class="stars" aria-hidden="true">
		{stars.map((s, i) => (
			<svg width={size} height={size} viewBox="0 0 24 24" class="icon">
				{s === 'half' && (
					<defs><linearGradient id={`half-${uid}-${i}`}><stop offset="50%" stop-color="currentColor" /><stop offset="50%" stop-color="transparent" /></linearGradient></defs>
				)}
				<path
					d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.4 6.1 20.6l1.3-6.6L2.5 9.4l6.6-.8z"
					fill={s === 'full' ? 'currentColor' : s === 'half' ? `url(#half-${uid}-${i})` : 'transparent'}
					stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"
					opacity={s === 'empty' ? 0.35 : 1}
				/>
			</svg>
		))}
	</span>
	{showNumber && <span class="rating__num tnum">{r.toFixed(1)}</span>}
	{count != null && <span class="muted tnum" style="font-size:var(--text-xs)">({count.toLocaleString()})</span>}
</span>
