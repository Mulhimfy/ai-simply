---
/**
 * Inline SVG icon from the Lucide set (ISC licence), read at build time.
 * Usage: <Icon name="sparkles" size={18} class="..." />
 * Any icon name in node_modules/lucide-static/icons/*.svg is valid.
 */
import { readFileSync } from 'node:fs';
import { createRequire } from 'node:module';

interface Props {
	name: string;
	size?: number | string;
	strokeWidth?: number;
	class?: string;
	title?: string;
}

const { name, size = 20, strokeWidth = 1.75, class: className, title } = Astro.props;
const require = createRequire(import.meta.url);

let inner = '';
try {
	const file = require.resolve(`lucide-static/icons/${name}.svg`);
	const raw = readFileSync(file, 'utf8');
	inner = raw.replace(/^[\s\S]*?<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '').replace(/<!--[\s\S]*?-->/g, '');
} catch {
	// Unknown icon: render a subtle placeholder circle so the build never breaks.
	inner = '<circle cx="12" cy="12" r="9" />';
}
---
<svg
	xmlns="http://www.w3.org/2000/svg"
	width={size}
	height={size}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width={strokeWidth}
	stroke-linecap="round"
	stroke-linejoin="round"
	class:list={['icon', `icon-${name}`, className]}
	aria-hidden={title ? undefined : 'true'}
	role={title ? 'img' : undefined}
	set:html={(title ? `<title>${title}</title>` : '') + inner}
/>
