---
/**
 * The one newsletter component. Posts to Beehiiv (opens the hosted confirm page).
 * variants:
 *   band   — full-width ink section with the big promise (homepage, hubs)
 *   card   — bordered card for sidebars / article ends
 *   inline — bare form row (footer, drawers)
 */
import { BEEHIIV_FORM_URL } from '../consts';
import Icon from './Icon.astro';

interface Props {
	variant?: 'band' | 'card' | 'inline';
	heading?: string;
	text?: string;
	id?: string;
	class?: string;
}
const {
	variant = 'card',
	heading = 'The brief, in your *inbox*.',
	text = 'The same brief you just read, delivered. What changed in AI, why it matters, and what to do about it. Free, and one click to leave.',
	id = 'newsletter',
	class: className,
} = Astro.props;
const uid = Math.random().toString(36).slice(2, 7);
---
{variant === 'inline' ? (
	<form class:list={['nl-form', className]} action={BEEHIIV_FORM_URL} method="POST" target="_blank" rel="noopener" data-nl>
		<label class="sr-only" for={`nl-${uid}`}>Email address</label>
		<input id={`nl-${uid}`} class="input nl-form__input" type="email" name="email" required placeholder="you@example.com" autocomplete="email" />
		<button type="submit" class="btn btn--accent">Subscribe <Icon name="arrow-right" class="icon--arrow" /></button>
	</form>
) : (
	<section id={id} class:list={['nl', `nl--${variant}`, { 'on-ink': variant === 'band' }, className]} aria-label="Newsletter">
		<div class:list={['nl__inner', { container: variant === 'band' }]}>
			<div class="nl__copy">
				<span class="eyebrow">The brief</span>
				<h2 class="nl__title" set:html={heading.replace(/\*(.+?)\*/g, '<em class="serif">$1</em>')} />
				<p class="nl__text">{text}</p>
			</div>
			<div class="nl__form-wrap">
				<form class="nl-form" action={BEEHIIV_FORM_URL} method="POST" target="_blank" rel="noopener" data-nl>
					<label class="sr-only" for={`nl-${uid}`}>Email address</label>
					<input id={`nl-${uid}`} class="input nl-form__input" type="email" name="email" required placeholder="you@example.com" autocomplete="email" />
					<button type="submit" class="btn btn--accent">Get the brief <Icon name="arrow-right" class="icon--arrow" /></button>
				</form>
				<p class="nl__fine"><Icon name="lock" size={12} /> Free. No spam, no selling your address, unsubscribe in one click.</p>
			</div>
		</div>
	</section>
)}

<script>
	// Optimistic feedback: Beehiiv opens in a new tab; we thank the reader in place.
	function bind() {
		document.querySelectorAll<HTMLFormElement>('form[data-nl]:not([data-bound])').forEach((f) => {
			f.dataset.bound = '1';
			f.addEventListener('submit', () => {
				const btn = f.querySelector('button');
				if (btn) { btn.textContent = 'Check your inbox'; btn.classList.add('is-done'); }
				(window as any).__aib?.toast('Almost there — confirm in the tab that just opened');
				try { localStorage.setItem('nl-subscribed', String(Date.now())); } catch {}
			});
		});
	}
	bind();
	document.addEventListener('astro:page-load', bind);
</script>

<style>
	.nl-form { display: flex; gap: var(--s-2); width: 100%; max-width: 520px; }
	.nl-form__input { flex: 1 1 auto; min-width: 0; min-height: 48px; }
	.nl-form .btn.is-done { --btn-bg: var(--good); --btn-fg: #fff; }
	/* stacking makes this a column flex line — without `flex: none` the 48px height
	   collapses to the content box (a 22px input). */
	@media (max-width: 480px) {
		.nl-form { flex-direction: column; }
		.nl-form__input { flex: none; height: 48px; }
		.nl-form .btn { width: 100%; }
	}

	.nl--band { background: var(--ink); color: var(--bg); position: relative; overflow: hidden; }
	.nl--band::before { content: ''; position: absolute; left: -10%; top: -60%; width: 50%; aspect-ratio: 1; border-radius: 50%; background: radial-gradient(closest-side, rgba(var(--accent-rgb), 0.55), transparent 70%); filter: blur(60px); pointer-events: none; }
	.nl--band::after { content: ''; position: absolute; inset: 0; background-image: radial-gradient(rgba(255,255,255,0.08) 1px, transparent 1px); background-size: 22px 22px; mask-image: linear-gradient(90deg, transparent, #000 60%); -webkit-mask-image: linear-gradient(90deg, transparent, #000 60%); pointer-events: none; }
	.nl--band .nl__inner { position: relative; z-index: 1; display: grid; grid-template-columns: 1.2fr 1fr; gap: var(--s-12); align-items: center; padding-block: var(--section); }
	.nl--band .nl__title { color: inherit; font-size: var(--text-4xl); }
	/* the band inverts between themes, so every foreground derives from currentColor
	   rather than a hardcoded white alpha (which was invisible in dark). */
	.nl--band .nl__text { color: inherit; opacity: 0.74; }
	/* the band paints itself with --ink, so it inverts against the theme: take the
	   accent from the inverted ramp (.on-ink) or it reads at 2.8:1 in dark. */
	.nl--band .eyebrow { color: var(--accent-ink); }
	.nl--band .input { background: color-mix(in srgb, currentColor 7%, transparent); border-color: color-mix(in srgb, currentColor 22%, transparent); color: inherit; }
	.nl--band .input::placeholder { color: inherit; opacity: 0.5; }
	.nl--band .nl__fine { color: inherit; opacity: 0.66; }

	.nl--card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-xl); padding: clamp(1.5rem, 4vw, 2.5rem); position: relative; overflow: hidden; }
	.nl--card::before { content: ''; position: absolute; right: -60px; top: -60px; width: 220px; height: 220px; border-radius: 50%; background: radial-gradient(closest-side, var(--accent-soft-2), transparent 70%); pointer-events: none; }
	.nl--card .nl__inner { position: relative; display: grid; gap: var(--s-6); }
	.nl--card .nl__title { font-size: var(--text-2xl); }

	.nl__copy { display: grid; gap: var(--s-3); }
	.nl__text { max-width: 46ch; line-height: 1.55; }
	.nl__form-wrap { display: grid; gap: var(--s-3); }
	.nl__fine { display: flex; align-items: center; gap: 6px; font-size: var(--text-xs); color: var(--ink-3); }
	@media (max-width: 820px) { .nl--band .nl__inner { grid-template-columns: 1fr; gap: var(--s-8); } }
</style>
