---
/**
 * The tool card. Fixed field order everywhere on the site:
 *   media (screenshot) → logo + name + pricing → one-line value prop → rating · category → save
 * variants: 'grid' (default, with screenshot), 'row' (compact list), 'mini' (logo + name only)
 */
import { existsSync } from 'node:fs';
import { TOOL_CATEGORIES } from '../consts';
import ToolLogo from './ToolLogo.astro';
import Stars from './Stars.astro';
import Icon from './Icon.astro';

interface Props {
	slug: string;
	name: string;
	description: string;
	category: string;
	subcategory?: string;
	pricing: 'free' | 'freemium' | 'paid';
	rating?: number;
	ratingCount?: number;
	tags?: string[];
	featured?: boolean;
	sponsored?: boolean;
	verified?: boolean;
	pubDate?: Date;
	variant?: 'grid' | 'row' | 'mini';
	/** show the screenshot media block (grid only) */
	media?: boolean;
	eager?: boolean;
	/** hold the screenshot/logo back from the HTML (see ToolLogo.defer) */
	defer?: boolean;
	class?: string;
}
const {
	slug, name, description, category, subcategory, pricing, rating, ratingCount, tags = [],
	featured, sponsored, verified, pubDate, variant = 'grid', media = true, eager = false, defer = false,
	class: className,
} = Astro.props;

const cat = TOOL_CATEGORIES.find((c) => c.slug === category);
const shot = existsSync(`public/tools/${slug}.jpg`) ? `/tools/${slug}.jpg` : null;
const isNew = pubDate ? Date.now() - pubDate.valueOf() < 30 * 864e5 : false;
const label = { free: 'Free', freemium: 'Freemium', paid: 'Paid' }[pricing];
---
<article
	class:list={['tc', `tc--${variant}`, { 'tc--sponsored': sponsored, 'tc--has-media': variant === 'grid' && media }, className]}
	data-slug={slug} data-category={category} data-pricing={pricing} data-rating={rating ?? 0}
	data-name={name.toLowerCase()} data-subcat={subcategory ?? ''} data-desc={description.toLowerCase()} data-tags={tags.join(' ').toLowerCase()}
	data-date={pubDate ? pubDate.toISOString() : ''}
>
	<a href={`/tools/${slug}/`} class="tc__link" aria-label={`${name} — ${description}`}>
		{variant === 'grid' && media && (
			<div class:list={['tc__media', { 'tc__media--empty': !shot }]}>
				{shot
					? <img {...(defer ? { 'data-src': shot } : { src: shot })} alt="" width="1200" height="630" loading={eager ? 'eager' : 'lazy'} decoding="async" />
					: (
						<span class="tc__media-fallback">
							<ToolLogo slug={slug} name={name} size={56} {defer} />
							<span class="tc__media-cat">{subcategory ?? cat?.name ?? category}</span>
						</span>
					)}
				<div class="tc__media-badges">
					{sponsored && <span class="pill pill--ink">Sponsored</span>}
					{!sponsored && featured && <span class="pill pill--accent"><Icon name="star" size={10} /> Editor's pick</span>}
					{isNew && <span class="pill pill--ink">New</span>}
				</div>
			</div>
		)}
		<div class="tc__body">
			<div class="tc__top">
				<ToolLogo slug={slug} name={name} size={variant === 'mini' ? 32 : variant === 'row' ? 40 : 44} {defer} />
				<div class="tc__id">
					<h3 class="tc__name">
						<span>{name}</span>
						{verified && <span class="tc__verified" title="Tested by AI Briefs"><Icon name="badge-check" size={15} /></span>}
					</h3>
					{variant !== 'mini' && <span class="tc__cat">{subcategory ?? cat?.name ?? category}</span>}
				</div>
				<span class:list={['pill', `pill--${pricing}`, 'tc__price']}>{label}</span>
			</div>
			{variant !== 'mini' && <p class="tc__desc">{description}</p>}
			{variant !== 'mini' && (
				<div class="tc__foot">
					{rating ? <Stars rating={rating} count={variant === 'grid' ? ratingCount : undefined} size={12} /> : <span class="tc__unrated">Not yet rated</span>}
					<span class="tc__go">Details <Icon name="arrow-right" size={14} /></span>
				</div>
			)}
		</div>
	</a>
	{variant !== 'mini' && (
		<button type="button" class="tc__save" data-save={slug} data-save-name={name} aria-label={`Save ${name}`} aria-pressed="false" title="Save">
			<Icon name="bookmark" size={16} />
		</button>
	)}
</article>

<style>
	.tc {
		position: relative; display: flex; flex-direction: column;
		background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg);
		box-shadow: var(--shadow-sm); overflow: hidden;
		transition: transform var(--dur-3) var(--ease-out), box-shadow var(--dur-3) var(--ease-out), border-color var(--dur-3) var(--ease-out);
	}
	.tc:hover { transform: translateY(-3px); box-shadow: var(--shadow-lg); border-color: var(--line-2); }
	.tc:focus-within { border-color: var(--accent); }
	.tc--sponsored { border-color: var(--accent-soft-2); }
	.tc__link { display: flex; flex-direction: column; flex: 1; color: inherit; outline: none; }
	.tc__media { position: relative; aspect-ratio: 1200 / 630; background: var(--surface-2); overflow: hidden; border-bottom: 1px solid var(--line); }
	.tc__media img { width: 100%; height: 100%; object-fit: cover; object-position: top; transition: transform var(--dur-5) var(--ease-out); }
	.tc:hover .tc__media img { transform: scale(1.04); }
	.tc__media--empty {
		display: grid; place-items: center;
		background:
			radial-gradient(120% 100% at 50% 0%, var(--accent-soft) 0%, transparent 62%),
			linear-gradient(180deg, var(--surface-2), var(--surface));
	}
	.tc__media-fallback { display: grid; justify-items: center; gap: var(--s-3); }
	.tc__media-cat {
		font-family: var(--font-mono); font-size: 0.625rem; letter-spacing: 0.14em;
		text-transform: uppercase; color: var(--ink-4);
	}
	.tc__media-badges { position: absolute; top: 12px; left: 12px; display: flex; gap: 6px; }
	.tc__body { display: flex; flex-direction: column; gap: var(--s-3); padding: var(--s-4) var(--s-4) var(--s-4); flex: 1; }
	.tc__top { display: flex; align-items: center; gap: var(--s-3); padding-right: 36px; }
	.tc__id { min-width: 0; flex: 1; display: grid; }
	.tc__name { display: flex; align-items: center; gap: 5px; font-size: var(--text-base); font-weight: 600; letter-spacing: -0.015em; line-height: 1.25; }
	.tc__name > span:first-child { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
	.tc__verified { color: var(--info); display: inline-flex; flex-shrink: 0; }
	.tc__cat { font-size: var(--text-xs); color: var(--ink-3); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
	.tc__price { flex-shrink: 0; }
	.tc__desc { font-size: var(--text-sm); color: var(--ink-2); line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 2; line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
	.tc__foot { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); margin-top: auto; padding-top: var(--s-2); }
	.tc__unrated { font-size: var(--text-xs); color: var(--ink-4); }
	.tc__go { display: inline-flex; align-items: center; gap: 4px; font-size: var(--text-xs); font-weight: 600; color: var(--ink-3); transition: color var(--dur-2), gap var(--dur-2); }
	.tc:hover .tc__go { color: var(--accent-ink); gap: 7px; }
	.tc__save {
		position: absolute; top: 12px; right: 12px; z-index: 2; width: 32px; height: 32px; border-radius: 50%; display: grid; place-items: center;
		color: var(--ink-3); background: var(--glass); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); border: 1px solid var(--line);
		transition: color var(--dur-2), background-color var(--dur-2), transform var(--dur-2) var(--ease-spring), border-color var(--dur-2);
	}
	.tc__save:hover { color: var(--ink); border-color: var(--line-strong); transform: scale(1.08); }
	.tc__save[aria-pressed='true'] { color: var(--accent); background: var(--accent-soft); border-color: transparent; }
	.tc__save[aria-pressed='true'] :global(svg) { fill: currentColor; }
	.tc__save.is-pop { animation: save-pop 420ms var(--ease-spring); }
	@keyframes save-pop { 40% { transform: scale(1.3); } }
	@media (pointer: coarse) { .tc__save { width: 44px; height: 44px; top: 8px; right: 8px; } }

	/* row variant */
	.tc--row { flex-direction: row; border-radius: var(--r-md); }
	.tc--row .tc__body { flex-direction: row; align-items: center; gap: var(--s-4); padding: var(--s-3) var(--s-4); }
	.tc--row .tc__top { flex: 1; min-width: 0; padding-right: 0; }
	.tc--row .tc__desc { flex: 1.4; -webkit-line-clamp: 1; line-clamp: 1; }
	.tc--row .tc__foot { margin: 0; padding: 0; gap: var(--s-4); flex-shrink: 0; }
	.tc--row .tc__save { position: static; margin: auto var(--s-3) auto 0; }
	@media (max-width: 720px) { .tc--row .tc__body { flex-wrap: wrap; } .tc--row .tc__desc { flex-basis: 100%; } }

	/* mini variant */
	.tc--mini { border-radius: var(--r-md); box-shadow: none; }
	.tc--mini .tc__body { padding: var(--s-3); }
	.tc--mini .tc__top { padding-right: 0; }
</style>

<script>
	// Save (bookmark) — localStorage, synced across cards, with a tiny pop.
	const KEY = 'aib-saved';
	function saved(): Record<string, string> { try { return JSON.parse(localStorage.getItem(KEY) || '{}'); } catch { return {}; } }
	function paint() {
		const s = saved();
		document.querySelectorAll<HTMLButtonElement>('[data-save]').forEach((b) => b.setAttribute('aria-pressed', String(!!s[b.dataset.save!])));
		document.querySelectorAll<HTMLElement>('[data-saved-count]').forEach((el) => { const n = Object.keys(s).length; el.textContent = String(n); el.toggleAttribute('hidden', n === 0); });
	}
	function bind() {
		if ((document as any).__saveBound) { paint(); return; }
		(document as any).__saveBound = true;
		document.addEventListener('click', (e) => {
			const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-save]');
			if (!b) return;
			e.preventDefault();
			const s = saved(); const slug = b.dataset.save!;
			const on = !s[slug];
			if (on) s[slug] = b.dataset.saveName || slug; else delete s[slug];
			try { localStorage.setItem(KEY, JSON.stringify(s)); } catch {}
			b.classList.remove('is-pop'); void b.offsetWidth; b.classList.add('is-pop');
			paint();
			(window as any).__aib?.toast(on ? `Saved ${b.dataset.saveName} · view in My tools` : 'Removed from saved');
			document.dispatchEvent(new CustomEvent('aib:saved-change', { detail: s }));
		});
		document.addEventListener('astro:page-load', paint);
		paint();
	}
	bind();
</script>
