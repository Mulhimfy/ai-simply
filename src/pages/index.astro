---
/**
 * Home — today's brief. The homepage *is* the product: a reader lands, reads the
 * brief in three minutes, feels smarter, comes back tomorrow and sends it to a friend.
 *
 * Order: masthead (BriefHeader) → the numbered items (BriefItems, with a sticky
 * contents rail) → everything else on the wire → yesterday + the week → explainers
 * that match today's stories → the newsletter → a quiet door to the Toolbox.
 *
 * Everything above the fold is the brief itself: no search hero, no stat counters,
 * no directory pitch.
 */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import BriefHeader from '../components/BriefHeader.astro';
import BriefItems from '../components/BriefItems.astro';
import NewsTimeline from '../components/NewsTimeline.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ToolCard from '../components/ToolCard.astro';
import Newsletter from '../components/Newsletter.astro';
import Icon from '../components/Icon.astro';
import { ANGLES } from '../lib/brief';
import {
	loadBriefs,
	snapshotFor,
	restOfDay,
	topOfWeek,
	relatedExplainers,
	sourcesOf,
	dateParts,
	shareText,
} from '../lib/news';
import { toolOfTheDay } from '../lib/home';
import { SITE_DESCRIPTION, SITE_URL } from '../consts';
import { ogUrl } from '../og/url';

const now = new Date();
const todayISO = now.toISOString().slice(0, 10);

/* ── today's brief ─────────────────────────────────────────────────── */
const { briefs, dates, tools } = await loadBriefs();
const brief = briefs[0];
const snapshot = snapshotFor(brief.date);
const rest = restOfDay(brief, snapshot);
const outlets = sourcesOf(snapshot?.items ?? brief.items.flatMap((i) => i.sources));
const isToday = brief.date === todayISO;
const share = shareText(brief);
const briefUrl = `${SITE_URL}/news/${brief.date}/`;

/* ── yesterday + the week ──────────────────────────────────────────── */
const prev = briefs[1];
const prevParts = prev ? dateParts(prev.date) : null;
const week = topOfWeek(briefs, 3, brief);

/* ── explainers that match today's stories ─────────────────────────── */
const posts = await getCollection('blog');
const explainers = relatedExplainers(brief, posts, 3);

/* ── the toolbox, demoted ──────────────────────────────────────────── */
const allTools = await getCollection('tools');
const totd = toolOfTheDay(allTools, now);
---

<Base
	title="AI Briefs — the daily AI brief, in three minutes"
	description={SITE_DESCRIPTION}
	image={ogUrl('news', brief.date)}
>
	<!-- ── today's brief: masthead + the items, one reading grid ─────── -->
	<section class="hm-brief" aria-label="Today’s brief">
		<div class="hm-mast__bg" aria-hidden="true">
			<div class="bg-grid hm-mast__grid"></div>
			<div class="glow hm-mast__glow"></div>
		</div>
		<div class="container hm-grid hm-brief__inner">
			<div class="hm-main">
				<BriefHeader
					brief={brief}
					variant="home"
					lead={isToday ? "Today's brief" : 'The latest brief'}
					shareUrl={briefUrl}
					shareText={share}
				/>
				<BriefItems brief={brief} tools={tools} baseUrl={briefUrl} shareText={share} class="hm-items" />
			</div>

			<aside class="hm-rail hm-contents" aria-label="In this brief">
				<div class="hm-contents__inner">
					<span class="hm-contents__label">In this brief</span>
					<ol class="hm-contents__list" role="list">
						{brief.items.map((item, i) => (
							<li>
								<a href={`#${item.id}`} class="hm-contents__link" data-toc={item.id}>
									<span class="hm-contents__n tnum">{String(i + 1).padStart(2, '0')}</span>
									<span class="hm-contents__text">{item.headline}</span>
								</a>
							</li>
						))}
					</ol>
					<div class="hm-contents__foot">
						<span class="hm-contents__meta tnum">{brief.readingMinutes} min read</span>
						{prev && (
							<a href={`/news/${prev.date}/`} class="hm-contents__prev">
								<Icon name="arrow-left" size={13} /> {prevParts!.short}
							</a>
						)}
					</div>
				</div>
			</aside>
		</div>
	</section>

	<!-- ── everything else today ─────────────────────────────────────── -->
	{rest.length > 0 && (
		<section class="hm-rest" aria-labelledby="rest-title">
			<div class="container hm-grid">
				<div class="hm-main">
					<div class="hm-sec-head" data-reveal>
						<h2 id="rest-title" class="hm-h2">Everything else today</h2>
						<p class="hm-sec-desc">
							The brief above is what changed. Here is the rest of the wire — {rest.length} more{' '}
							{rest.length === 1 ? 'story' : 'stories'} from {outlets.length} outlets, in the order they landed.
						</p>
					</div>
					<div data-reveal style="--i:1">
						<NewsTimeline
							items={rest}
							compact
							collapsible
							summary={`Show the other ${rest.length} ${rest.length === 1 ? 'story' : 'stories'}`}
						/>
					</div>
				</div>
				<div class="hm-rail" aria-hidden="true"></div>
			</div>
		</section>
	)}

	<!-- ── yesterday + the week ──────────────────────────────────────── -->
	<section class="section section--tight hm-week" aria-labelledby="week-title">
		<div class="container">
			<div class="section-head" data-reveal>
				<div class="section-head__title">
					<span class="eyebrow">Keep going</span>
					<h2 id="week-title" class="hm-h2">Yesterday, and the week so far</h2>
				</div>
				<a href="/news/" class="link-arrow">All {dates.length} briefs <Icon name="arrow-right" /></a>
			</div>

			<div class="hm-week__grid">
				{prev && (
					<a href={`/news/${prev.date}/`} class="hm-prev" data-reveal>
						<span class="hm-prev__rail">
							<span class="hm-prev__label">{prevParts!.weekday}</span>
							<span class="hm-prev__date tnum">{prevParts!.short}</span>
						</span>
						<h3 class="hm-prev__title">{prev.title}</h3>
						<ul class="hm-prev__heads" role="list">
							{prev.items.slice(0, 3).map((item) => (
								<li>{item.headline}</li>
							))}
						</ul>
						<span class="hm-prev__go">Read that brief <Icon name="arrow-right" size={15} /></span>
					</a>
				)}

				<div class="hm-top" data-reveal style="--i:1">
					<div class="hm-top__head">
						<h3 class="hm-top__title">Top of the week</h3>
						<span class="hm-top__meta">Stories that kept coming back</span>
					</div>
					<ol class="hm-top__list" role="list">
						{week.map((pick, i) => (
							<li class="hm-top__item">
								<a href={`/news/${pick.date}/#${pick.item.id}`} class="hm-top__link">
									<span class="hm-top__n tnum">{String(i + 1).padStart(2, '0')}</span>
									<span class="hm-top__body">
										<span class="hm-top__headline">{pick.item.headline}</span>
										<span class="hm-top__meta-row">
											<Icon name={ANGLES[pick.item.angle].icon} size={12} />
											{ANGLES[pick.item.angle].name}
											<span class="hm-top__sep" aria-hidden="true">·</span>
											<span class="tnum">{pick.coverage} outlets</span>
											<span class="hm-top__sep" aria-hidden="true">·</span>
											<span class="tnum">{dateParts(pick.date).short}</span>
										</span>
									</span>
									<Icon name="arrow-up-right" size={15} class="hm-top__go" />
								</a>
							</li>
						))}
					</ol>
				</div>
			</div>
		</div>
	</section>

	<!-- ── explainers ────────────────────────────────────────────────── -->
	{explainers.length > 0 && (
		<section class="section section--tight hm-explainers" aria-labelledby="explainers-title">
			<div class="container">
				<div class="section-head" data-reveal>
					<div class="section-head__title">
						<span class="eyebrow">Background</span>
						<h2 id="explainers-title" class="hm-h2">If today's brief raised a question</h2>
						<p class="section-head__desc">
							Longer explainers on the things behind this week's headlines — written for people who are not in the industry.
						</p>
					</div>
					<a href="/blog/" class="link-arrow">All explainers <Icon name="arrow-right" /></a>
				</div>
				<div class="grid grid--3 hm-explainers__grid" data-stagger>
					{explainers.map((p) => (
						<ArticleCard
							slug={p.id}
							title={p.data.title}
							description={p.data.description}
							category={p.data.category}
							pubDate={p.data.pubDate}
							readingTime={p.data.readingTime}
							heroImage={p.data.heroImage}
						/>
					))}
				</div>
			</div>
		</section>
	)}

	<!-- ── the brief, in your inbox ──────────────────────────────────── -->
	<Newsletter variant="band" id="newsletter" />

	<!-- ── the toolbox, demoted ──────────────────────────────────────── -->
	<section class="section section--tight hm-toolbox" aria-labelledby="toolbox-title">
		<div class="container hm-toolbox__inner">
			<div class="hm-toolbox__copy" data-reveal>
				<span class="eyebrow">The toolbox</span>
				<h2 id="toolbox-title" class="hm-h3">
					When the brief says <em class="serif">try this</em>, this is where it points.
				</h2>
				<p class="hm-toolbox__text">
					{allTools.length} AI tools, tested and rated. A reference section for when the brief says try this — not the point of the site.
				</p>
				<form class="hm-toolbox__search" method="GET" action="/tools/" role="search">
					<Icon name="search" size={16} class="hm-toolbox__search-icon" />
					<label class="sr-only" for="tool-q">Search the toolbox</label>
					<input id="tool-q" class="input hm-toolbox__input" type="search" name="q" placeholder="Search the toolbox" autocomplete="off" spellcheck="false" />
					<button type="submit" class="btn btn--soft">Search</button>
				</form>
			</div>

			{totd && (
				<div class="hm-totd" data-reveal style="--i:1">
					<span class="hm-totd__label">Tool of the day</span>
					<ToolCard
						variant="row"
						slug={totd.id}
						name={totd.data.name}
						description={totd.data.description}
						category={totd.data.category}
						subcategory={totd.data.subcategory}
						pricing={totd.data.pricing}
						rating={totd.data.rating}
						ratingCount={totd.data.ratingCount}
						tags={totd.data.tags}
						verified={totd.data.verified}
						pubDate={totd.data.pubDate}
					/>
					<a href="/tools/" class="link-arrow hm-totd__all">Browse all {allTools.length} tools <Icon name="arrow-right" /></a>
				</div>
			)}
		</div>
	</section>
</Base>

<script>
	/* Scroll-spy for the contents rail. Position-driven rather than IntersectionObserver:
	   once the reader scrolls past the last item nothing changes intersection again, so an
	   observer keeps whatever it marked last — jumping back to the top left item 06 lit.
	   "Current" is simply the last item whose top has crossed the reading line.
	   Ids survive the angle re-ordering, so this keeps working after a reorder. */
	function spy() {
		const links = new Map<string, HTMLElement>();
		document.querySelectorAll<HTMLElement>('[data-toc]').forEach((a) => links.set(a.dataset.toc!, a));
		if (!links.size) return;
		const items = Array.from(document.querySelectorAll<HTMLElement>('.bi__item[id]')).filter((el) => links.has(el.id));
		if (!items.length) return;

		let current = '';
		const mark = (id: string) => {
			if (id === current) return;
			current = id;
			links.forEach((a, key) => a.classList.toggle('is-current', key === id));
		};

		let ticking = false;
		const update = () => {
			ticking = false;
			const line = window.innerHeight * 0.28;
			let cur = items[0];
			for (const el of items) if (el.getBoundingClientRect().top <= line) cur = el;
			mark(cur.id);
		};
		const onScroll = () => {
			if (ticking) return;
			ticking = true;
			requestAnimationFrame(update);
		};

		// The rail only exists on wide viewports; don't run a scroll handler without it.
		const wide = matchMedia('(min-width: 1100px)');
		const sync = () => {
			removeEventListener('scroll', onScroll);
			removeEventListener('resize', onScroll);
			if (!wide.matches) return;
			addEventListener('scroll', onScroll, { passive: true });
			addEventListener('resize', onScroll, { passive: true });
			update();
		};
		wide.addEventListener('change', sync);
		sync();
	}
	spy();
	document.addEventListener('astro:page-load', spy);
</script>

<style>
	/* ── shared reading grid: one column of brief + a sticky contents rail ── */
	.hm-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: clamp(2rem, 5vw, 5rem);
	}
	.hm-main {
		min-width: 0;
		max-width: 46rem;
	}
	.hm-rail {
		display: none;
	}
	@media (min-width: 1100px) {
		.hm-grid {
			grid-template-columns: minmax(0, 1fr) 232px;
		}
		.hm-rail {
			display: block;
		}
	}

	/* BriefHeader is a grid; its implicit column is sized by the widest item, and the
	   angle-chip scroller is deliberately wider than the page on mobile. Pin the track
	   to the column width so the chips scroll instead of stretching the whole masthead. */
	.hm-main :global(.bh) {
		grid-template-columns: minmax(0, 1fr);
	}

	/* ── masthead + items ─────────────────────────────────────────────── */
	.hm-brief {
		position: relative;
		padding-block: clamp(2.25rem, 4vw, 4rem) clamp(2.5rem, 5vw, 4rem);
		/* No `overflow: hidden` here: it would make this section a scrollport and kill
		   the sticky contents rail. The atmosphere layer clips itself instead. */
	}
	/* The atmosphere belongs to the masthead, not the whole brief — cap its height
	   rather than letting the grid and glow run behind six items of body copy. */
	.hm-mast__bg {
		position: absolute;
		inset: 0 0 auto;
		height: clamp(420px, 62vh, 640px);
		overflow: hidden;
		pointer-events: none;
	}
	.hm-mast__grid {
		position: absolute;
		inset: -1px;
		opacity: 0.45;
		mask-image: radial-gradient(110% 90% at 15% 0%, #000, transparent 72%);
		-webkit-mask-image: radial-gradient(110% 90% at 15% 0%, #000, transparent 72%);
	}
	.hm-mast__glow {
		position: absolute;
		top: -40%;
		right: -5%;
		width: 46%;
		aspect-ratio: 1;
		opacity: 0.5;
	}
	.hm-brief__inner {
		position: relative;
	}
	.hm-brief .hm-main :global(.hm-items) {
		margin-top: clamp(2rem, 4vw, 3.25rem);
		border-top: 1px solid var(--line);
	}

	/* contents rail — sticky from the masthead down, so the six headlines and the
	   reading time are on the first screen instead of arriving mid-scroll. */
	.hm-contents {
		position: relative;
	}
	.hm-contents__inner {
		position: sticky;
		top: calc(var(--header-h, 64px) + 2rem);
		display: grid;
		gap: var(--s-4);
		padding-top: clamp(3.5rem, 7vw, 6rem);
	}
	.hm-contents__label {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--ink-4);
	}
	.hm-contents__list {
		display: grid;
		gap: 2px;
		border-left: 1px solid var(--line);
	}
	.hm-contents__link {
		display: grid;
		grid-template-columns: 22px minmax(0, 1fr);
		gap: var(--s-2);
		padding: 7px 0 7px var(--s-3);
		margin-left: -1px;
		border-left: 1px solid transparent;
		font-size: var(--text-xs);
		line-height: 1.45;
		color: var(--ink-3);
		transition: color var(--dur-2), border-color var(--dur-2);
	}
	.hm-contents__link:hover {
		color: var(--ink);
	}
	.hm-contents__link.is-current {
		color: var(--ink);
		border-left-color: var(--accent);
	}
	.hm-contents__link.is-current .hm-contents__n {
		color: var(--accent-ink); /* --accent is a mark colour; this is 10px text */
	}
	.hm-contents__n {
		font-family: var(--font-mono);
		font-size: 0.625rem;
		color: var(--ink-4);
		padding-top: 1px;
	}
	.hm-contents__text {
		display: -webkit-box;
		-webkit-line-clamp: 2;
		line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.hm-contents__foot {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--s-3);
		padding-top: var(--s-3);
		border-top: 1px solid var(--line);
	}
	.hm-contents__meta {
		font-family: var(--font-mono);
		font-size: 0.625rem;
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: var(--ink-4);
	}
	.hm-contents__prev {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		font-family: var(--font-mono);
		font-size: 0.625rem;
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: var(--ink-3);
		transition: color var(--dur-2);
	}
	.hm-contents__prev:hover {
		color: var(--accent-ink);
	}

	/* ── section furniture ────────────────────────────────────────────── */
	.hm-h2 {
		font-size: var(--text-2xl);
		letter-spacing: -0.03em;
	}
	.hm-h3 {
		font-size: var(--text-xl);
		letter-spacing: -0.025em;
		line-height: 1.2;
	}
	.hm-sec-head {
		display: grid;
		gap: var(--s-2);
		margin-bottom: var(--s-6);
	}
	.hm-sec-desc {
		font-size: var(--text-sm);
		color: var(--ink-3);
		max-width: 56ch;
	}

	/* ── everything else today ────────────────────────────────────────── */
	.hm-rest {
		padding-block: clamp(2.5rem, 5vw, 4rem);
		border-top: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
		background: var(--bg-sunk);
	}

	/* ── yesterday + week ─────────────────────────────────────────────── */
	.hm-week__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--s-6);
		align-items: start;
	}
	.hm-prev {
		display: grid;
		gap: var(--s-4);
		padding: clamp(1.25rem, 3vw, 2rem);
		border: 1px solid var(--line);
		border-radius: var(--r-xl);
		background: var(--surface);
		transition: border-color var(--dur-3), transform var(--dur-3) var(--ease-out), box-shadow var(--dur-3) var(--ease-out);
	}
	.hm-prev:hover {
		border-color: var(--line-2);
		transform: translateY(-3px);
		box-shadow: var(--shadow-lg);
	}
	.hm-prev__rail {
		display: flex;
		align-items: center;
		gap: var(--s-3);
	}
	.hm-prev__label,
	.hm-prev__date {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}
	.hm-prev__label {
		color: var(--ink-2);
	}
	.hm-prev__date {
		color: var(--ink-4);
	}
	.hm-prev__title {
		font-size: var(--text-lg);
		font-weight: 600;
		letter-spacing: -0.02em;
		line-height: 1.25;
		text-wrap: balance;
		transition: color var(--dur-2);
	}
	.hm-prev:hover .hm-prev__title {
		color: var(--accent-ink);
	}
	.hm-prev__heads {
		display: grid;
		gap: var(--s-2);
		font-size: var(--text-sm);
		line-height: 1.5;
		color: var(--ink-3);
	}
	.hm-prev__heads li {
		display: grid;
		grid-template-columns: 10px minmax(0, 1fr);
		gap: var(--s-3);
	}
	.hm-prev__heads li::before {
		content: '';
		width: 4px;
		height: 4px;
		border-radius: 50%;
		background: var(--ink-4);
		margin-top: 0.55em;
	}
	.hm-prev__go {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-size: var(--text-sm);
		font-weight: 600;
		color: var(--ink-2);
	}
	.hm-prev:hover .hm-prev__go {
		color: var(--accent-ink);
	}

	.hm-top {
		display: grid;
		gap: var(--s-4);
		padding: clamp(1.25rem, 3vw, 2rem);
		border: 1px solid var(--line);
		border-radius: var(--r-xl);
		background: var(--surface-2);
	}
	.hm-top__head {
		display: grid;
		gap: 4px;
	}
	.hm-top__title {
		font-size: var(--text-lg);
		letter-spacing: -0.02em;
	}
	.hm-top__meta {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: var(--ink-3);
	}
	.hm-top__list {
		display: grid;
	}
	.hm-top__item {
		border-top: 1px solid var(--line);
	}
	.hm-top__link {
		display: grid;
		grid-template-columns: 26px minmax(0, 1fr) 16px;
		gap: var(--s-3);
		align-items: baseline;
		padding: var(--s-4) 0;
	}
	.hm-top__n {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		color: var(--ink-4);
	}
	.hm-top__body {
		display: grid;
		gap: 5px;
		min-width: 0;
	}
	.hm-top__headline {
		font-size: var(--text-sm);
		font-weight: 500;
		line-height: 1.45;
		color: var(--ink);
		text-wrap: pretty;
	}
	.hm-top__link:hover .hm-top__headline {
		color: var(--accent-ink);
	}
	.hm-top__meta-row {
		display: flex;
		align-items: center;
		gap: 5px;
		font-family: var(--font-mono);
		font-size: 0.625rem;
		letter-spacing: 0.08em;
