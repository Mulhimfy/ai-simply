---
/**
 * One brief — `/news/<date>/`. This is the site's unit of sharing: the same
 * `BriefHeader` + `BriefItems` the home page renders, plus day navigation and the
 * raw wire for that day.
 *
 * Stays `noindex`: a cron commits one of these every morning, so indexing them would
 * trade hundreds of near-identical URLs against the real articles. `/news/` carries
 * the topic for search; these pages exist for readers and for shares.
 */
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import BriefHeader from '../../components/BriefHeader.astro';
import BriefItems from '../../components/BriefItems.astro';
import NewsTimeline from '../../components/NewsTimeline.astro';
import Newsletter from '../../components/Newsletter.astro';
import Icon from '../../components/Icon.astro';
import { SITE_TITLE, SITE_URL } from '../../consts';
import { ogUrl } from '../../og/url';
import {
	loadBriefs,
	snapshotFor,
	restOfDay,
	neighbours,
	nearbyDates,
	dateParts,
	briefDescription,
	shareText,
	sourcesOf,
} from '../../lib/news';

export async function getStaticPaths() {
	const { briefs } = await loadBriefs();
	return briefs.map((b) => ({ params: { date: b.date } }));
}

const { date } = Astro.params as { date: string };
const { briefs, dates, tools, latest } = await loadBriefs();
const brief = briefs.find((b) => b.date === date)!;
const snapshot = snapshotFor(date);
const rest = restOfDay(brief, snapshot);
const { prev, next } = neighbours(dates, date);
/* nearbyDates returns the older half ascending and the newer half descending; a day
   rail that is not in date order reads as broken. Sort it. */
const around = nearbyDates(dates, date, 3).slice().sort();

const d = dateParts(date);
const isLatest = latest?.date === date;
const url = `${SITE_URL}/news/${date}/`;
const description = briefDescription(brief);
const share = shareText(brief);
const outlets = sourcesOf(snapshot?.items ?? brief.items.flatMap((i) => i.sources));
const byLabel = (iso: string) => dateParts(iso);

/* JSON-LD: a written brief is a NewsArticle; an automatic one is honestly a
   collection of the day's stories, so it declares CollectionPage + ItemList. */
const publisher = {
	'@type': 'Organization',
	name: SITE_TITLE,
	url: SITE_URL,
	logo: { '@type': 'ImageObject', url: `${SITE_URL}/favicon.svg` },
};
const ld =
	brief.kind === 'editorial'
		? {
				'@context': 'https://schema.org',
				'@type': 'NewsArticle',
				headline: brief.title,
				description,
				url,
				mainEntityOfPage: { '@type': 'WebPage', '@id': url },
				datePublished: `${date}T07:00:00Z`,
				dateModified: `${date}T07:00:00Z`,
				image: [`${SITE_URL}${ogUrl('news', date)}`],
				author: publisher,
				publisher,
				isAccessibleForFree: true,
				articleSection: 'AI',
			}
		: {
				'@context': 'https://schema.org',
				'@type': 'CollectionPage',
				name: `AI brief — ${d.monthDayYear}`,
				description,
				url,
				isPartOf: { '@type': 'WebSite', name: SITE_TITLE, url: SITE_URL },
				mainEntity: {
					'@type': 'ItemList',
					numberOfItems: brief.items.length,
					itemListElement: brief.items.map((item, i) => ({
						'@type': 'ListItem',
						position: i + 1,
						name: item.headline,
						url: item.sources[0]?.link ?? `${url}#${item.id}`,
					})),
				},
			};
---

<Base
	title={`AI brief — ${d.monthDayYear}`}
	description={description}
	image={ogUrl('news', date)}
	type="article"
	publishDate={new Date(`${date}T07:00:00Z`)}
	noindex={true}
>
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(ld)} />

	<article class="bp">
		<div class="container container--narrow bp__crumbs">
			<Breadcrumb items={[{ name: 'Briefs', href: '/news/' }, { name: d.monthDayYear }]} />
			{!isLatest && (
				<a href="/" class="bp__today">
					<Icon name="arrow-left" size={14} /> Today’s brief
				</a>
			)}
		</div>

		<div class="container container--narrow bp__head">
			<BriefHeader
				brief={brief}
				variant="day"
				lead={isLatest ? 'Latest brief' : 'Brief'}
				shareUrl={url}
				shareText={share}
			/>
		</div>

		<div class="container container--narrow bp__items">
			<BriefItems brief={brief} tools={tools} baseUrl={url} shareText={share} />
		</div>

		{rest.length > 0 && (
			<section class="bp__rest">
				<div class="container container--narrow">
					<div class="bp__rest-head">
						<h2 class="bp__h2">Everything else that day</h2>
						<p class="bp__sub">
							The rest of the wire for {d.monthDayYear} — {rest.length} more{' '}
							{rest.length === 1 ? 'story' : 'stories'} from {outlets.length} outlets, untouched.
						</p>
					</div>
					<NewsTimeline
						items={rest}
						compact
						collapsible
						summary={`Show the other ${rest.length} ${rest.length === 1 ? 'story' : 'stories'}`}
						class="bp__timeline"
					/>
				</div>
			</section>
		)}

		<nav class="container container--narrow bp__pager" aria-label="Other briefs">
			{prev ? (
				<a href={`/news/${prev}/`} class="bp__step bp__step--prev">
					<span class="bp__step-label"><Icon name="arrow-left" size={14} /> The day before</span>
					<span class="bp__step-date">{byLabel(prev).weekdayMonthDay}</span>
					<span class="bp__step-title">{briefs.find((b) => b.date === prev)?.title}</span>
				</a>
			) : (
				<span class="bp__step is-empty">
					<span class="bp__step-label">The day before</span>
					<span class="bp__step-date">Nothing earlier — this is the first brief.</span>
				</span>
			)}
			{next ? (
				<a href={`/news/${next}/`} class="bp__step bp__step--next">
					<span class="bp__step-label">The day after <Icon name="arrow-right" size={14} /></span>
					<span class="bp__step-date">{byLabel(next).weekdayMonthDay}</span>
					<span class="bp__step-title">{briefs.find((b) => b.date === next)?.title}</span>
				</a>
			) : (
				<span class="bp__step is-empty">
					<span class="bp__step-label">The day after</span>
					<span class="bp__step-date">You’re on the latest brief.</span>
				</span>
			)}
		</nav>

		{around.length > 0 && (
			<div class="container container--narrow bp__around">
				<span class="bp__around-label">Nearby</span>
				<div class="bp__around-days">
					{around.map((day) => (
						<a href={`/news/${day}/`} class="bp__day">{dateParts(day).short}</a>
					))}
					<a href="/news/" class="bp__day bp__day--all">All {dates.length} briefs</a>
				</div>
			</div>
		)}

		<div class="container container--narrow bp__nl">
			<Newsletter
				variant="card"
				id="newsletter"
				heading="Get the next one in your *inbox*."
				text="The same brief, delivered: what changed in AI, why it matters and what to do about it. Free, and one click to leave."
			/>
		</div>
	</article>
</Base>

<style>
	.bp {
		padding-top: var(--s-8);
		padding-bottom: var(--section);
	}

	.bp__crumbs {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--s-4);
		margin-bottom: var(--s-8);
	}
	.bp__today {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		min-height: 44px;
		padding-inline: 2px;
		font-size: var(--text-xs);
		font-weight: 600;
		color: var(--ink-3);
		white-space: nowrap;
		transition: color var(--dur-2);
	}
	.bp__today:hover {
		color: var(--accent-ink);
	}

	/* BriefHeader is a grid; its implicit column is sized by the widest item, and the
	   angle-chip scroller is deliberately wider than the page on mobile. Pin the track
	   to the column width so the chips scroll instead of stretching the masthead. */
	.bp__head :global(.bh) {
		grid-template-columns: minmax(0, 1fr);
	}

	.bp__items {
		margin-top: clamp(2.5rem, 5vw, 4rem);
	}
	/* Same rule the home page draws between the masthead and item 01 — the two
	   surfaces render the identical component and must share the rhythm. */
	.bp__items :global(.bi) {
		border-top: 1px solid var(--line);
	}

	/* everything else that day */
	.bp__rest {
		margin-top: clamp(3rem, 6vw, 5rem);
		padding-block: clamp(2.5rem, 5vw, 4rem);
		border-top: 1px solid var(--line);
		background: var(--bg-sunk);
	}
	.bp__rest-head {
		display: grid;
		gap: var(--s-2);
		margin-bottom: var(--s-6);
	}
	.bp__h2 {
		font-size: var(--text-xl);
		letter-spacing: -0.02em;
	}
	.bp__sub {
		font-size: var(--text-sm);
		color: var(--ink-3);
		max-width: 58ch;
	}

	/* prev / next */
	.bp__pager {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--s-4);
		margin-top: clamp(2.5rem, 5vw, 4rem);
	}
	.bp__step {
		display: grid;
		gap: 6px;
		align-content: start;
		padding: var(--s-5) var(--s-6);
		border: 1px solid var(--line);
		border-radius: var(--r-lg);
		background: var(--surface);
		transition: border-color var(--dur-2), transform var(--dur-3) var(--ease-out), box-shadow var(--dur-3) var(--ease-out);
	}
	a.bp__step:hover {
		border-color: var(--line-2);
		transform: translateY(-2px);
		box-shadow: var(--shadow-md);
	}
	.bp__step--next {
		text-align: right;
	}
	.bp__step-label {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--ink-3);
	}
	.bp__step--next .bp__step-label {
		justify-self: end;
	}
	.bp__step-date {
		font-size: var(--text-sm);
		font-weight: 600;
		color: var(--ink);
	}
	.bp__step.is-empty .bp__step-date {
		font-weight: 400;
		color: var(--ink-3);
	}
	.bp__step-title {
		font-size: var(--text-sm);
		line-height: 1.5;
		color: var(--ink-3);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	a.bp__step:hover .bp__step-title {
		color: var(--ink-2);
	}
	.bp__step.is-empty {
		background: none;
		border-style: dashed;
	}

	/* nearby days */
	.bp__around {
		display: flex;
		align-items: center;
		gap: var(--s-4);
		flex-wrap: wrap;
		margin-top: var(--s-6);
	}
	.bp__around-label {
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--ink-4);
	}
	.bp__around-days {
		display: flex;
		gap: 6px;
		flex-wrap: wrap;
	}
	.bp__day {
		display: inline-flex;
		align-items: center;
		height: 34px;
		padding: 0 12px;
		border-radius: var(--r-full);
		border: 1px solid var(--line);
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--ink-3);
		transition: color var(--dur-2), border-color var(--dur-2);
	}
	.bp__day:hover {
		color: var(--ink);
		border-color: var(--line-strong);
	}
	.bp__day--all {
		color: var(--accent-ink);
		border-color: var(--accent-soft-2);
	}

	.bp__nl {
		margin-top: clamp(3rem, 6vw, 5rem);
	}

	@media (max-width: 720px) {
		.bp__day {
			height: 44px;
			padding-inline: 14px;
		}
		.bp__around-days {
			gap: 8px;
		}
		.bp__pager {
			grid-template-columns: 1fr;
		}
		.bp__step--next {
			text-align: left;
		}
		.bp__step--next .bp__step-label {
			justify-self: start;
		}
	}
</style>
