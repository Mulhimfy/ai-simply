---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Toc from '../components/Toc.astro';
import Icon from '../components/Icon.astro';
import { SITE_TITLE, SITE_URL, TOOL_LISTING } from '../consts';

const updated = '16 August 2026';

/** Mini TOC — h2s only, matching the section ids below. */
const headings = [
	{ depth: 2, slug: 'acceptance', text: '1. Acceptance of terms' },
	{ depth: 2, slug: 'use', text: '2. Use of the service' },
	{ depth: 2, slug: 'content', text: '3. Content and IP' },
	{ depth: 2, slug: 'third-party', text: '4. Third-party tools' },
	{ depth: 2, slug: 'submissions', text: '5. User submissions' },
	{ depth: 2, slug: 'listings', text: '6. Paid listings and billing' },
	{ depth: 2, slug: 'disclaimers', text: '7. Disclaimers' },
	{ depth: 2, slug: 'limitation', text: '8. Limitation of liability' },
	{ depth: 2, slug: 'privacy', text: '9. Privacy' },
	{ depth: 2, slug: 'changes', text: '10. Changes to these terms' },
	{ depth: 2, slug: 'contact', text: '11. Contact' },
];

const ld = {
	'@context': 'https://schema.org',
	'@type': 'WebPage',
	name: `Terms of Service | ${SITE_TITLE}`,
	url: `${SITE_URL}/terms/`,
	dateModified: '2026-08-16',
};
---

<Base
	title={`Terms of Service | ${SITE_TITLE}`}
	description={`The rules that govern your use of ${SITE_TITLE}, including how paid Toolbox listings are billed, cancelled and removed.`}
	noNudge
>
	<script type="application/ld+json" slot="head" set:html={JSON.stringify(ld)} />

	<PageHero
		crumbs={[{ name: 'Terms of Service' }]}
		eyebrow="Legal"
		title="Terms of *service*"
		lead="The binding version of how this site works. If you are here about billing a listing, section 6 is the one you want — and the plain-English mirror of it is on the pricing page."
	>
		<p class="hero-meta meta"><Icon name="calendar" size={13} /> Last updated {updated}</p>
	</PageHero>

	<div class="container legal">
		<article class="prose legal__body">

			<div class="jump">
				<a href="#listings" class="jump__link"><Icon name="credit-card" size={15} /> Billing, refunds and cancellation</a>
				<a href="/pricing/#faq" class="jump__link"><Icon name="message-circle-question" size={15} /> The same thing in plain English</a>
			</div>

			<h2 id="acceptance">1. Acceptance of Terms</h2>
			<p>By accessing or using <strong>{SITE_TITLE}</strong> (available at <a href={SITE_URL}>{SITE_URL}</a>), you agree to be bound by these Terms of Service. If you do not agree to these terms, please do not use the site.</p>
			<p>These terms apply to all visitors, users, and any others who access or use the service.</p>

			<h2 id="use">2. Use of the Service</h2>
			<p>You may use {SITE_TITLE} for personal, non-commercial research and informational purposes. You agree not to:</p>
			<ul>
				<li>Use automated bots or scrapers to harvest content at scale without prior written permission.</li>
				<li>Reproduce, republish, or redistribute our editorial content without attribution.</li>
				<li>Attempt to gain unauthorised access to our systems or infrastructure.</li>
				<li>Use the service in any way that violates applicable laws or regulations.</li>
				<li>Misrepresent your identity or affiliation when submitting tools or contacting us.</li>
			</ul>

			<h2 id="content">3. Content &amp; Intellectual Property</h2>
			<p>All original content on {SITE_TITLE} — including articles, briefs, reviews, editorial ratings, UI design, and written descriptions — is the intellectual property of {SITE_TITLE} and is protected under applicable copyright law.</p>
			<p>Tool names, logos, and trademarks referenced on this site belong to their respective owners. We use them for identification and informational purposes only, and their presence on this site does not imply endorsement or affiliation.</p>
			<p>You may share links to our content and quote brief excerpts (up to 100 words) with proper attribution and a link back to the original page.</p>

			<h2 id="third-party">4. Third-Party Tools &amp; Links</h2>
			<p>{SITE_TITLE} publishes editorial coverage of AI tools and services operated by third parties, and links out to them. We do not control, endorse, or take responsibility for the content, policies, or practices of any third-party website or service.</p>
			<p>Before using any AI tool listed on our site, we strongly encourage you to read that tool's own terms of service and privacy policy. Your use of third-party services is governed solely by those services' terms.</p>
			<p>Some listings may include affiliate or sponsored relationships, which are always disclosed in accordance with applicable advertising guidelines.</p>

			<h2 id="submissions">5. User Submissions</h2>
			<p>When you submit a tool for listing via our submission form, you represent that:</p>
			<ul>
				<li>You are authorised to submit information about the tool.</li>
				<li>The information you provide is accurate and not misleading.</li>
				<li>The tool does not violate any laws or the rights of third parties.</li>
			</ul>
			<p>We reserve the right to accept, reject, or remove any submission at our sole discretion. Submission does not guarantee listing.</p>

			<h2 id="listings">6. Paid Listings, Billing &amp; Refunds</h2>
			<p>Listing a tool in the Toolbox is a paid subscription. By completing checkout you agree to the following.</p>

			<h3>Price and billing cycle</h3>
			<p>A directory listing costs <strong>{TOOL_LISTING.price} {TOOL_LISTING.currency} per {TOOL_LISTING.interval}</strong>. The first payment is taken at checkout, and the same amount is charged automatically every {TOOL_LISTING.interval} thereafter until the subscription is cancelled. There is no minimum term.</p>
			<p>Payments are processed by <strong>Polar</strong>, which acts as merchant of record. Polar's terms and privacy policy apply to the payment itself, and your card details are never received or stored by us. Applicable sales tax or VAT is included in the price shown.</p>

			<h3>Refunds</h3>
			<p><strong>All listing payments are final and non-refundable.</strong> We do not provide refunds or partial refunds for unused time, part-months, cancelled subscriptions, or listings removed for breach of these terms. If you do not want to be charged again, cancel before your next renewal date.</p>

			<h3>Cancellation and removal</h3>
			<p>You may cancel at any time from the <a href={TOOL_LISTING.portalUrl} target="_blank" rel="noopener noreferrer">Polar customer portal</a>, which is also linked in your receipt email and in the footer of every page on this site. Enter the email you paid with and Polar will send you a sign-in link. Cancellation stops future charges; it does not refund charges already made.</p>
			<p>When you cancel, your listing remains published for the remainder of the billing period you have already paid for. At the start of the next billing period the listing is <strong>automatically removed</strong> from the directory, including its tool page, its placement on category and comparison pages, and its sitemap entry. Removal is automated and is not reversible except by taking out a new subscription.</p>
			<p>A failed or reversed payment is treated the same way: if a subscription lapses for non-payment, the listing is removed automatically.</p>

			<h3>Review, rejection, and our right to remove</h3>
			<p>Payment buys a listing subject to review, not a guaranteed one. Every submission is still checked against our listing criteria: the tool must use AI as a core feature, have a working product or demo, and have a clear pricing model; we do not list broken, parked, or fraudulent sites, or pure white-label repackaging.</p>
			<p>If your tool does not meet those criteria, we will cancel the subscription so that you are not billed again, and the listing will not be published. We may also remove a listing and cancel its subscription at any time if the tool stops working, changes materially, or breaches these terms.</p>

			<h3>Editorial independence</h3>
			<p>A paid listing does not buy editorial coverage, a rating, a ranking position, a mention in the brief, or a favourable review. Our ratings and written assessments remain independent of any commercial relationship — see our <a href="/rating-methodology/">rating methodology</a>. Paid and sponsored placements are disclosed as such.</p>

			<h2 id="disclaimers">7. Disclaimers</h2>
			<p>The information on {SITE_TITLE} is provided for general informational and educational purposes only. It does not constitute professional, legal, financial, or technical advice.</p>
			<p>While we strive to keep information accurate and up to date, AI tools and their features change frequently. We make no warranties, express or implied, regarding the completeness, accuracy, or reliability of any content on this site.</p>
			<p>The service is provided "as is" and "as available" without warranties of any kind.</p>

			<h2 id="limitation">8. Limitation of Liability</h2>
			<p>To the fullest extent permitted by law, {SITE_TITLE} and its operators shall not be liable for any indirect, incidental, special, consequential, or punitive damages arising from your use of — or inability to use — this site or any tool listed on it.</p>
			<p>Our total liability for any claim arising out of these terms shall not exceed the amount you paid us in the twelve months preceding the claim (which, for free users, is zero).</p>

			<h2 id="privacy">9. Privacy</h2>
			<p>Your use of {SITE_TITLE} is also governed by our <a href="/privacy/">Privacy Policy</a>, which is incorporated into these Terms by reference. Please review it to understand how we collect, use, and protect your information.</p>

			<h2 id="changes">10. Changes to These Terms</h2>
			<p>We may update these Terms of Service from time to time. When we do, we will revise the "last updated" date at the top of this page. Continued use of the site after changes constitutes your acceptance of the revised terms.</p>
			<p>For significant changes, we may also notify readers via the newsletter or a prominent notice on the site.</p>

			<h2 id="contact">11. Contact</h2>
			<p>If you have questions about these Terms, please contact us:</p>
			<ul>
				<li><strong>Website:</strong> <a href="/contact/">{SITE_URL}/contact/</a></li>
				<li><strong>Email:</strong> <a href="mailto:hello@getaibriefs.com">hello@getaibriefs.com</a></li>
			</ul>
		</article>

		<aside class="legal__aside">
			<Toc headings={headings} title="On this page" />
		</aside>
	</div>
</Base>

<style>
	.hero-meta { display: inline-flex; align-items: center; gap: 6px; }

	.legal {
		display: grid; grid-template-columns: minmax(0, 1fr) 220px; gap: var(--s-16);
		align-items: start;
		padding-block: clamp(2rem, 1.6rem + 2.4vw, 3.5rem) var(--section);
	}
	.legal__body { max-width: 68ch; }
	.legal__aside { position: sticky; top: calc(var(--header-h, 64px) + 32px); }
	@media (max-width: 1040px) {
		.legal { grid-template-columns: minmax(0, 1fr); gap: var(--s-8); }
		.legal__aside { position: static; order: -1; padding-bottom: var(--s-4); border-bottom: 1px solid var(--line); }
	}

	.jump { display: flex; flex-wrap: wrap; gap: var(--s-3); }
	.jump__link {
		display: inline-flex; align-items: center; gap: 8px;
		padding: 9px 14px; border-radius: var(--r-full);
		border: 1px solid var(--line-2); background: var(--surface);
		font-size: var(--text-sm); font-weight: 600; color: var(--ink-2);
		text-decoration: none;
		transition: color var(--dur-2), border-color var(--dur-2), transform var(--dur-2) var(--ease-out);
	}
	.jump__link:hover { color: var(--ink); border-color: var(--line-strong); transform: translateY(-1px); }
	.jump__link :global(.icon) { color: var(--accent); }

	.prose h2 {
		font-size: var(--text-xl); padding-top: var(--s-4);
		border-top: 1px solid var(--line); margin-top: 2.4em;
	}
	.prose h2:first-of-type { border-top: 0; padding-top: 0; }
	.prose h3 { font-size: var(--text-base); font-weight: 600; color: var(--ink); margin-top: 1.8em; }
</style>
