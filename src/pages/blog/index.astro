---
/**
 * `/blog/` — Explainers: the depth behind the daily brief.
 * Feature card + category chips (client-side, URL-synced) + one card design.
 */
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Newsletter from '../../components/Newsletter.astro';
import Icon from '../../components/Icon.astro';
import { SITE_TITLE, SITE_URL, BLOG_CATEGORIES } from '../../consts';
import { byNewest, categoryName, categoryIcon, countWords } from '../../lib/articles';

/* Reading time is measured, not asserted. */
const readTime = (body?: string) => `${Math.max(1, Math.round(countWords(body ?? '') / 200))} min read`;

const posts = byNewest(await getCollection('blog'));
const [feature, ...rest] = posts;

const counts = new Map<string, number>();
for (const p of posts) counts.set(p.data.category, (counts.get(p.data.category) ?? 0) + 1);
const categories = Object.keys(BLOG_CATEGORIES)
	.filter((slug) => counts.has(slug))
	.map((slug) => ({ slug, name: categoryName(slug), icon: categoryIcon(slug), count: counts.get(slug)! }));

const description = 'Explainers from AI Briefs: the concepts, comparisons and how-tos behind the daily brief, in plain English. No jargon, no hype.';

const collectionSchema = {
	'@context': 'https://schema.org',
	'@type': 'CollectionPage',
	name: 'Explainers',
	description,
	url: `${SITE_URL}/blog/`,
	isPartOf: { '@type': 'WebSite', name: SITE_TITLE, url: SITE_URL },
	mainEntity: {
		'@type': 'ItemList',
		numberOfItems: posts.length,
		itemListElement: posts.map((p, i) => ({
			'@type': 'ListItem', position: i + 1, name: p.data.title, url: `${SITE_URL}/blog/${p.id}/`,
		})),
	},
};
---
<Base title={`Explainers — the depth behind the brief | ${SITE_TITLE}`} {description} noNudge>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
	</Fragment>

	<section class="ex-hero">
		<div class="container">
			<Breadcrumb items={[{ name: 'Explainers' }]} />
			<div class="ex-hero__in">
				<div class="ex-hero__copy">
					<span class="eyebrow">Explainers · {posts.length} pieces</span>
					<h1 class="ex-hero__title">The depth behind the <em class="serif">brief</em>.</h1>
					<p class="lead">The brief tells you what changed today. These go one level down: what the words mean, which tool actually wins, and how to do the thing — written the way you'd explain it to a friend.</p>
				</div>
				<nav class="ex-hero__links" aria-label="Related sections">
					<a class="chip" href="/tutorials/"><Icon name="compass" size={15} /> Tutorials</a>
					<a class="chip" href="/reviews/"><Icon name="star" size={15} /> Reviews</a>
					<a class="chip" href="/news/"><Icon name="newspaper" size={15} /> Today's brief</a>
				</nav>
			</div>
		</div>
	</section>

	{feature && (
		<section class="container ex-feature" data-feature aria-labelledby="ex-feature-h">
			<h2 class="sr-only" id="ex-feature-h">Latest explainer</h2>
			<span class="meta ex-feature__label">Latest</span>
			<ArticleCard
				slug={feature.id}
				title={feature.data.title}
				description={feature.data.description}
				category={feature.data.category}
				pubDate={feature.data.pubDate}
				readingTime={readTime(feature.body)}
				heroImage={feature.data.heroImage}
				author={feature.data.author}
				variant="feature"
				eager
			/>
		</section>
	)}

	<section class="container ex-list section--tight" data-list aria-labelledby="ex-all-h">
		<div class="ex-list__head">
			<h2 id="ex-all-h">Everything else</h2>
			<p class="ex-list__count muted tnum" data-count>{rest.length} explainers</p>
		</div>

		<div class="ex-chips scroll-x" role="group" aria-label="Filter by topic">
			<button type="button" class="chip" data-cat="" aria-pressed="true">All <span class="chip__count">{posts.length}</span></button>
			{categories.map((c) => (
				<button type="button" class="chip" data-cat={c.slug} aria-pressed="false">
					<Icon name={c.icon} size={15} /> {c.name} <span class="chip__count">{c.count}</span>
				</button>
			))}
		</div>

		<div class="grid grid--3 ex-grid" data-grid data-stagger>
			{rest.map((p) => (
				<ArticleCard
					slug={p.id}
					title={p.data.title}
					description={p.data.description}
					category={p.data.category}
					pubDate={p.data.pubDate}
					readingTime={readTime(p.body)}
					heroImage={p.data.heroImage}
				/>
			))}
		</div>

		<p class="ex-empty muted" data-empty hidden>Nothing filed under that yet. <button type="button" class="btn btn--link link-u" data-clear>Show everything</button></p>
	</section>

	<Newsletter variant="band" />
</Base>

<script>
	/* Category filter: instant, shareable (?c=slug), and it never leaves a card
	   stuck mid-reveal — anything we hide is marked revealed first. */
	function bindExplainers() {
		const root = document.querySelector<HTMLElement>('[data-list]');
		if (!root || root.dataset.bound) return;
		root.dataset.bound = '1';

		const grid = root.querySelector<HTMLElement>('[data-grid]')!;
		const cards = Array.from(grid.children) as HTMLElement[];
		const chips = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-cat]'));
		const countEl = root.querySelector<HTMLElement>('[data-count]')!;
		const emptyEl = root.querySelector<HTMLElement>('[data-empty]')!;
		const featureWrap = document.querySelector<HTMLElement>('[data-feature]');
		const featureCat = featureWrap?.querySelector<HTMLElement>('[data-category]')?.dataset.category ?? '';
		const valid = new Set(chips.map((c) => c.dataset.cat).filter(Boolean));
		const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

		const fromUrl = new URLSearchParams(location.search).get('c') ?? '';
		let active = valid.has(fromUrl) ? fromUrl : '';

		function apply(animate: boolean) {
			const shown: HTMLElement[] = [];
			cards.forEach((c) => {
				const on = !active || c.dataset.category === active;
				if (on) shown.push(c);
				else { c.classList.add('is-in'); c.hidden = true; }
			});
			shown.forEach((c, i) => {
				const was = c.hidden;
				c.hidden = false;
				if (animate && (was || active)) {
					c.style.setProperty('--i', String(Math.min(i, 8)));
					c.classList.remove('is-in');
				}
			});
			if (animate && shown.length) {
				void grid.offsetWidth;
				const show = () => shown.forEach((c) => c.classList.add('is-in'));
				reduced ? show() : requestAnimationFrame(show);
			}

			const featureOn = !active || featureCat === active;
			if (featureWrap) featureWrap.hidden = !featureOn;
			const total = shown.length + (featureOn ? 1 : 0);
			countEl.textContent = `${total} explainer${total === 1 ? '' : 's'}`;
			emptyEl.hidden = total > 0;
			chips.forEach((c) => c.setAttribute('aria-pressed', String((c.dataset.cat ?? '') === active)));

			const p = new URLSearchParams(location.search);
			active ? p.set('c', active) : p.delete('c');
			const qs = p.toString();
			const next = location.pathname + (qs ? `?${qs}` : '') + location.hash;
			if (next !== location.pathname + location.search + location.hash) history.replaceState(history.state, '', next);
		}

		chips.forEach((c) => c.addEventListener('click', () => { active = c.dataset.cat ?? ''; apply(true); }));
		root.querySelector('[data-clear]')?.addEventListener('click', () => { active = ''; apply(true); });
		if (active) apply(false);
	}
	bindExplainers();
	document.addEventListener('astro:page-load', bindExplainers);
</script>

<style>
	.ex-hero { padding: var(--s-8) 0 var(--s-10); }
	.ex-hero__in { display: grid; gap: var(--s-6); margin-top: var(--s-6); }
	.ex-hero__copy { display: grid; gap: var(--s-5); }
	.ex-hero__title { font-size: var(--text-5xl); max-width: 16ch; text-wrap: balance; }
	.ex-hero__links { display: flex; flex-wrap: wrap; gap: var(--s-2); }
	.ex-hero__links .chip :global(.icon) { color: var(--ink-3); }
	.ex-hero__links .chip:hover :global(.icon) { color: var(--accent); }

	.ex-feature { display: grid; gap: var(--s-5); padding-bottom: var(--s-4); }
	.ex-feature__label { margin: 0; }

	.ex-list__head { display: flex; align-items: baseline; justify-content: space-between; gap: var(--s-4); }
	.ex-list__head h2 { font-size: var(--text-2xl); }
	.ex-list__count { font-size: var(--text-sm); }
	.ex-chips { display: flex; gap: var(--s-2); margin: var(--s-5) 0 var(--s-8); padding-bottom: 2px; }
	.ex-chips .chip { flex-shrink: 0; }
	.ex-chips .chip :global(.icon) { color: var(--ink-3); }
	.ex-chips .chip[aria-pressed='true'] :global(.icon) { color: inherit; }
	.ex-grid { row-gap: var(--s-10); }
	.ex-empty { margin-top: var(--s-8); font-size: var(--text-base); }
	.ex-empty .btn--link { font-weight: 600; }

	@media (min-width: 900px) {
		.ex-hero__in { grid-template-columns: minmax(0, 1fr) auto; align-items: end; }
		.ex-hero__links { justify-content: flex-end; }
	}
	@media (max-width: 720px) {
		.ex-hero__title { font-size: var(--text-4xl); }
		.ex-list__head { flex-direction: column; align-items: flex-start; gap: var(--s-2); }
	}
</style>
