---
/**
 * `/blog/category/<slug>/` — one topic of the explainers section.
 * Same card design as `/blog/`; the chips are real links so every topic is crawlable.
 */
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import Newsletter from '../../../components/Newsletter.astro';
import Icon from '../../../components/Icon.astro';
import { SITE_TITLE, SITE_URL } from '../../../consts';
import { byNewest, categoryName, categoryIcon, categoryIntro, countWords } from '../../../lib/articles';
import { ogUrl } from '../../../og/url';

export async function getStaticPaths() {
	const all = await getCollection('blog');
	const categories = [...new Set(all.map((p) => p.data.category))];
	const counts = Object.fromEntries(categories.map((c) => [c, all.filter((p) => p.data.category === c).length]));
	return categories.map((category) => ({
		params: { category },
		props: {
			posts: byNewest(all.filter((p) => p.data.category === category)),
			siblings: categories.map((slug) => ({ slug, count: counts[slug] as number })),
			total: all.length,
		},
	}));
}

/* Reading time is measured, not asserted. */
const readTime = (body?: string) => `${Math.max(1, Math.round(countWords(body ?? '') / 200))} min read`;

const { category } = Astro.params;
const { posts, siblings, total } = Astro.props;
const [feature, ...rest] = posts;

const label = categoryName(category!);
const intro = categoryIntro(category!);
const description = `${intro} ${posts.length} explainer${posts.length === 1 ? '' : 's'} from ${SITE_TITLE}.`;

const collectionSchema = {
	'@context': 'https://schema.org',
	'@type': 'CollectionPage',
	name: label,
	description: intro,
	url: `${SITE_URL}/blog/category/${category}/`,
	isPartOf: { '@type': 'WebSite', name: SITE_TITLE, url: SITE_URL },
	mainEntity: {
		'@type': 'ItemList',
		numberOfItems: posts.length,
		itemListElement: posts.map((p, i) => ({
			'@type': 'ListItem', position: i + 1, name: p.data.title, url: `${SITE_URL}/blog/${p.id}/`,
		})),
	},
};

const ordered = [...siblings].sort((a, b) => categoryName(a.slug).localeCompare(categoryName(b.slug)));
---
<Base
	title={`${label} — explainers | ${SITE_TITLE}`}
	{description}
	image={ogUrl('category', category)}

	noNudge>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
	</Fragment>

	<section class="cat-hero">
		<div class="container">
			<Breadcrumb items={[{ name: 'Explainers', href: '/blog/' }, { name: label }]} />
			<div class="cat-hero__in">
				<span class="eyebrow"><Icon name={categoryIcon(category!)} size={13} /> {posts.length} of {total} explainers</span>
				<h1 class="cat-hero__title">{label}</h1>
				<p class="lead">{intro}</p>
			</div>
		</div>
	</section>

	<nav class="container cat-chips scroll-x" aria-label="Explainer topics">
		<a class="chip" href="/blog/">All <span class="chip__count">{total}</span></a>
		{ordered.map((s) => (
			<a
				class="chip"
				href={`/blog/category/${s.slug}/`}
				aria-current={s.slug === category ? 'page' : undefined}
				aria-pressed={s.slug === category ? 'true' : undefined}
			>
				<Icon name={categoryIcon(s.slug)} size={15} /> {categoryName(s.slug)} <span class="chip__count">{s.count}</span>
			</a>
		))}
	</nav>

	{feature && (
		<section class="container cat-feature">
			<ArticleCard
				slug={feature.id}
				title={feature.data.title}
				description={feature.data.description}
				category={feature.data.category}
				pubDate={feature.data.pubDate}
				readingTime={readTime(feature.body)}
				heroImage={feature.data.heroImage}
				author={feature.data.author}
				variant="feature"
				eager
			/>
		</section>
	)}

	{rest.length > 0 && (
		<section class="container section--tight cat-list">
			<div class="grid grid--3 cat-grid" data-stagger>
				{rest.map((p) => (
					<ArticleCard
						slug={p.id}
						title={p.data.title}
						description={p.data.description}
						category={p.data.category}
						pubDate={p.data.pubDate}
						readingTime={readTime(p.body)}
						heroImage={p.data.heroImage}
					/>
				))}
			</div>
		</section>
	)}

	{posts.length === 0 && (
		<section class="container cat-empty">
			<p class="lead">Nothing filed here yet.</p>
			<a href="/blog/" class="btn btn--ghost">Browse every explainer <Icon name="arrow-right" class="icon--arrow" /></a>
		</section>
	)}

	<Newsletter variant="band" />
</Base>

<style>
	.cat-hero { padding: var(--s-8) 0 var(--s-6); }
	.cat-hero__in { display: grid; gap: var(--s-4); margin-top: var(--s-6); }
	.cat-hero__title { font-size: var(--text-5xl); max-width: 16ch; text-wrap: balance; }
	.cat-chips { display: flex; gap: var(--s-2); padding-bottom: 2px; }
	.cat-chips .chip { flex-shrink: 0; }
	.cat-chips .chip :global(.icon) { color: var(--ink-3); }
	.cat-chips .chip[aria-current='page'] :global(.icon) { color: inherit; }
	.cat-feature { padding-top: var(--s-10); }
	.cat-grid { row-gap: var(--s-10); }
	.cat-empty { display: grid; gap: var(--s-5); justify-items: start; padding-block: var(--s-16); }
	@media (max-width: 720px) { .cat-hero__title { font-size: var(--text-4xl); } }
</style>
