---
/**
 * `/reviews/` — every tool we have actually scored, with the criteria that produced
 * the number. The weights come from `src/data/rating-criteria.ts`, the same file
 * `/rating-methodology/` reads, so the two pages can never drift apart.
 */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ToolLogo from '../components/ToolLogo.astro';
import ToolCard from '../components/ToolCard.astro';
import Stars from '../components/Stars.astro';
import Newsletter from '../components/Newsletter.astro';
import Icon from '../components/Icon.astro';
import { TOOL_CATEGORIES, CATEGORY_ICONS, SITE_TITLE, SITE_URL } from '../consts';
import { PRICING_LABELS } from '../lib/tools';
import { RATING_CRITERIA } from '../data/rating-criteria';

const tools = await getCollection('tools');

const rated = tools
	.filter((t) => t.data.rating)
	.sort((a, b) =>
		(b.data.rating ?? 0) - (a.data.rating ?? 0) ||
		(b.data.ratingCount ?? 0) - (a.data.ratingCount ?? 0) ||
		a.data.name.localeCompare(b.data.name)
	);

/* Kept separate, and labelled as such: an unscored pick is not a review. */
const queued = tools.filter((t) => !t.data.rating && t.data.featured).slice(0, 6);

const catName = (slug: string) => TOOL_CATEGORIES.find((c) => c.slug === slug)?.name ?? slug;
const usedCategories = [...new Set(rated.map((t) => t.data.category))]
	.map((slug) => ({ slug, name: catName(slug), count: rated.filter((t) => t.data.category === slug).length }))
	.sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));

const avg = rated.length ? rated.reduce((s, t) => s + (t.data.rating ?? 0), 0) / rated.length : 0;
const maxWeight = Math.max(...RATING_CRITERIA.map((c) => c.weight));

const description = `Hands-on reviews of ${rated.length} AI tools, scored out of 5 against the same five criteria. Honest verdicts, no paid placements — see what is worth your time and money.`;

const itemListSchema = {
	'@context': 'https://schema.org',
	'@type': 'ItemList',
	name: 'AI tool reviews',
	description: 'AI tools reviewed and scored by the AI Briefs editorial team.',
	numberOfItems: rated.length,
	itemListElement: rated.map((t, i) => ({
		'@type': 'ListItem', position: i + 1, name: t.data.name, url: `${SITE_URL}/tools/${t.id}/`,
	})),
};
---
<Base title={`AI tool reviews — scored by hand | ${SITE_TITLE}`} {description} noNudge>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
	</Fragment>

	<section class="rv-hero">
		<div class="container">
			<Breadcrumb items={[{ name: 'Toolbox', href: '/tools/' }, { name: 'Reviews' }]} />
			<div class="rv-hero__in">
				<div class="rv-hero__copy">
					<span class="eyebrow">Reviews · {rated.length} tools scored</span>
					<h1 class="rv-hero__title">We used them. Here's the <em class="serif">verdict</em>.</h1>
					<p class="lead">Two editors, a week of real work each, the same five criteria every time. Nobody can buy a score — paid listings are marked and rated exactly like everything else.</p>
					<div class="row rv-hero__links">
						<a href="/rating-methodology/" class="btn btn--ghost btn--sm"><Icon name="scale" /> How we rate</a>
						<a href="/tools/top-rated/" class="link-arrow">See the ranking <Icon name="arrow-right" size={16} /></a>
					</div>
				</div>
				<dl class="rv-hero__stats">
					<div><dt class="mono">Reviewed</dt><dd class="tnum">{rated.length}</dd></div>
					<div><dt class="mono">Average</dt><dd class="tnum">{avg.toFixed(1)}<span class="rv-hero__of">/5</span></dd></div>
				</dl>
			</div>
		</div>
	</section>

	<section class="container rv-crit-wrap" aria-labelledby="rv-crit">
		<h2 class="sr-only" id="rv-crit">What every score is made of</h2>
		<ol class="rv-crit" role="list">
			{RATING_CRITERIA.map((c) => (
				<li class="rv-crit__item">
					<span class="rv-crit__icon"><Icon name={c.icon} size={16} /></span>
					<span class="rv-crit__name">{c.name}</span>
					<span class="rv-crit__weight tnum">{c.weight}<span class="rv-crit__pc">%</span></span>
					<span class="rv-crit__bar" aria-hidden="true"><i style={`width:${(c.weight / maxWeight) * 100}%`}></i></span>
					<span class="rv-crit__short">{c.short}</span>
				</li>
			))}
		</ol>
		<p class="rv-crit__note muted"><Icon name="info" size={14} /> Weighted average, one decimal place, re-checked when a tool ships something big. <a href="/rating-methodology/" class="link-u">The full method</a>.</p>
	</section>

	<section class="container rv-list-wrap" data-reviews aria-labelledby="rv-list">
		<div class="rv-bar">
			<h2 id="rv-list" class="rv-bar__title">The reviews</h2>
			<div class="rv-bar__controls">
				<label class="sr-only" for="rv-sort">Sort reviews</label>
				<select id="rv-sort" class="rv-sort" data-sort>
					<option value="rating">Highest rated</option>
					<option value="az">A → Z</option>
					<option value="free">Free first</option>
				</select>
			</div>
		</div>

		<div class="rv-chips scroll-x" role="group" aria-label="Filter by category">
			<button type="button" class="chip" data-cat="" aria-pressed="true">All <span class="chip__count">{rated.length}</span></button>
			{usedCategories.map((c) => (
				<button type="button" class="chip" data-cat={c.slug} aria-pressed="false">
					<Icon name={CATEGORY_ICONS[c.slug] ?? 'boxes'} size={15} /> {c.name} <span class="chip__count">{c.count}</span>
				</button>
			))}
		</div>

		<p class="rv-count muted tnum" data-count>{rated.length} reviews</p>

		<ol class="rv" role="list" data-grid data-stagger>
			{rated.map((t) => {
				const d = t.data;
				const verdict = d.pros?.[0] ?? d.description;
				const caveat = d.cons?.[0];
				return (
					<li
						class="rv__row"
						data-category={d.category}
						data-name={d.name.toLowerCase()}
						data-rating={d.rating ?? 0}
						data-pricing={d.pricing}
					>
						<div class="rv__score">
							<span class="rv__num tnum">{(d.rating ?? 0).toFixed(1)}</span>
							<Stars rating={d.rating ?? 0} size={12} showNumber={false} />
							{!!d.ratingCount && <span class="rv__count tnum">{d.ratingCount.toLocaleString()} ratings</span>}
						</div>
						<a href={`/tools/${t.id}/`} class="rv__id">
							<ToolLogo slug={t.id} name={d.name} size={48} />
							<span class="rv__id-text">
								<span class="rv__name">
									{d.name}
									{d.verified && <span class="rv__verified"><Icon name="badge-check" size={15} title="Tested by AI Briefs" /></span>}
								</span>
								<span class="rv__meta">
									<Icon name={CATEGORY_ICONS[d.category] ?? 'boxes'} size={12} /> {d.subcategory ?? catName(d.category)}
									<span class:list={['pill', `pill--${d.pricing}`]}>{PRICING_LABELS[d.pricing]}</span>
									{d.sponsored && <span class="pill pill--outline">Paid listing</span>}
								</span>
							</span>
						</a>
						<div class="rv__verdict">
							<p class="rv__pro"><Icon name="check" size={14} /> <span>{verdict}</span></p>
							{caveat && <p class="rv__con"><Icon name="minus" size={14} /> <span>{caveat}</span></p>}
						</div>
						<div class="rv__actions">
							<a href={`/tools/${t.id}/`} class="btn btn--sm">Read review <Icon name="arrow-right" class="icon--arrow" /></a>
						</div>
					</li>
				);
			})}
		</ol>

		<p class="rv-empty muted" data-empty hidden>Nothing reviewed in that category yet. <button type="button" class="btn btn--link link-u" data-clear>Show all reviews</button></p>
	</section>

	{queued.length > 0 && (
		<section class="container section--tight">
			<div class="section-head">
				<div class="section-head__title">
					<span class="eyebrow">In the queue</span>
					<h2>Tested, not yet <em class="serif">scored</em>.</h2>
					<p class="section-head__desc">We rate a tool only after two editors have used it on real work for a week. These are next.</p>
				</div>
				<a href="/tools/" class="link-arrow">The toolbox <Icon name="arrow-right" size={16} /></a>
			</div>
			<div class="rv-queue" data-stagger>
				{queued.map((t) => (
					<div class="rv-queue__item">
						<ToolCard
							slug={t.id}
							name={t.data.name}
							description={t.data.description}
							category={t.data.category}
							subcategory={t.data.subcategory}
							pricing={t.data.pricing}
							verified={t.data.verified}
							variant="mini"
						/>
					</div>
				))}
			</div>
		</section>
	)}

	<Newsletter variant="band" heading="New scores, as they *land*." text="When a tool earns a rating — or loses one — it goes in the brief. Three minutes a day, free." />
</Base>

<script>
	/* Category + sort, client-side over rendered rows. Shareable via ?c= and ?sort=. */
	function bindReviews() {
		const root = document.querySelector<HTMLElement>('[data-reviews]');
		if (!root || root.dataset.bound) return;
		root.dataset.bound = '1';

		const list = root.querySelector<HTMLElement>('[data-grid]')!;
		const rows = Array.from(list.children) as HTMLElement[];
		rows.forEach((r, i) => (r.dataset.i = String(i)));
		const chips = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-cat]'));
		const sortEl = root.querySelector<HTMLSelectElement>('[data-sort]')!;
		const countEl = root.querySelector<HTMLElement>('[data-count]')!;
		const emptyEl = root.querySelector<HTMLElement>('[data-empty]')!;
		const valid = new Set(chips.map((c) => c.dataset.cat).filter(Boolean));
		const SORTS = ['rating', 'az', 'free'];
		const params = new URLSearchParams(location.search);

		let cat = valid.has(params.get('c') ?? '') ? params.get('c')! : '';
		let sort = SORTS.includes(params.get('sort') ?? '') ? params.get('sort')! : 'rating';
		const rank = { free: 0, freemium: 1, paid: 2 } as Record<string, number>;

		function apply() {
			const order = [...rows].sort((a, b) => {
				if (sort === 'az') return (a.dataset.name ?? '').localeCompare(b.dataset.name ?? '');
				if (sort === 'free') {
					const p = (rank[a.dataset.pricing ?? ''] ?? 3) - (rank[b.dataset.pricing ?? ''] ?? 3);
					if (p) return p;
				}
				return Number(b.dataset.rating) - Number(a.dataset.rating) || Number(a.dataset.i) - Number(b.dataset.i);
			});
			const frag = document.createDocumentFragment();
			order.forEach((r) => frag.appendChild(r));
			list.appendChild(frag);

			let shown = 0;
			rows.forEach((r) => {
				const on = !cat || r.dataset.category === cat;
				if (!on) r.classList.add('is-in'); // never leave a hidden row mid-reveal
				r.hidden = !on;
				if (on) shown++;
			});

			countEl.textContent = `${shown} review${shown === 1 ? '' : 's'}`;
			emptyEl.hidden = shown > 0;
			chips.forEach((c) => c.setAttribute('aria-pressed', String((c.dataset.cat ?? '') === cat)));
			if (sortEl.value !== sort) sortEl.value = sort;

			const p = new URLSearchParams(location.search);
			cat ? p.set('c', cat) : p.delete('c');
			sort !== 'rating' ? p.set('sort', sort) : p.delete('sort');
			const qs = p.toString();
			const next = location.pathname + (qs ? `?${qs}` : '') + location.hash;
			if (next !== location.pathname + location.search + location.hash) history.replaceState(history.state, '', next);
		}

		chips.forEach((c) => c.addEventListener('click', () => { cat = c.dataset.cat ?? ''; apply(); }));
		sortEl.addEventListener('change', () => { sort = sortEl.value; apply(); });
		root.querySelector('[data-clear]')?.addEventListener('click', () => { cat = ''; apply(); });
		if (cat || sort !== 'rating') apply();
	}
	bindReviews();
	document.addEventListener('astro:page-load', bindReviews);
</script>

<style>
	.rv-hero { padding: var(--s-8) 0 var(--s-10); }
	.rv-hero__in { display: grid; gap: var(--s-8); margin-top: var(--s-6); align-items: end; }
	.rv-hero__copy { display: grid; gap: var(--s-5); justify-items: start; }
	.rv-hero__title { font-size: var(--text-5xl); max-width: 15ch; text-wrap: balance; }
	.rv-hero__links { gap: var(--s-5); }
	@media (min-width: 900px) { .rv-hero__in { grid-template-columns: minmax(0, 1fr) auto; } }
	.rv-hero__stats { display: grid; grid-auto-flow: column; gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: var(--r-lg); overflow: hidden; }
	.rv-hero__stats > div { background: var(--surface); padding: var(--s-5) var(--s-6); display: grid; gap: var(--s-1); min-width: 140px; }
	.rv-hero__stats dd { font-size: var(--text-3xl); font-weight: 600; letter-spacing: -0.03em; line-height: 1; }
	.rv-hero__of { font-size: var(--text-sm); color: var(--ink-4); font-weight: 500; margin-left: 2px; }

	/* ── criteria strip ───────────────────────────────────────────────── */
	.rv-crit-wrap { display: grid; gap: var(--s-4); padding-bottom: var(--s-12); }
	.rv-crit { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: var(--r-lg); overflow: hidden; }
	.rv-crit__item { background: var(--surface); padding: var(--s-5); display: grid; grid-template-columns: auto 1fr; gap: var(--s-2) var(--s-3); align-content: start; }
	.rv-crit__icon { grid-row: span 2; width: 34px; height: 34px; border-radius: var(--r-sm); display: grid; place-items: center; background: var(--accent-soft); color: var(--accent-ink); }
	.rv-crit__name { font-size: var(--text-sm); font-weight: 600; letter-spacing: -0.01em; align-self: end; }
	.rv-crit__weight { font-family: var(--font-mono); font-size: var(--text-sm); color: var(--ink-3); align-self: start; }
	.rv-crit__pc { font-size: 0.6875rem; }
	.rv-crit__bar { grid-column: 1 / -1; height: 3px; border-radius: 2px; background: var(--surface-3); overflow: hidden; }
	.rv-crit__bar i { display: block; height: 100%; background: var(--accent); border-radius: 2px; }
	.rv-crit__short { grid-column: 1 / -1; font-size: var(--text-xs); color: var(--ink-3); line-height: 1.45; }
	.rv-crit__note { display: flex; align-items: center; gap: var(--s-2); font-size: var(--text-xs); }
	.rv-crit__note :global(.icon) { flex-shrink: 0; }

	/* ── controls ─────────────────────────────────────────────────────── */
	.rv-list-wrap { padding-bottom: var(--s-16); }
	.rv-bar { display: flex; align-items: center; justify-content: space-between; gap: var(--s-4); }
	.rv-bar__title { font-size: var(--text-2xl); }
	.rv-sort {
		height: 36px; padding: 0 var(--s-3); border-radius: var(--r-full); border: 1px solid var(--line-2);
		background: var(--surface); color: var(--ink); font-size: var(--text-xs); font-weight: 600; cursor: pointer;
	}
	.rv-sort:hover { border-color: var(--line-strong); }
	.rv-chips { display: flex; gap: var(--s-2); margin: var(--s-5) 0 var(--s-4); padding-bottom: 2px; }
	.rv-chips .chip { flex-shrink: 0; }
	.rv-chips .chip :global(.icon) { color: var(--ink-3); }
	.rv-chips .chip[aria-pressed='true'] :global(.icon) { color: inherit; }
	.rv-count { font-size: var(--text-xs); font-family: var(--font-mono); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: var(--s-4); }

	/* ── review rows ──────────────────────────────────────────────────── */
	.rv { display: grid; gap: var(--s-3); }
	.rv__row {
		display: grid; grid-template-columns: 110px minmax(0, 1.15fr) minmax(0, 1.35fr) auto; gap: var(--s-6); align-items: center;
		padding: var(--s-5) var(--s-6); border: 1px solid var(--line); border-radius: var(--r-lg); background: var(--surface);
		transition: transform var(--dur-3) var(--ease-out), box-shadow var(--dur-3) var(--ease-out), border-color var(--dur-3);
	}
	.rv__row:hover { transform: translateY(-2px); box-shadow: var(--shadow-lg); border-color: var(--line-2); }
	.rv__score { display: grid; gap: 4px; justify-items: start; }
	.rv__num { font-size: 2.5rem; font-weight: 600; letter-spacing: -0.04em; line-height: 1; }
	.rv__score :global(.rating) { color: var(--warn); }
	.rv__count { font-family: var(--font-mono); font-size: 0.625rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-4); }
	.rv__id { display: flex; align-items: center; gap: var(--s-4); min-width: 0; color: inherit; }
	.rv__id-text { display: grid; gap: 5px; min-width: 0; }
	.rv__name { display: inline-flex; align-items: center; gap: 5px; font-size: var(--text-lg); font-weight: 600; letter-spacing: -0.02em; line-height: 1.2; }
	.rv__id:hover .rv__name { color: var(--accent-ink); }
	.rv__verified { display: inline-flex; color: var(--info); flex-shrink: 0; }
	.rv__meta :global(.icon) { flex-shrink: 0; }
	.rv__meta { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-2); font-size: var(--text-xs); color: var(--ink-3); }
	.rv__verdict { display: grid; gap: 5px; min-width: 0; font-size: var(--text-sm); line-height: 1.5; }
	.rv__pro, .rv__con { display: flex; gap: var(--s-2); align-items: flex-start; }
	.rv__pro { color: var(--ink-2); }
	.rv__con { color: var(--ink-3); }
	.rv__pro :global(.icon) { color: var(--good); flex-shrink: 0; margin-top: 3px; }
	.rv__con :global(.icon) { color: var(--ink-4); flex-shrink: 0; margin-top: 3px; }
	.rv__verdict span { display: -webkit-box; -webkit-line-clamp: 2; line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
	.rv__actions { justify-self: end; }
	.rv-empty { margin-top: var(--s-8); font-size: var(--text-base); }
	.rv-queue { display: flex; flex-wrap: wrap; gap: var(--s-3); }
	.rv-queue__item { flex: 1 1 260px; max-width: 320px; }

	@media (max-width: 1100px) {
		.rv-crit { grid-template-columns: repeat(2, minmax(0, 1fr)); }
		.rv-crit__item:last-child { grid-column: 1 / -1; }
		.rv__row { grid-template-columns: 96px minmax(0, 1fr) auto; grid-template-areas: 'score id actions' 'score verdict verdict'; row-gap: var(--s-4); }
		.rv__score { grid-area: score; }
		.rv__id { grid-area: id; }
		.rv__verdict { grid-area: verdict; }
		.rv__actions { grid-area: actions; }
	}
	@media (max-width: 900px) {
		.rv-hero__in { grid-template-columns: minmax(0, 1fr); }
		.rv-hero__stats { justify-self: start; }
	}
	@media (max-width: 640px) {
		.rv-hero__title { font-size: var(--text-4xl); }
		.rv-crit { grid-template-columns: minmax(0, 1fr); }
		.rv-crit__item:last-child { grid-column: auto; }
		.rv__row { grid-template-columns: minmax(0, 1fr); grid-template-areas: 'id' 'score' 'verdict' 'actions'; padding: var(--s-5); }
		.rv__score { grid-auto-flow: column; align-items: center; gap: var(--s-3); }
		.rv__num { font-size: var(--text-2xl); }
		.rv__count { display: none; }
		.rv__actions { justify-self: stretch; }
		.rv__actions .btn { width: 100%; }
	}
</style>
