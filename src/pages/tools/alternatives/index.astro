---
/**
 * Alternatives hub (indexable): "Alternatives to X" for the 40 highest-rated /
 * featured tools that have an alternatives page, grouped by category.
 */
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import ToolLogo from '../../../components/ToolLogo.astro';
import Icon from '../../../components/Icon.astro';
import Newsletter from '../../../components/Newsletter.astro';
import { TOOL_CATEGORIES, CATEGORY_ICONS, SITE_URL } from '../../../consts';

type Tool = CollectionEntry<'tools'>;
const tools = await getCollection('tools');
const catCount = new Map<string, number>();
for (const t of tools) catCount.set(t.data.category, (catCount.get(t.data.category) ?? 0) + 1);
const keyOf = (t: Tool) => t.data.subcategory ?? t.data.category;
const peerCount = new Map<string, number>();
for (const t of tools) peerCount.set(keyOf(t), (peerCount.get(keyOf(t)) ?? 0) + 1);

/* Same rule as alternatives/[slug].astro getStaticPaths: ≥ 2 category peers. */
const eligible = tools.filter((t) => (catCount.get(t.data.category) ?? 0) - 1 >= 2);
const score = (t: Tool) => (t.data.rating ?? 0) * 10 + (t.data.featured ? 5 : 0) + Math.min((peerCount.get(keyOf(t)) ?? 1) - 1, 9) * 0.1;
const picks = [...eligible].sort((a, b) => score(b) - score(a) || a.data.name.localeCompare(b.data.name)).slice(0, 40);
const groups = TOOL_CATEGORIES
	.map((cat) => ({ cat, items: picks.filter((t) => t.data.category === cat.slug) }))
	.filter((g) => g.items.length > 0);
const ratedCount = picks.filter((t) => t.data.rating).length;

const title = `AI tool alternatives (2026): what to try instead of ${picks.length} popular tools`;
const description = `Alternatives to the ${picks.length} most-used AI tools, grouped by category and ranked by our editorial scores. Find the one that fits your work and your budget.`;
const itemList = {
	'@context': 'https://schema.org',
	'@type': 'ItemList',
	name: 'AI tool alternatives',
	itemListElement: picks.map((t, i) => ({ '@type': 'ListItem', position: i + 1, name: `${t.data.name} alternatives`, url: `${SITE_URL}/tools/alternatives/${t.id}/` })),
};
const alternativesCount = (t: Tool) => Math.min(12, (catCount.get(t.data.category) ?? 1) - 1);
---
<Base title={title} description={description} noNudge>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(itemList)} />
	</Fragment>

	<section class="hub">
		<div class="container">
			<Breadcrumb items={[{ name: 'Toolbox', href: '/tools/' }, { name: 'Alternatives' }]} />
			<div class="hub__grid">
				<div class="hub__copy">
					<span class="eyebrow">Alternatives · {picks.length} tools · {groups.length} categories</span>
					<h1 class="hub__title">Find a better <em class="serif">fit</em>.</h1>
					<p class="lead">Every popular AI tool has a rival that is cheaper, simpler or better at one specific thing. These pages rank the alternatives to the tools people look up most — {ratedCount} of them scored from hands-on testing.</p>
				</div>
				<nav class="hub__jump" aria-label="Jump to category">
					<span class="meta">Jump to</span>
					<div class="hub__chips">
						{groups.map((g) => <a href={`#${g.cat.slug}`} class="chip"><Icon name={CATEGORY_ICONS[g.cat.slug] ?? 'boxes'} size={13} /> {g.cat.name.replace(/^AI /, '')} <span class="chip__count">{g.items.length}</span></a>)}
					</div>
				</nav>
			</div>
		</div>
	</section>

	<div class="container hub__body">
		{groups.map((g) => (
			<section class="hub__group" id={g.cat.slug} aria-labelledby={`h-${g.cat.slug}`}>
				<div class="section-head hub__head">
					<div class="section-head__title">
						<span class="eyebrow"><Icon name={CATEGORY_ICONS[g.cat.slug] ?? 'boxes'} size={12} /> {g.cat.name}</span>
						<h2 id={`h-${g.cat.slug}`}>Alternatives to {g.cat.name.replace(/^AI /, '')} tools</h2>
					</div>
					<a href={`/tools/category/${g.cat.slug}/`} class="link-arrow">All {catCount.get(g.cat.slug)} tools <Icon name="arrow-right" /></a>
				</div>
				<div class="hub__cards" data-stagger>
					{g.items.map((t) => (
						<a href={`/tools/alternatives/${t.id}/`} rel="nofollow" class="card card--hover hcard">
							<ToolLogo slug={t.id} name={t.data.name} size={44} />
							<span class="hcard__id">
								<span class="hcard__name">Alternatives to <b>{t.data.name}</b></span>
								<span class="hcard__meta">
									<span>{alternativesCount(t)} options</span>
									{t.data.subcategory && <><span class="hcard__dot" aria-hidden="true"></span><span>{t.data.subcategory}</span></>}
								</span>
							</span>
							{t.data.rating
								? <span class="hcard__score tnum"><Icon name="star" size={11} /> {t.data.rating.toFixed(1)}</span>
								: <span class="hcard__arrow"><Icon name="arrow-right" size={16} /></span>}
						</a>
					))}
				</div>
			</section>
		))}

		<Newsletter variant="card" heading="Know before you *switch*." text="What changed in AI, why it matters, and what to do about it — in the brief, three minutes a day. Plain English, no hype." id="newsletter-alts" />
	</div>
</Base>

<style>
	.hub { position: relative; padding: var(--s-8) 0 var(--s-12); border-bottom: 1px solid var(--line); overflow: hidden; }
	.hub::before { content: ''; position: absolute; right: -8%; top: -50%; width: 42%; aspect-ratio: 1; border-radius: 50%; background: radial-gradient(closest-side, var(--accent-soft), transparent 72%); filter: blur(40px); pointer-events: none; }
	.hub .container { position: relative; }
	.hub__grid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); gap: var(--s-16); align-items: end; margin-top: var(--s-6); }
	.hub__copy { display: grid; gap: var(--s-5); }
	.hub__title { font-size: var(--text-6xl); font-weight: 500; letter-spacing: -0.045em; line-height: 0.96; }
	.hub__jump { display: grid; gap: var(--s-3); }
	.hub__chips { display: flex; flex-wrap: wrap; gap: 6px; }
	.hub__body { display: grid; gap: var(--s-16); padding-block: var(--s-12) var(--s-20); }
	.hub__group { scroll-margin-top: calc(var(--header-h, 64px) + 24px); }
	.hub__head { margin-bottom: var(--s-6); }
	.hub__cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-4); }
	.hcard { display: flex; align-items: center; gap: var(--s-4); padding: var(--s-4) var(--s-5); color: inherit; }
	.hcard__id { display: grid; gap: 3px; min-width: 0; flex: 1; }
	.hcard__name { font-size: var(--text-sm); color: var(--ink-2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
	.hcard__name b { color: var(--ink); font-weight: 600; }
	.hcard__meta { display: flex; align-items: center; gap: 8px; font-size: var(--text-xs); color: var(--ink-3); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
	.hcard__dot { width: 3px; height: 3px; border-radius: 50%; background: var(--ink-4); flex-shrink: 0; }
	.hcard__score { display: inline-flex; align-items: center; gap: 4px; font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 600; color: var(--ink); padding: 4px 8px; border-radius: var(--r-full); background: var(--surface-2); flex-shrink: 0; }
	.hcard__score :global(.icon) { color: var(--warn); fill: currentColor; }
	.hcard__arrow { color: var(--ink-4); transition: transform var(--dur-2) var(--ease-out), color var(--dur-2); flex-shrink: 0; }
	.hcard:hover .hcard__arrow { transform: translateX(3px); color: var(--ink); }
	@media (max-width: 1100px) { .hub__cards { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
	@media (max-width: 960px) { .hub__grid { grid-template-columns: 1fr; gap: var(--s-8); align-items: start; } }
	@media (max-width: 640px) { .hub__cards { grid-template-columns: 1fr; } .hub__title { font-size: var(--text-5xl); } }
</style>
