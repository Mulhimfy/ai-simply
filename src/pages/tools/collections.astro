---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import ToolCard from '../../components/ToolCard.astro';
import ToolLogo from '../../components/ToolLogo.astro';
import Newsletter from '../../components/Newsletter.astro';
import Icon from '../../components/Icon.astro';
import { SITE_TITLE } from '../../consts';
import { cardProps, plural } from '../../lib/tools';

const allTools = await getCollection('tools');

function getTools(filter: (t: (typeof allTools)[0]) => boolean, limit = 6) {
	return allTools.filter(filter).slice(0, limit);
}

// The curated collections. Same ids and predicates as before; the titles and blurbs are
// plain reference copy (no "best/top", no hype), the emoji became Lucide icons, and
// `href` points at the wider list where one exists.
const collections = [
	{
		id: 'best-free',
		title: 'Free to use',
		icon: 'gift',
		description: 'Rated 4 or better and free to use — no card, no trial clock.',
		tools: getTools((t) => t.data.pricing === 'free' && (t.data.rating ?? 0) >= 4),
		href: '/tools/?pricing=free',
	},
	{
		id: 'top-chatbots',
		title: 'Chatbots and assistants',
		icon: 'message-circle',
		description: 'Conversational assistants for research, writing and everyday questions.',
		tools: getTools((t) => t.data.category === 'ai-chatbot'),
		href: '/tools/category/ai-chatbot/',
	},
	{
		id: 'ai-image-generators',
		title: 'Image generators',
		icon: 'image',
		description: 'Text-to-image tools, from quick drafts to work you can actually ship.',
		tools: getTools((t) => t.data.category === 'ai-image' || t.data.category === 'ai-art'),
		href: '/tools/category/ai-image/',
	},
	{
		id: 'ai-writing',
		title: 'Writing tools',
		icon: 'pen-line',
		description: 'Drafting, editing and rewriting — blog posts, emails, marketing copy.',
		tools: getTools((t) => t.data.category === 'ai-writing'),
		href: '/tools/category/ai-writing/',
	},
	{
		id: 'ai-coding',
		title: 'Coding assistants',
		icon: 'code-2',
		description: 'Completion, review and refactoring, mostly inside your editor.',
		tools: getTools((t) => t.data.category === 'ai-coding'),
		href: '/tools/category/ai-coding/',
	},
	{
		id: 'ai-video',
		title: 'Video tools',
		icon: 'clapperboard',
		description: 'Generate, edit and clean up video without a production crew.',
		tools: getTools((t) => t.data.category === 'ai-video'),
		href: '/tools/category/ai-video/',
	},
	{
		id: 'ai-productivity',
		title: 'Productivity tools',
		icon: 'zap',
		description: 'Automate busywork, manage tasks and keep notes in order.',
		tools: getTools((t) => t.data.category === 'ai-productivity'),
		href: '/tools/category/ai-productivity/',
	},
	{
		id: 'ai-voice',
		title: 'Voice and audio',
		icon: 'mic',
		description: 'Text to speech, voice cloning, transcription and audio clean-up.',
		tools: getTools((t) => t.data.category === 'ai-voice'),
		href: '/tools/category/ai-voice/',
	},
	{
		id: 'chatgpt-alternatives',
		title: 'ChatGPT alternatives',
		icon: 'refresh-cw',
		description: 'Assistants worth a look if ChatGPT is not the right fit for the job.',
		tools: getTools((t) => t.data.category === 'ai-chatbot' && t.data.name !== 'ChatGPT'),
		href: '/tools/category/ai-chatbot/',
	},
	{
		id: 'freemium-picks',
		title: 'Freemium picks',
		icon: 'star',
		description: 'Rated 4 or better, with a free tier that is genuinely usable before you pay.',
		tools: getTools((t) => t.data.pricing === 'freemium' && (t.data.rating ?? 0) >= 4),
		href: '/tools/?pricing=freemium',
	},
].filter((c) => c.tools.length > 0);

const totalTools = new Set(collections.flatMap((c) => c.tools.map((t) => t.id))).size;
// bento spans: wide tiles at positions 0 and 5 (2+1+1 · 1+1+2 · 1+1+1+1)
const wide = new Set([0, 5]);
---
<Base
	title={`Collections — short lists of AI tools for common jobs | ${SITE_TITLE}`}
	description="Hand-picked slices of the toolbox: writing, coding, images, video, voice and more — six tools at most per list, so you can actually choose."

	noNudge>
	<section class="col-hero">
		<div class="container">
			<Breadcrumb items={[{ name: 'Toolbox', href: '/tools/' }, { name: 'Collections' }]} />
			<div class="col-hero__in">
				<span class="eyebrow">Toolbox · {collections.length} collections · {totalTools} tools</span>
				<h1 class="col-hero__title">Short lists for <em class="serif">common</em> jobs.</h1>
				<p class="lead">Each collection is a hand-picked slice of the toolbox — six tools at most, so you can actually choose. Pick a stack, then jump to its list below.</p>
			</div>
		</div>
	</section>

	<nav class="container col-bento" aria-label="Collections">
		<div class="col-bento__grid" data-stagger>
			{collections.map((c, i) => (
				<a href={`#${c.id}`} class:list={['col-tile card card--hover', { 'col-tile--wide': wide.has(i) }]}>
					<span class="col-tile__icon"><Icon name={c.icon} size={20} /></span>
					<span class="col-tile__body">
						<span class="col-tile__name">{c.title}</span>
						<span class="col-tile__desc">{c.description}</span>
					</span>
					<span class="col-tile__foot">
						<span class="col-tile__logos" aria-hidden="true">
							{c.tools.slice(0, 3).map((t) => <ToolLogo slug={t.id} name={t.data.name} size={28} />)}
						</span>
						<span class="mono col-tile__count">{plural(c.tools.length)}</span>
						<Icon name="arrow-down" size={16} class="col-tile__arrow" />
					</span>
				</a>
			))}
		</div>
	</nav>

	<div class="container col-sections">
		{collections.map((c) => (
			<section id={c.id} class="col-sec" aria-labelledby={`h-${c.id}`}>
				<header class="col-sec__head">
					<span class="col-sec__icon"><Icon name={c.icon} size={20} /></span>
					<div class="col-sec__title">
						<h2 id={`h-${c.id}`}>{c.title}</h2>
						<p class="muted">{c.description}</p>
					</div>
					<div class="col-sec__meta">
						<span class="mono">{plural(c.tools.length)}</span>
						{c.href && <a href={c.href} class="link-arrow">See the full list <Icon name="arrow-right" size={16} /></a>}
					</div>
				</header>
				<div class="col-sec__grid" data-stagger>
					{c.tools.map((t) => <ToolCard {...cardProps(t)} variant="row" />)}
				</div>
				<a href="#top" class="col-sec__up mono" data-scroll-top><Icon name="arrow-up" size={12} /> All collections</a>
			</section>
		))}
	</div>

	<Newsletter variant="band" heading="Build a better *stack*." text="What changed in AI, why it matters, and the tools worth trying — in the brief, three minutes a day. Free, and one click to leave." />
</Base>

<style>
	.col-hero { padding: var(--s-8) 0 var(--s-8); }
	.col-hero__in { display: grid; gap: var(--s-4); justify-items: start; margin-top: var(--s-6); max-width: 72ch; }
	.col-hero__title { font-size: var(--text-5xl); max-width: 14ch; text-wrap: balance; }

	.col-bento { padding-bottom: var(--s-16); }
	.col-bento__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--s-4); }
	.col-tile { display: flex; flex-direction: column; gap: var(--s-4); padding: var(--s-5); color: inherit; min-height: 196px; }
	.col-tile--wide { grid-column: span 2; }
	.col-tile__icon { width: 40px; height: 40px; display: grid; place-items: center; border-radius: var(--r-sm); background: var(--surface-2); color: var(--ink-2); transition: color var(--dur-2), background-color var(--dur-2); }
	.col-tile:hover .col-tile__icon { color: var(--accent); background: var(--accent-soft); }
	.col-tile__body { display: grid; gap: var(--s-1); flex: 1; }
	.col-tile__name { font-weight: 600; font-size: var(--text-md); letter-spacing: -0.015em; line-height: 1.25; }
	.col-tile__desc { font-size: var(--text-sm); color: var(--ink-3); line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 2; line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
	.col-tile--wide .col-tile__desc { -webkit-line-clamp: 3; line-clamp: 3; }
	.col-tile__foot { display: flex; align-items: center; gap: var(--s-3); margin-top: auto; }
	.col-tile__logos { display: flex; }
	.col-tile__logos > :global(.logo-mark) { box-shadow: 0 0 0 2px var(--surface); }
	.col-tile__logos > :global(.logo-mark + .logo-mark) { margin-left: -8px; }
	.col-tile__count { text-transform: none; letter-spacing: 0; }
	.col-tile__foot :global(.col-tile__arrow) { margin-left: auto; color: var(--ink-4); transition: transform var(--dur-2) var(--ease-out), color var(--dur-2); }
	.col-tile:hover :global(.col-tile__arrow) { transform: translateY(3px); color: var(--ink); }

	.col-sections { display: grid; gap: var(--s-16); padding-bottom: var(--s-16); }
	.col-sec { scroll-margin-top: calc(var(--header-h, 64px) + var(--s-6)); position: relative; }
	.col-sec__head { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: var(--s-4) var(--s-5); align-items: start; padding-bottom: var(--s-5); margin-bottom: var(--s-5); border-bottom: 1px solid var(--line); }
	.col-sec__icon { width: 44px; height: 44px; display: grid; place-items: center; border-radius: var(--r-sm); background: var(--surface-2); color: var(--accent); }
	.col-sec__title { display: grid; gap: var(--s-1); }
	.col-sec__title h2 { font-size: var(--text-2xl); }
	.col-sec__title p { max-width: 60ch; }
	.col-sec__meta { display: grid; gap: var(--s-2); justify-items: end; padding-top: var(--s-2); }
	.col-sec__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-3); }
	.col-sec__up { display: inline-flex; align-items: center; gap: var(--s-1); margin-top: var(--s-4); text-transform: none; letter-spacing: 0; transition: color var(--dur-2); }
	.col-sec__up:hover { color: var(--ink); }

	@media (max-width: 1024px) {
		.col-bento__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
		.col-tile { min-height: 0; }
		.col-sec__grid { grid-template-columns: 1fr; }
	}
	@media (max-width: 640px) {
		.col-hero__title { font-size: var(--text-4xl); }
		.col-bento__grid { grid-template-columns: 1fr; }
		.col-tile--wide { grid-column: auto; }
		.col-sec__head { grid-template-columns: auto minmax(0, 1fr); }
		.col-sec__meta { grid-column: 1 / -1; justify-items: start; grid-auto-flow: column; align-items: center; gap: var(--s-4); }
	}
</style>

<script>
	// "All collections" links scroll back to the bento without polluting the URL hash.
	function bind() {
		document.querySelectorAll<HTMLAnchorElement>('[data-scroll-top]').forEach((a) => {
			if (a.dataset.bound) return; a.dataset.bound = '1';
			a.addEventListener('click', (e) => {
				e.preventDefault();
				document.querySelector('.col-bento')?.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
				history.replaceState(history.state, '', location.pathname + location.search);
			});
		});
	}
	bind();
	document.addEventListener('astro:page-load', bind);
</script>
