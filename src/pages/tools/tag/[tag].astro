---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import ToolListing from '../../../components/ToolListing.astro';
import Icon from '../../../components/Icon.astro';
import { TOOL_CATEGORIES, CATEGORY_ICONS, SITE_TITLE } from '../../../consts';
import { countBy } from '../../../lib/tools';

export async function getStaticPaths() {
	const tools = await getCollection('tools');
	const tagMap = new Map<string, typeof tools>();
	for (const tool of tools) {
		for (const tag of tool.data.tags ?? []) {
			const slug = tag.toLowerCase().replace(/\s+/g, '-');
			if (!tagMap.has(slug)) tagMap.set(slug, []);
			tagMap.get(slug)!.push(tool);
		}
	}
	return [...tagMap.entries()].map(([slug, tools]) => ({
		params: { tag: slug },
		props: {
			tag: tools[0].data.tags?.find((t) => t.toLowerCase().replace(/\s+/g, '-') === slug) ?? slug,
			tools: tools.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
		},
	}));
}

const { tag, tools } = Astro.props;
const title = `Tools tagged “${tag}” — ${SITE_TITLE}`;
const description = `${tools.length} ${tools.length === 1 ? 'tool' : 'tools'} in the toolbox carry the “${tag}” tag. Tags are looser than categories — a scrapbook, not a ranking.`;

// where these tools live — a handful of category links keeps the (noindex) tag page useful
const catCounts = countBy(tools, (t) => t.data.category);
const cats = TOOL_CATEGORIES.filter((c) => catCounts[c.slug]).sort((a, b) => catCounts[b.slug] - catCounts[a.slug]).slice(0, 5);
---
<Base {title} {description} noindex={true} noNudge>
	<section class="tag-hero">
		<div class="container">
			<Breadcrumb items={[{ name: 'Toolbox', href: '/tools/' }, { name: `#${tag}` }]} />
			<div class="tag-hero__in">
				<span class="eyebrow">Toolbox · tag</span>
				<h1 class="tag-hero__title"><span class="serif tag-hero__hash">#</span>{tag}</h1>
				<p class="lead">{tools.length} {tools.length === 1 ? 'tool' : 'tools'} carry this tag. Tags are looser than categories — think of this as a scrapbook, not a ranking.</p>
				{cats.length > 0 && (
					<div class="tag-hero__cats">
						<span class="mono">Mostly in</span>
						{cats.map((c) => (
							<a class="chip" href={`/tools/category/${c.slug}/`}><Icon name={CATEGORY_ICONS[c.slug] ?? 'boxes'} size={14} /> {c.name} <span class="chip__count">{catCounts[c.slug]}</span></a>
						))}
					</div>
				)}
			</div>
		</div>
	</section>

	<ToolListing tools={tools} allTools={tools} defaultSort="rating" placeholder={`Search ${tools.length} tagged tools…`} />
</Base>

<style>
	.tag-hero { padding: var(--s-8) 0 var(--s-4); }
	.tag-hero__in { display: grid; gap: var(--s-4); justify-items: start; margin-top: var(--s-6); max-width: 72ch; }
	.tag-hero__title { font-size: var(--text-5xl); overflow-wrap: anywhere; }
	.tag-hero__hash { color: var(--accent); margin-right: 0.05em; }
	.tag-hero__cats { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-2); margin-top: var(--s-2); }
	.tag-hero__cats .mono { margin-right: var(--s-2); }
	.tag-hero__cats .chip { height: 32px; font-size: var(--text-xs); }
	.tag-hero__cats .chip :global(.icon) { color: var(--ink-3); }
	@media (max-width: 640px) { .tag-hero__title { font-size: var(--text-4xl); } }
</style>
