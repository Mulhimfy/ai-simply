---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import ToolLogo from '../../../components/ToolLogo.astro';
import Stars from '../../../components/Stars.astro';
import ShareBar from '../../../components/ShareBar.astro';
import ToolCard from '../../../components/ToolCard.astro';
import CompareTable from '../../../components/CompareTable.astro';
import Newsletter from '../../../components/Newsletter.astro';
import Icon from '../../../components/Icon.astro';
import { TOOL_CATEGORIES, PRICING_BADGE, CATEGORY_ICONS } from '../../../consts';
import { ogUrl } from '../../../og/url';

export async function getStaticPaths() {
	const tools = await getCollection('tools');

	// Group by subcategory
	const bySub: Record<string, typeof tools> = {};
	for (const t of tools) {
		const key = t.data.subcategory ?? t.data.category;
		if (!bySub[key]) bySub[key] = [];
		bySub[key].push(t);
	}

	const paths: { params: { slug: string }; props: any }[] = [];

	for (const group of Object.values(bySub)) {
		if (group.length < 2) continue;
		for (let i = 0; i < group.length; i++) {
			for (let j = i + 1; j < group.length; j++) {
				const a = group[i], b = group[j];
				paths.push({
					params: { slug: `${a.id}-vs-${b.id}` },
					props: { toolA: a, toolB: b },
				});
			}
		}
	}

	return paths;
}

const { toolA, toolB } = Astro.props;
const { slug } = Astro.params;
const allTools = await getCollection('tools');

const catA = TOOL_CATEGORIES.find(c => c.slug === toolA.data.category);
const year = new Date().getFullYear();

const nameA = toolA.data.name;
const nameB = toolB.data.name;
const subKey = toolA.data.subcategory ?? toolA.data.category;
const subLabel = toolA.data.subcategory ?? catA?.name ?? 'AI';
/** "AI Chatbot" → "AI chatbot": keep initialisms, lowercase the rest, so generated
 *  sentences read like English instead of a database field. */
const speak = (str: string) => str.split(' ').map((w) => (/^[A-Z0-9.]{2,}$/.test(w) ? w : w.toLowerCase())).join(' ');
const subSpoken = speak(subLabel);

const seoTitle = `${nameA} vs ${nameB} (${year}): Which Is Better?`;
const seoDesc = `${nameA} vs ${nameB} — side-by-side comparison of features, pricing, and ratings to help you pick the right ${speak(catA?.name ?? 'AI')} tool.`;

/**
 * Every tool review already carries hand-written pros and cons, and this page
 * was ignoring them — which is why it rendered ~150 words and had to be
 * noindexed. Surfacing them makes the comparison genuinely useful without
 * inventing a single new claim.
 */
const prosA: string[] = toolA.data.pros ?? [];
const consA: string[] = toolA.data.cons ?? [];
const prosB: string[] = toolB.data.pros ?? [];
const consB: string[] = toolB.data.cons ?? [];

/**
 * Staged rollout, deliberately small.
 *
 * These pages now carry ~400 words of sourced comparison instead of ~150, which
 * makes them indexable in principle. But Search Console shows indexing frozen at
 * 342 pages for 28 days with 45 already refused, so releasing all 199 at once is
 * exactly the scaled-content pattern that stalls a site further.
 *
 * Both tools carrying a hand-assigned editorial rating is the strongest available
 * proxy for "we actually reviewed these two properly". That yields ~11 pages: a
 * measurable test batch. If they index and rank, widen the gate; if they are
 * refused, nothing was risked.
 */
const isTestBatch = !!toolA.data.rating && !!toolB.data.rating;

/* ── Quick verdict strip: one tile per criterion where the data exists ── */
type Side = 0 | 1;
interface Criterion { label: string; winner: Side | null; note: string }
const updatedA = toolA.data.updatedDate ?? toolA.data.pubDate;
const updatedB = toolB.data.updatedDate ?? toolB.data.pubDate;
const fmtMonth = (d: Date) => d.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' });
const criteria: Criterion[] = [];
if (toolA.data.rating && toolB.data.rating) {
	const rA = toolA.data.rating, rB = toolB.data.rating;
	criteria.push({ label: 'Rating', winner: rA === rB ? null : rA > rB ? 0 : 1, note: `${rA.toFixed(1)} vs ${rB.toFixed(1)}` });
}
const freeA = toolA.data.pricing !== 'paid', freeB = toolB.data.pricing !== 'paid';
criteria.push(
	freeA !== freeB
		? { label: 'Free tier', winner: freeA ? 0 : 1, note: 'Has a free plan' }
		: { label: 'Free tier', winner: null, note: freeA ? 'Both have one' : 'Neither has one' },
);
if (toolA.data.verified || toolB.data.verified) {
	criteria.push({ label: 'Verified', winner: toolA.data.verified && toolB.data.verified ? null : toolA.data.verified ? 0 : 1, note: 'Tested by AI Briefs' });
}
if (toolA.data.featured || toolB.data.featured) {
	criteria.push({ label: "Editor's pick", winner: toolA.data.featured && toolB.data.featured ? null : toolA.data.featured ? 0 : 1, note: 'Featured in the directory' });
}
if (Math.abs(updatedA.valueOf() - updatedB.valueOf()) > 864e5) {
	const w: Side = updatedA > updatedB ? 0 : 1;
	criteria.push({ label: 'Fresher review', winner: w, note: `Updated ${fmtMonth(w === 0 ? updatedA : updatedB)}` });
}
const sides = [toolA, toolB];

/* ── Quick take: template prose built from real differences, worded plainly ── */
function buildQuickTake(): string[] {
	const paras: string[] = [];
	// Pros are capitalised capability phrases, so they are quoted after a colon rather
	// than spliced mid-sentence — lowercasing would mangle proper nouns and acronyms.
	const clean = (s: string) => s.trim().replace(/\.$/, '');

	if (prosA[0] && prosB[0]) {
		paras.push(`Pick ${nameA} if this matters most to you: ${clean(prosA[0])}. Pick ${nameB} if this does: ${clean(prosB[0])}.`);
	} else {
		paras.push(`${nameA} and ${nameB} are both ${subSpoken} tools, with different emphases. We have not written up detailed strengths for both yet, so start with their descriptions and the links below.`);
	}

	const label = (t: typeof toolA) => PRICING_BADGE[t.data.pricing].label.toLowerCase();
	if (toolA.data.pricing !== toolB.data.pricing) {
		paras.push(`On cost they differ: ${nameA} is ${label(toolA)}, ${nameB} is ${label(toolB)}. If budget is the deciding factor, that settles it.`);
	} else {
		paras.push(`Both are ${label(toolA)}, so price is unlikely to decide it.`);
	}

	if (toolA.data.rating && toolB.data.rating) {
		const rA = toolA.data.rating, rB = toolB.data.rating;
		if (rA === rB) paras.push(`Our editorial scores put them level at ${rA.toFixed(1)}, so the use case should decide.`);
		else {
			const [hi, lo, hiR, loR] = rA > rB ? [nameA, nameB, rA, rB] : [nameB, nameA, rB, rA];
			const gap = Math.abs(rA - rB);
			paras.push(gap <= 0.3
				? `Our editorial scores put ${hi} slightly ahead (${hiR.toFixed(1)} vs ${loR.toFixed(1)}), but the gap is small enough that ${lo} is the better choice whenever its strengths line up with your work.`
				: `Our editorial scores put ${hi} ahead (${hiR.toFixed(1)} vs ${loR.toFixed(1)}). ${lo} still wins for the specific case above.`);
		}
	} else {
		paras.push(`We have not fully rated both tools yet, so treat this as a starting point rather than a verdict.`);
	}

	if (consA[0] && consB[0]) {
		paras.push(`The trade-offs are real on both sides: ${nameA}'s biggest limit is that ${clean(consA[0]).charAt(0).toLowerCase()}${clean(consA[0]).slice(1)}; ${nameB}'s is that ${clean(consB[0]).charAt(0).toLowerCase()}${clean(consB[0]).slice(1)}.`);
	}
	return paras;
}
const quickTake = buildQuickTake();

/* ── Other comparisons in the same subcategory ────────────────────────
 * Pair slugs follow collection order (matching getStaticPaths), so each link
 * resolves to a page that exists. Only both-rated pairs are indexable; the rest
 * are linked with rel="nofollow", as before.
 */
const order = new Map(allTools.map((t, i) => [t.id, i]));
const pairSlug = (x: typeof toolA, y: typeof toolA) =>
	(order.get(x.id) ?? 0) < (order.get(y.id) ?? 0) ? `${x.id}-vs-${y.id}` : `${y.id}-vs-${x.id}`;
const peers = allTools
	.filter(t => (t.data.subcategory ?? t.data.category) === subKey && t.id !== toolA.id && t.id !== toolB.id)
	.sort((a, b) => (b.data.rating ?? 0) - (a.data.rating ?? 0))
	.slice(0, 5);
const otherComparisons = peers
	.flatMap(r => [toolA, toolB].map(base => ({
		href: `/tools/vs/${pairSlug(base, r)}/`,
		label: `${base.data.name} vs ${r.data.name}`,
		indexable: !!base.data.rating && !!r.data.rating,
	})))
	.sort((a, b) => Number(b.indexable) - Number(a.indexable));

const col = (t: typeof toolA) => ({
	slug: t.id, name: t.data.name, description: t.data.description,
	category: t.data.category, subcategory: t.data.subcategory, pricing: t.data.pricing,
	rating: t.data.rating, ratingCount: t.data.ratingCount,
	pros: t.data.pros ?? [], cons: t.data.cons ?? [],
	updated: t.data.updatedDate ?? t.data.pubDate,
	url: t.data.url, affiliateUrl: t.data.affiliateUrl, verified: t.data.verified,
});
const catIcon = CATEGORY_ICONS[toolA.data.category] ?? 'layers';
---

<Base
	title={seoTitle}
	description={seoDesc}
	noindex={!isTestBatch}
	image={isTestBatch ? ogUrl('vs', slug) : undefined}

	noNudge>
	<!-- Hero -->
	<section class="vs-hero section--tight">
		<div class="glow vs-hero__glow" aria-hidden="true"></div>
		<div class="container vs-hero__inner">
			<Breadcrumb items={[{ name: 'AI Tools', href: '/tools/' }, { name: `${nameA} vs ${nameB}` }]} />

			<p class="eyebrow vs-hero__eyebrow"><Icon name={catIcon} size={12} /> {subLabel} · Head-to-head</p>

			<div class="duel" data-reveal="scale">
				<ToolLogo slug={toolA.id} name={nameA} size={72} class="duel__logo duel__logo--a" />
				<span class="duel__vs" aria-hidden="true">vs</span>
				<ToolLogo slug={toolB.id} name={nameB} size={72} class="duel__logo duel__logo--b" />

				<h1 class="duel__title">
					<a href={`/tools/${toolA.id}/`} class="duel__name duel__name--a">{nameA}</a>
					<span class="sr-only"> vs </span>
					<a href={`/tools/${toolB.id}/`} class="duel__name duel__name--b">{nameB}</a>
				</h1>

				{sides.map((t, i) => (
					<div class:list={['duel__meta', i === 0 ? 'duel__meta--a' : 'duel__meta--b']}>
						<span class:list={['pill', `pill--${t.data.pricing}`]}>{PRICING_BADGE[t.data.pricing].label}</span>
						{t.data.rating
							? <Stars rating={t.data.rating} count={t.data.ratingCount} size={14} />
							: <span class="duel__unrated">Not yet rated</span>}
					</div>
				))}
			</div>

			<p class="lead vs-hero__lead">
				Two {subSpoken} tools compared on the same eight rows — rating, pricing, what each does best and where each falls short — so you can decide in a minute.
			</p>

			<!-- Quick verdict strip -->
			<ul role="list" class="verdict" aria-label="Quick verdict" data-stagger>
				{criteria.map((c) => (
					<li class:list={['verdict__tile', { 'verdict__tile--tie': c.winner === null }]} data-reveal>
						<span class="verdict__label">{c.label}</span>
						{c.winner === null ? (
							<span class="verdict__winner verdict__winner--tie"><Icon name="equal" size={14} /> {c.label === 'Rating' ? 'Tie' : c.note}</span>
						) : (
							<span class="verdict__winner">
								<ToolLogo slug={sides[c.winner].id} name={sides[c.winner].data.name} size={22} />
								<span class="verdict__name">{sides[c.winner].data.name}</span>
								<span class="verdict__wins">wins</span>
							</span>
						)}
						<span class="verdict__note">{c.winner === null && c.label === 'Rating' ? c.note : c.winner === null ? '' : c.note}</span>
					</li>
				))}
			</ul>

			<div class="vs-hero__share">
				<ShareBar title={`${nameA} vs ${nameB}`} text={`${nameA} vs ${nameB}: which ${subLabel} tool is better? Compared side by side on AI Briefs.`} />
			</div>
		</div>
	</section>

	<!-- Side by side -->
	<section class="section--tight">
		<div class="container vs-main">
			<div class="section-head">
				<div class="section-head__title">
					<span class="eyebrow">Side by side</span>
					<h2>The same rows for <em class="serif">both</em>.</h2>
					<p class="section-head__desc">Rows come straight from each review. A soft highlight marks the objectively better cell: higher score, cheaper tier, fresher review.</p>
				</div>
			</div>
			<div data-reveal>
				<CompareTable a={col(toolA)} b={col(toolB)} />
			</div>
		</div>
	</section>

	<!-- Quick take -->
	<section class="section--tight">
		<div class="container vs-main">
			<article class="take card card--sunk" data-reveal>
				<div class="take__head">
					<span class="pill pill--accent"><Icon name="sparkles" size={11} /> Quick take, not a full review</span>
					<span class="take__meta mono">Generated from the two reviews · {year}</span>
				</div>
				<h2 class="take__title">Which one should you <em class="serif">pick</em>?</h2>
				<div class="prose take__prose">
					{quickTake.map((p) => <p>{p}</p>)}
					<p>
						For pricing detail and limits, read the full <a href={`/tools/${toolA.id}/`}>{nameA} review</a> or the full <a href={`/tools/${toolB.id}/`}>{nameB} review</a>.
					</p>
				</div>
			</article>
		</div>
	</section>

	<!-- Other comparisons -->
	{otherComparisons.length > 0 && (
		<section class="section--tight">
			<div class="container vs-main">
				<div class="section-head">
					<div class="section-head__title">
						<span class="eyebrow">Other comparisons</span>
						<h2>More head-to-heads in {subLabel}</h2>
					</div>
					<a href="/tools/vs/" class="link-arrow">All comparisons <Icon name="arrow-right" /></a>
				</div>
				<ul role="list" class="others" data-stagger>
					{otherComparisons.map((o) => (
						<li data-reveal>
							<a href={o.href} class="chip others__chip" rel={o.indexable ? undefined : 'nofollow'}>
								<Icon name="git-compare" size={14} /> {o.label}
								{o.indexable && <span class="others__rated" title="Both tools rated"><Icon name="star" size={11} /></span>}
							</a>
						</li>
					))}
				</ul>
			</div>
		</section>
	)}

	<!-- Full reviews -->
	<section class="section--tight">
		<div class="container vs-main">
			<div class="section-head">
				<div class="section-head__title">
					<span class="eyebrow">Go deeper</span>
					<h2>Read the full reviews</h2>
				</div>
			</div>
			<div class="grid grid--2" data-stagger>
				{sides.map((t, i) => (
					<ToolCard
						slug={t.id} name={t.data.name} description={t.data.description}
						category={t.data.category} subcategory={t.data.subcategory} pricing={t.data.pricing}
						rating={t.data.rating} ratingCount={t.data.ratingCount} tags={t.data.tags}
						featured={t.data.featured} sponsored={t.data.sponsored} verified={t.data.verified}
						pubDate={t.data.pubDate} eager={i === 0}
					/>
				))}
			</div>
		</div>
	</section>

	<section class="section--tight vs-nl">
		<div class="container vs-main">
			<Newsletter variant="card" heading="Compare *smarter*." text="The tools worth switching to, the ones worth skipping, and why. Plain English, no hype." />
		</div>
	</section>
</Base>

<script>
	// GA4 outbound click on the Visit buttons, same event name as the tool page.
	if (!(document as any).__vsTrack) {
		(document as any).__vsTrack = true;
		document.addEventListener('click', (e) => {
			const a = (e.target as HTMLElement).closest<HTMLElement>('[data-track="visit"]');
			if (a) (window as any).gtag?.('event', 'visit', { tool: a.dataset.tool, from: 'vs' });
		});
	}
</script>

<style>
	.vs-main { max-width: 1040px; }

	/* ── hero ─────────────────────────────────────────────────────────── */
	.vs-hero { position: relative; overflow: hidden; padding-top: var(--s-6); border-bottom: 1px solid var(--line); }
	.vs-hero::before {
		content: ''; position: absolute; inset: 0; pointer-events: none;
		background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px);
		background-size: 48px 48px;
		mask-image: radial-gradient(ellipse 60% 55% at 50% 30%, #000 20%, transparent 100%);
		-webkit-mask-image: radial-gradient(ellipse 60% 55% at 50% 30%, #000 20%, transparent 100%);
	}
	.vs-hero__glow { top: -140px; left: 50%; width: 560px; height: 560px; transform: translateX(-50%); opacity: 0.55; }
	.vs-hero__inner { position: relative; display: grid; justify-items: center; text-align: center; gap: var(--s-6); max-width: 960px; }
	.vs-hero__inner > :global(.crumbs) { justify-self: start; text-align: left; }
	.vs-hero__eyebrow { margin-top: var(--s-2); }
	.vs-hero__eyebrow :global(.icon) { color: var(--accent); }
	.vs-hero__lead { max-width: 58ch; margin-inline: auto; text-align: center; }
	.vs-hero__share { margin-top: var(--s-2); }

	/* the duel: logos, giant serif vs, names, meta — one symmetric grid */
	.duel {
		display: grid; align-items: center; justify-items: center;
		grid-template-columns: minmax(0, 1fr) clamp(96px, 14vw, 160px) minmax(0, 1fr);
		grid-template-areas: 'la vs lb' 'na vs nb' 'ma vs mb';
		column-gap: var(--s-4); row-gap: var(--s-3);
		width: min(100%, 820px); margin-top: var(--s-2);
	}
	/* <ToolLogo> roots sit outside this component's scope, so without :global the
	   grid-area never lands and both logos fall out of the duel grid. */
	.duel :global(.duel__logo) { box-shadow: var(--shadow-md); }
	.duel :global(.duel__logo--a) { grid-area: la; }
	.duel :global(.duel__logo--b) { grid-area: lb; }
	.duel__vs {
		grid-area: vs; align-self: center;
		font-family: var(--font-serif); font-style: italic; font-size: clamp(3.5rem, 8vw, 6rem); line-height: 0.8;
		color: var(--ink); letter-spacing: -0.03em; user-select: none;
		padding-bottom: 0.1em;
	}
	.duel__vs::after { content: ''; display: block; width: 100%; height: 2px; margin-top: 10px; background: var(--accent); border-radius: 2px; opacity: 0.9; }
	.duel__title { display: contents; }
	.duel__name {
		font-size: clamp(1.5rem, 1rem + 2.4vw, 2.5rem); font-weight: 600; letter-spacing: -0.03em; line-height: 1.05;
		color: var(--ink); text-wrap: balance; transition: color var(--dur-2);
		text-decoration: underline; text-decoration-color: transparent; text-underline-offset: 0.14em; text-decoration-thickness: 2px;
	}
	.duel__name:hover { color: var(--accent-ink); text-decoration-color: var(--accent); }
	.duel__name--a { grid-area: na; } .duel__name--b { grid-area: nb; }
	.duel__meta { display: inline-flex; align-items: center; gap: var(--s-3); flex-wrap: wrap; justify-content: center; }
	.duel__meta--a { grid-area: ma; } .duel__meta--b { grid-area: mb; }
	.duel__unrated { font-size: var(--text-xs); color: var(--ink-4); }

	/* verdict strip */
	.verdict {
		display: flex; flex-wrap: wrap; justify-content: center; gap: var(--s-3);
		width: 100%; max-width: 880px;
	}
	.verdict__tile {
		flex: 1 1 150px; max-width: 220px; min-height: 96px;
		display: grid; align-content: start; gap: 6px; padding: var(--s-4);
		background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-md); text-align: left;
		box-shadow: var(--shadow-sm);
	}
	.verdict__tile--tie { background: var(--surface-2); box-shadow: none; }
	.verdict__label { font-family: var(--font-mono); font-size: 0.625rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-3); }
	.verdict__winner { display: inline-flex; align-items: center; gap: 8px; font-weight: 600; font-size: var(--text-sm); color: var(--ink); min-width: 0; }
	.verdict__winner--tie { color: var(--ink-2); font-weight: 500; }
	.verdict__winner--tie :global(.icon) { color: var(--ink-4); }
	.verdict__name { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
	.verdict__wins {
		flex-shrink: 0; display: inline-flex; align-items: center; height: 18px; padding: 0 7px; border-radius: var(--r-full);
		font-family: var(--font-mono); font-size: 0.625rem; letter-spacing: 0.1em; text-transform: uppercase; font-weight: 600;
		background: var(--accent); color: var(--on-accent);
	}
	.verdict__note { font-size: var(--text-xs); color: var(--ink-3); min-height: 1.2em; }
	.verdict__note:empty { display: none; }

	/* ── quick take ───────────────────────────────────────────────────── */
	.take { padding: clamp(1.5rem, 4vw, 2.75rem); }
	.take__head { display: flex; align-items: center; justify-content: space-between; gap: var(--s-3); flex-wrap: wrap; margin-bottom: var(--s-5); }
	.take__meta { text-transform: none; letter-spacing: 0.02em; }
	.take__title { font-size: var(--text-2xl); margin-bottom: var(--s-4); }
	.take__prose { font-size: var(--text-md); line-height: 1.7; max-width: 66ch; }
	.take__prose > * + * { margin-top: 1em; }

	/* ── other comparisons ────────────────────────────────────────────── */
	.others { display: flex; flex-wrap: wrap; gap: var(--s-2); }
	.others__chip { height: 40px; }
	.others__chip :global(.icon-git-compare) { color: var(--ink-4); }
	.others__chip:hover :global(.icon-git-compare) { color: var(--accent); }
	.others__rated { display: inline-flex; color: var(--accent); }

	.vs-nl { padding-bottom: var(--section); }

	@media (max-width: 720px) {
		.duel { grid-template-columns: minmax(0, 1fr) 72px minmax(0, 1fr); column-gap: var(--s-2); }
		.duel__vs { font-size: 3rem; }
		.duel__name { font-size: 1.35rem; }
		.verdict__tile { flex-basis: calc(50% - var(--s-3)); max-width: none; }
		.vs-hero__inner { gap: var(--s-5); }
	}
	@media (max-width: 400px) {
		.verdict__tile { flex-basis: 100%; }
	}
</style>
