---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ToolListing from '../../components/ToolListing.astro';
import Newsletter from '../../components/Newsletter.astro';
import Icon from '../../components/Icon.astro';
import { TOOL_CATEGORIES, SITE_TITLE } from '../../consts';

const allTools = await getCollection('tools');
const totalTools = allTools.length;
const totalCategories = TOOL_CATEGORIES.length;
const rated = allTools.filter((t) => t.data.rating).length;
const free = allTools.filter((t) => t.data.pricing === 'free').length;
const freeToStart = allTools.filter((t) => t.data.pricing !== 'paid').length;
const newThisMonth = allTools.filter((t) => Date.now() - t.data.pubDate.valueOf() < 30 * 864e5).length;

const title = `Toolbox — ${totalTools} AI tools, tried and filed | ${SITE_TITLE}`;
const description = `${totalTools} AI tools across ${totalCategories} categories — each one tried by a person and filed with honest pricing. Filter by price, sort by rating, save what you need.`;
---
<Base {title} {description} noNudge>
	<section class="dir-hero">
		<div class="container dir-hero__in">
			<div class="dir-hero__copy">
				<span class="eyebrow">Toolbox · {totalTools} tools, tried and filed</span>
				<h1 class="dir-hero__title">The <em class="serif">toolbox</em>.</h1>
				<p class="lead">{totalTools} AI tools across {totalCategories} categories, each tried by a person and filed with honest pricing. A reference, not a ranking — filter, sort, save what you need.</p>
				<nav class="dir-hero__links" aria-label="Quick links">
					<a class="chip" href="/tools/new/"><Icon name="sparkles" size={15} /> {newThisMonth ? 'New this month' : 'Recently added'} {newThisMonth > 0 && <span class="chip__count">{newThisMonth}</span>}</a>
					<a class="chip" href="/tools/top-rated/"><Icon name="trophy" size={15} /> Top rated <span class="chip__count">{rated}</span></a>
					<a class="chip" href="/tools/collections/"><Icon name="layers" size={15} /> Collections</a>
					<a class="chip" href="/tools/quiz/"><Icon name="compass" size={15} /> What to try</a>
				</nav>
			</div>
			<dl class="dir-hero__stats" aria-label="Toolbox at a glance">
				<div><dt class="mono">Tools</dt><dd class="tnum" data-count={totalTools}>{totalTools}</dd></div>
				<div><dt class="mono">Free to start</dt><dd class="tnum" data-count={freeToStart}>{freeToStart}</dd></div>
				<div><dt class="mono">Fully free</dt><dd class="tnum" data-count={free}>{free}</dd></div>
				<div><dt class="mono">Rated by us</dt><dd class="tnum" data-count={rated}>{rated}</dd></div>
			</dl>
		</div>
	</section>

	<ToolListing tools={allTools} allTools={allTools} showCategoryRail defaultSort="rating" />

	<Newsletter variant="band" heading="New tools land in the *brief*." text="What changed in AI, why it matters, and the tools worth trying — three minutes a day. Free, and one click to leave." />
</Base>

<style>
	.dir-hero { padding: var(--s-12) 0 var(--s-8); }
	.dir-hero__in { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: var(--s-10); align-items: end; }
	.dir-hero__copy { display: grid; gap: var(--s-5); justify-items: start; }
	.dir-hero__title { font-size: var(--text-5xl); max-width: 14ch; text-wrap: balance; }
	.dir-hero__links { display: flex; flex-wrap: wrap; gap: var(--s-2); margin-top: var(--s-1); }
	.dir-hero__links .chip :global(.icon) { color: var(--ink-3); }
	.dir-hero__links .chip:hover :global(.icon) { color: var(--accent); }
	.dir-hero__stats { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: var(--r-lg); overflow: hidden; }
	.dir-hero__stats > div { background: var(--surface); padding: var(--s-5) var(--s-6); display: grid; gap: var(--s-1); }
	.dir-hero__stats dd { font-size: var(--text-3xl); font-weight: 600; letter-spacing: -0.03em; line-height: 1; }
	@media (max-width: 960px) {
		.dir-hero { padding-top: var(--s-8); }
		.dir-hero__in { grid-template-columns: 1fr; gap: var(--s-8); }
		.dir-hero__stats { grid-template-columns: repeat(4, 1fr); }
		.dir-hero__stats > div { padding: var(--s-4); }
		.dir-hero__stats dd { font-size: var(--text-2xl); }
	}
	@media (max-width: 560px) {
		.dir-hero__stats { grid-template-columns: repeat(2, 1fr); }
	}
</style>
