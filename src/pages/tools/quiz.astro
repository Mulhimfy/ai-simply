---
/**
 * /tools/quiz/ — "What to try".
 *
 * A five-question stepper that ranks the toolbox against your answers.
 * The engine (questions, option ids, scoring matrix, `?r=` encoding) lives in
 * `src/lib/quiz.ts` and is FROZEN: old shared links must keep resolving to the
 * same top match. This file owns presentation only.
 *
 * Questions are server-rendered (real <Icon>s, works before hydration); the
 * results are built client-side from an inlined compact tool blob, so every
 * results style lives in the global stylesheet below and the Lucide glyphs the
 * script needs are harvested from a hidden <template>.
 */
import { getCollection } from 'astro:content';
import { existsSync } from 'node:fs';
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Icon from '../../components/Icon.astro';
import ShareBar from '../../components/ShareBar.astro';
import Newsletter from '../../components/Newsletter.astro';
import { TOOL_CATEGORIES, CATEGORY_ICONS, SITE_TITLE, SITE_URL } from '../../consts';
import { QUESTIONS } from '../../lib/quiz';
import type { QuestionId, QuizTool } from '../../lib/quiz';

/* ── data ─────────────────────────────────────────────────────────────── */
const allTools = await getCollection('tools');

/** Keep the inlined blob small: the card only ever shows two lines of copy. */
function short(s: string, max = 110): string {
	if (s.length <= max) return s;
	const cut = s.slice(0, max - 1);
	const sp = cut.lastIndexOf(' ');
	return `${(sp > 60 ? cut.slice(0, sp) : cut).replace(/[,;:.\s]+$/, '')}…`;
}

const tools: QuizTool[] = allTools.map((t) => {
	const d = t.data;
	return {
		slug: t.id,
		name: d.name,
		description: short(d.description),
		category: d.category,
		pricing: d.pricing,
		...(d.rating ? { rating: d.rating } : {}),
		...(d.ratingCount ? { ratingCount: d.ratingCount } : {}),
		...(d.featured ? { featured: true } : {}),
		...(d.verified ? { verified: true } : {}),
		...(d.tags.includes('api') || d.tags.includes('sdk') ? { api: true } : {}),
		...(existsSync(`public/tools/${t.id}.jpg`) ? { hasShot: true } : {}),
		...(existsSync(`public/logos/${t.id}.png`) ? {} : { noLogo: true }),
	};
});

const cats: Record<string, { name: string; icon: string }> = {};
for (const c of TOOL_CATEGORIES) cats[c.slug] = { name: c.name, icon: CATEGORY_ICONS[c.slug] ?? 'boxes' };

const payload = JSON.stringify({ tools, cats }).replace(/</g, '\\u003c');

/* ── step chrome ──────────────────────────────────────────────────────── */
const STEP_META: Record<QuestionId, { label: string; icon: string }> = {
	goal: { label: 'Your goal', icon: 'target' },
	role: { label: 'You', icon: 'user-round' },
	budget: { label: 'Budget', icon: 'wallet' },
	freq: { label: 'Rhythm', icon: 'calendar-days' },
	tech: { label: 'Comfort', icon: 'sliders-horizontal' },
};

/** Every glyph the client-side results renderer needs, harvested from a <template>. */
const CLIENT_ICONS = [...new Set([
	...Object.values(CATEGORY_ICONS),
	'star', 'badge-check', 'check', 'arrow-right', 'arrow-up-right', 'bookmark', 'sparkles',
])];

const ratedCount = allTools.filter((t) => t.data.rating).length;
const pad = (n: number) => String(n).padStart(2, '0');
---
<Base
	title={`What to try — the 5-question AI tool finder | ${SITE_TITLE}`}
	description={`Answer five quick questions and get AI tools matched to your goal, your role and your budget — scored against all ${tools.length} tools in the toolbox.`}

	noNudge>
	<script type="application/json" id="qz-data" is:inline set:html={payload} />

	<div class="qz" data-qz>
		<span class="glow qz-glow" aria-hidden="true"></span>

		<!-- ── progress rail (questions only) ───────────────────────────── -->
		<div class="qz-rail" data-qz-rail hidden>
			<div class="container container--narrow">
				<ol class="qz-rail__steps" role="list">
					{QUESTIONS.map((q) => (
						<li class="qz-rail__step" data-rail-step={q.step}>
							<span class="qz-rail__ico"><Icon name={STEP_META[q.id].icon} size={13} /></span>
							<span class="qz-rail__label">{STEP_META[q.id].label}</span>
						</li>
					))}
				</ol>
				<div class="qz-rail__track"><span class="qz-rail__fill" data-qz-fill></span></div>
			</div>
		</div>

		<!-- ── screen: start ────────────────────────────────────────────── -->
		<section class="qz-screen qz-screen--pane" data-screen="intro" aria-label="Start">
			<div class="container">
				<Breadcrumb items={[{ name: 'Toolbox', href: '/tools/' }, { name: 'What to try' }]} class="qz-crumbs" />
				<div class="qz-intro-grid">
				<div class="qz-intro" data-stagger>
					<span class="eyebrow">What to try · five questions · about a minute</span>
					<h1 class="qz-intro__title">What should you actually <em class="serif">try</em>?</h1>
					<p class="lead qz-intro__lead">
						Answer five questions and we score all {tools.length} tools in the toolbox against them —
						then hand back one to start with, two close runners-up, and the reason each one fits.
					</p>
					<div class="qz-intro__cta">
						<button type="button" class="btn btn--accent btn--lg" data-qz-start>
							Show me what to try <Icon name="arrow-right" class="icon--arrow" />
						</button>
						<a href="/tools/" class="link-arrow qz-intro__browse">Or browse all {tools.length} tools <Icon name="arrow-right" size={16} /></a>
					</div>
					<ul class="qz-facts" role="list">
						<li class="qz-fact"><Icon name="sparkles" size={15} /> {tools.length} tools scored</li>
						<li class="qz-fact"><Icon name="star" size={15} /> {ratedCount} rated by us</li>
						<li class="qz-fact"><Icon name="check" size={15} /> No sign-up, no account</li>
					</ul>
					<noscript>
						<p class="qz-noscript">This quiz needs JavaScript. <a href="/tools/" class="link-u">Browse the whole toolbox instead</a>.</p>
					</noscript>
				</div>

				<aside class="qz-plan card" data-reveal="right">
					<h2 class="qz-plan__title mono">What we ask</h2>
					<ol class="qz-plan__list" role="list">
						{QUESTIONS.map((q) => (
							<li class="qz-plan__row">
								<span class="mono qz-plan__n">{pad(q.step)}</span>
								<span class="qz-plan__ico"><Icon name={STEP_META[q.id].icon} size={16} /></span>
								<span class="qz-plan__label">{STEP_META[q.id].label}</span>
							</li>
						))}
					</ol>
					<p class="qz-plan__foot">Then: one tool to start with, two close runners-up, and five more worth a look — each with the reason it fits.</p>
				</aside>
				</div>
			</div>
		</section>

		<!-- ── screens: the five questions ──────────────────────────────── -->
		{QUESTIONS.map((q) => {
			const cols = q.options.length > 3 ? 2 : 1;
			return (
				<section class="qz-screen qz-screen--pane" data-screen={`q${q.step}`} data-step={q.step} aria-label={q.question} hidden>
					<div class="container container--narrow">
						<div class="qz-q">
							<div class="qz-q__head">
								<button type="button" class="qz-back" data-qz-back>
									<Icon name="arrow-left" size={16} /> Back
								</button>
								<span class="mono qz-q__count tnum">{pad(q.step)} <span class="qz-q__of">/ 05</span></span>
							</div>
							<h2 class="qz-q__title" tabindex="-1">{q.question}</h2>
							<p class="qz-q__sub">{q.subtitle}</p>
							<div class:list={['qz-opts', `qz-opts--${cols}`, { 'qz-opts--odd': cols === 2 && q.options.length % 2 === 1 }]} role="group" aria-label={q.question}>
								{q.options.map((o, i) => (
									<button type="button" class="qz-opt" data-qz-opt={o.id} data-qz-q={q.id} aria-pressed="false">
										<span class="qz-opt__ico"><Icon name={o.icon} size={20} /></span>
										<span class="qz-opt__txt">
											<span class="qz-opt__label">{o.label}</span>
											<span class="qz-opt__sub">{o.sub}</span>
										</span>
										<span class="qz-opt__mark">
											<kbd class="kbd qz-opt__key">{i + 1}</kbd>
											<span class="qz-opt__tick"><Icon name="check" size={13} /></span>
										</span>
									</button>
								))}
							</div>
							<p class="qz-hint mono">Pick one — or press {q.options.length > 1 ? `1–${q.options.length}` : '1'}</p>
						</div>
					</div>
				</section>
			);
		})}

		<!-- ── screen: results (body injected by the script) ────────────── -->
		<section class="qz-screen qz-res" data-screen="results" aria-label="Your matches" hidden>
			<div class="container">
				<header class="qz-res__head">
					<span class="eyebrow">Your matches</span>
					<h2 class="qz-res__title" tabindex="-1" data-qz-title></h2>
					<p class="lead qz-res__lead" data-qz-lead></p>
					<div class="qz-answers" data-qz-answers aria-label="Your answers — tap one to change it"></div>
				</header>

				<div class="qz-res__body" data-qz-body></div>

				<div class="qz-share card" data-qz-share>
					<div class="qz-share__copy">
						<h3 class="qz-share__title">Send it to <em class="serif">someone</em></h3>
						<p class="qz-share__text muted">The link carries your five answers, so it opens on exactly this result.</p>
						<ShareBar
							title="My AI tool match"
							url={`${SITE_URL}/tools/quiz/`}
							text="My AI tool match — find yours in five questions."
							label="Share"
							class="qz-share__bar"
						/>
						<div class="qz-share__actions">
							<button type="button" class="btn btn--ghost btn--sm" data-qz-retake>
								<Icon name="rotate-ccw" size={16} /> Start over
							</button>
							<a href="/tools/" class="btn btn--soft btn--sm">Browse the toolbox <Icon name="arrow-right" size={16} class="icon--arrow" /></a>
						</div>
					</div>
					<figure class="qz-share__card" data-qz-og-wrap>
						<img class="qz-share__og" data-qz-og width="1200" height="630" alt="" loading="lazy" decoding="async" />
						<figcaption class="mono">Share card preview</figcaption>
					</figure>
				</div>

				<p class="qz-note">
					Ranked from your five answers and our own ratings. Nobody pays for a place on this list.
					<a href="/rating-methodology/" class="link-u">How we rate tools</a>.
				</p>

			</div>
			<Newsletter
				variant="band"
				heading="The brief, in your *inbox*."
				text="Know what matters in AI. In three minutes. Every day — the same brief that picks the tools above."
				id="quiz-newsletter"
				class="qz-nl"
			/>
		</section>
	</div>

	<!-- Glyph bank for the client-rendered results. -->
	<template id="qz-icons">
		{CLIENT_ICONS.map((n) => <span data-ico={n}><Icon name={n} /></span>)}
	</template>
</Base>

<script>
	import {
		QUESTIONS, QUESTION_IDS, scoreTools, encodeAnswers, decodeAnswers, optionOf, matchReasons, PRICING_FILTER,
	} from '../../lib/quiz';
	import type { Answers, CompleteAnswers, QuestionId, QuizTool, ScoredTool } from '../../lib/quiz';

	type Cat = { name: string; icon: string };
	const root = document.querySelector<HTMLElement>('[data-qz]');
	const dataEl = document.getElementById('qz-data');
	if (root && dataEl) init(root, JSON.parse(dataEl.textContent || '{}'));

	function init(root: HTMLElement, DATA: { tools: QuizTool[]; cats: Record<string, Cat> }) {
		const TOOLS = DATA.tools ?? [];
		const CATS = DATA.cats ?? {};
		const PRICING_LABEL = { free: 'Free', freemium: 'Freemium', paid: 'Paid' } as const;
		const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

		/* ── glyph bank ─────────────────────────────────────────────── */
		const ICONS: Record<string, string> = {};
		document.querySelectorAll<HTMLTemplateElement>('#qz-icons').forEach((tpl) => {
			tpl.content.querySelectorAll<HTMLElement>('[data-ico]').forEach((s) => {
				const svg = s.querySelector('svg');
				if (svg) ICONS[s.dataset.ico!] = svg.innerHTML;
			});
		});
		const ico = (name: string, size = 16, cls = '') =>
			`<svg class="icon ${cls}" width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${ICONS[name] ?? ICONS.boxes ?? ''}</svg>`;
		const STAR5 = new Array(5).fill(ico('star', 13)).join('');

		/* ── screens ────────────────────────────────────────────────── */
		const screens = new Map<string, HTMLElement>();
		root.querySelectorAll<HTMLElement>('[data-screen]').forEach((s) => screens.set(s.dataset.screen!, s));
		const rail = root.querySelector<HTMLElement>('[data-qz-rail]')!;
		const fill = root.querySelector<HTMLElement>('[data-qz-fill]')!;
		let current: HTMLElement | null = screens.get('intro') ?? null;

		function paintRail(step: number) {
			rail.hidden = step < 1;
			fill.style.transform = `scaleX(${Math.max(0.02, step / QUESTIONS.length)})`;
			rail.querySelectorAll<HTMLElement>('[data-rail-step]').forEach((el) => {
				const n = Number(el.dataset.railStep);
				el.classList.toggle('is-done', n < step);
				el.classList.toggle('is-now', n === step);
			});
		}

		function goTo(name: string, dir: 'fwd' | 'back' = 'fwd') {
			const next = screens.get(name);
			if (!next || next === current) return;
			const out = current;
			const swap = () => {
				if (out) { out.hidden = true; out.classList.remove('qz-leave-l', 'qz-leave-r'); }
				next.hidden = false;
				next.classList.add(dir === 'back' ? 'qz-enter-l' : 'qz-enter-r');
				current = next;
				requestAnimationFrame(() => requestAnimationFrame(() => next.classList.remove('qz-enter-l', 'qz-enter-r')));
				const h = next.querySelector<HTMLElement>('[tabindex="-1"]');
				if (h) h.focus({ preventScroll: true });
			};
			if (out && !reduced) {
				out.classList.add(dir === 'back' ? 'qz-leave-r' : 'qz-leave-l');
				setTimeout(swap, 170);
			} else swap();
			if (scrollY > 8) scrollTo({ top: 0, behavior: reduced ? 'auto' : 'smooth' });
		}

		/* ── state ──────────────────────────────────────────────────── */
		const answers: Answers = {};
		let step = 0;            // 0 = intro, 1..5 = questions, 6 = results
		let editing = false;     // jumped back from the results to change one answer

		function showStep(n: number, dir: 'fwd' | 'back' = 'fwd') {
			step = n;
			paintRail(n > 0 && n <= QUESTIONS.length ? n : 0);
			if (n === 0) goTo('intro', dir);
			else if (n > QUESTIONS.length) goTo('results', dir);
			else {
				const q = QUESTIONS[n - 1];
				paintSelection(q.id);
				goTo(`q${q.step}`, dir);
			}
		}

		function paintSelection(qid: QuestionId) {
			root.querySelectorAll<HTMLButtonElement>(`[data-qz-q="${qid}"]`).forEach((b) => {
				const on = answers[qid] === b.dataset.qzOpt;
				b.classList.toggle('is-on', on);
				b.setAttribute('aria-pressed', String(on));
			});
		}

		function choose(qid: QuestionId, value: string) {
			answers[qid] = value;
			paintSelection(qid);
			const jump = editing && QUESTION_IDS.every((k) => answers[k]);
			editing = false;
			setTimeout(() => {
				if (jump) finish();
				else if (step >= QUESTIONS.length) finish();
				else showStep(step + 1);
			}, reduced ? 0 : 260);
		}

		/* ── results ────────────────────────────────────────────────── */
		const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
		const catOf = (slug: string): Cat => CATS[slug] ?? { name: slug, icon: 'boxes' };

		function logoHtml(t: QuizTool, size: number) {
			if (!t.noLogo) {
				const inner = Math.round(size * 0.6);
				return `<span class="logo-mark" style="--mark:${size}px" aria-hidden="true"><img src="/logos/${t.slug}.png" alt="" width="${inner}" height="${inner}" loading="lazy" decoding="async"></span>`;
			}
			let h = 0;
			for (const ch of t.slug) h = (h * 31 + ch.charCodeAt(0)) % 360;
			return `<span class="logo-mark" style="--mark:${size}px;--lm-h:${h}" aria-hidden="true"><span class="qz-letter">${esc((t.name.trim()[0] ?? '?').toUpperCase())}</span></span>`;
		}

		function ratingHtml(t: QuizTool) {
			if (!t.rating) return '<span class="qz-unrated">Not yet rated</span>';
			const pct = (Math.max(0, Math.min(5, t.rating)) / 5) * 100;
			const label = `Rated ${t.rating.toFixed(1)} out of 5${t.ratingCount ? ` from ${t.ratingCount.toLocaleString()} ratings` : ''}`;
			return `<span class="qz-rate"><span class="qz-stars" role="img" aria-label="${esc(label)}"><span class="qz-stars__row">${STAR5}</span><span class="qz-stars__row qz-stars__on" style="width:${pct}%">${STAR5}</span></span>`
				+ `<span class="qz-rate__num tnum">${t.rating.toFixed(1)}</span>`
				+ `${t.ratingCount ? `<span class="qz-rate__c tnum">(${t.ratingCount.toLocaleString()})</span>` : ''}</span>`;
		}

		const saveBtn = (t: QuizTool) =>
			`<button type="button" class="qz-save" data-save="${esc(t.slug)}" data-save-name="${esc(t.name)}" aria-pressed="false" aria-label="Save ${esc(t.name)}" title="Save">${ico('bookmark', 16)}</button>`;

		const metaRow = (t: QuizTool) => {
			const c = catOf(t.category);
			return `<span class="qz-meta"><span class="qz-meta__cat">${ico(c.icon, 13)} ${esc(c.name)}</span><span class="pill pill--${t.pricing}">${PRICING_LABEL[t.pricing]}</span></span>`;
		};

		function whyList(t: ScoredTool, a: Answers, max: number) {
			const reasons = matchReasons(t, a, catOf(t.category).name).slice(0, max);
			if (!reasons.length) return '';
			return `<ul class="qz-why" role="list">${reasons.map((r) => `<li>${ico('check', 13)} ${esc(r)}</li>`).join('')}</ul>`;
		}

		function topCard(t: ScoredTool, a: Answers) {
			const media = t.hasShot
				? `<a class="qz-top__media" href="/tools/${esc(t.slug)}/" tabindex="-1" aria-hidden="true"><img src="/tools/${esc(t.slug)}.jpg" alt="" width="1200" height="630" decoding="async"></a>`
				: '';
			return `<article class="qz-top${t.hasShot ? '' : ' qz-top--flat'}" style="--i:0">
				${media}
				<div class="qz-top__body">
					<span class="qz-tier qz-tier--best">${ico('sparkles', 12)} ${esc(t.tier)}</span>
					<div class="qz-top__id">
						${logoHtml(t, 56)}
						<span class="qz-top__names">
							<span class="qz-top__name">${esc(t.name)}${t.verified ? `<span class="qz-verified" title="Tested by AI Briefs">${ico('badge-check', 16)}</span>` : ''}</span>
							${metaRow(t)}
						</span>
						${saveBtn(t)}
					</div>
					<p class="qz-top__desc">${esc(t.description)}</p>
					${whyList(t, a, 3)}
					<div class="qz-top__foot">
						<a class="btn btn--accent" href="/tools/${esc(t.slug)}/">Open ${esc(t.name)} ${ico('arrow-right', 16, 'icon--arrow')}</a>
						${ratingHtml(t)}
					</div>
				</div>
			</article>`;
		}

		function runnerCard(t: ScoredTool, a: Answers, i: number) {
			return `<article class="qz-run" style="--i:${i + 1}">
				<a class="qz-run__link" href="/tools/${esc(t.slug)}/">
					<span class="qz-run__head">
						${logoHtml(t, 44)}
						<span class="qz-run__names">
							<span class="qz-run__name">${esc(t.name)}${t.verified ? `<span class="qz-verified" title="Tested by AI Briefs">${ico('badge-check', 15)}</span>` : ''}</span>
							${metaRow(t)}
						</span>
					</span>
					<span class="qz-tier">${esc(t.tier)}</span>
					<p class="qz-run__desc">${esc(t.description)}</p>
					${whyList(t, a, 2)}
					<span class="qz-run__foot">${ratingHtml(t)}<span class="qz-run__go">Details ${ico('arrow-right', 14)}</span></span>
				</a>
				${saveBtn(t)}
			</article>`;
		}

		function alsoRow(t: ScoredTool, i: number) {
			return `<li class="qz-alsoRow" style="--i:${i}">
				<a class="qz-alsoRow__link" href="/tools/${esc(t.slug)}/">
					${logoHtml(t, 36)}
					<span class="qz-alsoRow__txt">
						<span class="qz-alsoRow__name">${esc(t.name)}</span>
						<span class="qz-alsoRow__desc">${esc(t.description)}</span>
					</span>
					<span class="pill pill--${t.pricing}">${PRICING_LABEL[t.pricing]}</span>
					<span class="qz-alsoRow__go">${ico('arrow-up-right', 16)}</span>
				</a>
			</li>`;
		}

		function answerChips(a: CompleteAnswers) {
			return QUESTION_IDS.map((q, i) => {
				const o = optionOf(q, a[q]);
				if (!o) return '';
				return `<button type="button" class="chip qz-chip" data-qz-edit="${i + 1}">${ico(o.icon, 14)} ${esc(o.label)}</button>`;
			}).join('');
		}

		function updateShare(url: string, name: string) {
			const bar = root.querySelector<HTMLElement>('[data-qz-share] [data-share]');
			if (!bar) return;
			const text = `My AI tool match: ${name}. Find yours in five questions.`;
			bar.dataset.shareUrl = url;
			bar.dataset.shareText = text;
			bar.dataset.shareTitle = text;
			bar.querySelector('[data-copy]')?.setAttribute('data-copy', url);
			const t = encodeURIComponent(text);
			const u = encodeURIComponent(url);
			const hrefs: Record<string, string> = {
				X: `https://twitter.com/intent/tweet?text=${t}&url=${u}&via=getaibriefs`,
				LinkedIn: `https://www.linkedin.com/sharing/share-offsite/?url=${u}`,
				WhatsApp: `https://wa.me/?text=${t}%20${u}`,
				Reddit: `https://www.reddit.com/submit?url=${u}&title=${t}`,
			};
			bar.querySelectorAll<HTMLAnchorElement>('[data-share-net]').forEach((el) => {
				const h = hrefs[el.dataset.shareNet ?? ''];
				if (h) el.href = h;
			});
		}

		function renderResults(a: CompleteAnswers) {
			const results = scoreTools(TOOLS, a);
			const eligible = TOOLS.filter((t) => (PRICING_FILTER[a.budget] ?? PRICING_FILTER.any).includes(t.pricing)).length;
			const title = root.querySelector<HTMLElement>('[data-qz-title]')!;
			const lead = root.querySelector<HTMLElement>('[data-qz-lead]')!;
			const chips = root.querySelector<HTMLElement>('[data-qz-answers]')!;
			const body = root.querySelector<HTMLElement>('[data-qz-body]')!;
			const shareWrap = root.querySelector<HTMLElement>('[data-qz-share]')!;
			const ogWrap = root.querySelector<HTMLElement>('[data-qz-og-wrap]')!;
			const og = root.querySelector<HTMLImageElement>('[data-qz-og]')!;

			chips.innerHTML = answerChips(a);

			if (!results.length) {
				title.innerHTML = 'Nothing scored high enough.';
				lead.textContent = 'That combination is unusually narrow. Widen the budget, or browse the toolbox by category.';
				body.innerHTML = `<div class="qz-empty">${ico('boxes', 22)}<p>No tool cleared the bar for these answers.</p><a class="btn btn--accent" href="/tools/">Browse the toolbox ${ico('arrow-right', 16, 'icon--arrow')}</a></div>`;
				shareWrap.hidden = true;
				return null;
			}
			shareWrap.hidden = false;

			const top = results[0];
			const runners = results.slice(1, 3);
			const also = results.slice(3);

			title.innerHTML = `Start with <em class="serif">${esc(top.name)}</em>.`;
			lead.textContent = `We scored ${eligible} tools that fit your budget against your five answers. Here is the best fit, why it fits, and what else is worth opening.`;

			body.innerHTML = topCard(top, a)
				+ (runners.length
					? `<section class="qz-block"><h3 class="qz-block__title">Close behind</h3><div class="qz-runs">${runners.map((t, i) => runnerCard(t, a, i)).join('')}</div></section>`
					: '')
				+ (also.length
					? `<section class="qz-block"><h3 class="qz-block__title">Also worth a look</h3><ul class="qz-also" role="list">${also.map((t, i) => alsoRow(t, i)).join('')}</ul></section>`
					: '');

			const r = encodeAnswers(a);
			updateShare(`${location.origin}/tools/quiz/?r=${encodeURIComponent(r)}`, top.name);
			ogWrap.hidden = false;
			og.alt = `${top.name} share card`;
			og.onerror = () => { ogWrap.hidden = true; };
			og.src = `/og/tools/${top.slug}.png`;

			try { localStorage.setItem('aib-quiz-result', JSON.stringify({ slug: top.slug, name: top.name, r, at: Date.now() })); } catch {}
			paintSaved();
			(window as any).__aib?.init?.();
			return top;
		}

		function finish() {
			const a = answers as CompleteAnswers;
			const url = new URL(location.href);
			url.searchParams.set('r', encodeAnswers(a));
			history.replaceState(null, '', url.toString());
			renderResults(a);
			showStep(QUESTIONS.length + 1);
			(window as any).gtag?.('event', 'quiz_complete', { content_id: encodeAnswers(a) });
		}

		/* ── save (same contract as ToolCard; this page has no card) ─── */
		const SAVE_KEY = 'aib-saved';
		const savedMap = (): Record<string, string> => {
			try { return JSON.parse(localStorage.getItem(SAVE_KEY) || '{}'); } catch { return {}; }
		};
		function paintSaved() {
			const s = savedMap();
			document.querySelectorAll<HTMLButtonElement>('[data-save]').forEach((b) => b.setAttribute('aria-pressed', String(!!s[b.dataset.save!])));
			document.querySelectorAll<HTMLElement>('[data-saved-count]').forEach((el) => {
				const n = Object.keys(s).length;
				el.textContent = String(n);
				el.toggleAttribute('hidden', n === 0);
			});
		}
		function bindSave() {
			if ((document as any).__saveBound) { paintSaved(); return; }
			(document as any).__saveBound = true;
			document.addEventListener('click', (e) => {
				const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-save]');
				if (!b) return;
				e.preventDefault();
				const s = savedMap();
				const slug = b.dataset.save!;
				const on = !s[slug];
				if (on) s[slug] = b.dataset.saveName || slug; else delete s[slug];
				try { localStorage.setItem(SAVE_KEY, JSON.stringify(s)); } catch {}
				b.classList.remove('is-pop'); void b.offsetWidth; b.classList.add('is-pop');
				paintSaved();
				(window as any).__aib?.toast(on ? `Saved ${b.dataset.saveName} · view in My tools` : 'Removed from saved');
				document.dispatchEvent(new CustomEvent('aib:saved-change', { detail: s }));
			});
			document.addEventListener('astro:page-load', paintSaved);
			paintSaved();
		}

		/* ── events ─────────────────────────────────────────────────── */
		root.addEventListener('click', (e) => {
			const el = e.target as HTMLElement;

			if (el.closest('[data-qz-start]')) { showStep(1); return; }

			const opt = el.closest<HTMLButtonElement>('[data-qz-opt]');
			if (opt) { choose(opt.dataset.qzQ as QuestionId, opt.dataset.qzOpt!); return; }

			if (el.closest('[data-qz-back]')) { showStep(step - 1, 'back'); return; }

			const edit = el.closest<HTMLElement>('[data-qz-edit]');
			if (edit) { editing = true; showStep(Number(edit.dataset.qzEdit), 'back'); return; }

			if (el.closest('[data-qz-retake]')) {
				for (const k of QUESTION_IDS) delete answers[k];
				QUESTION_IDS.forEach(paintSelection);
				editing = false;
				history.replaceState(null, '', location.pathname);
				showStep(0, 'back');
			}
		});

		document.addEventListener('keydown', (e) => {
			if (step < 1 || step > QUESTIONS.length) return;
			if (e.metaKey || e.ctrlKey || e.altKey) return;
			const t = e.target as HTMLElement;
			if (t && /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName)) return;
			const q = QUESTIONS[step - 1];
			const n = Number(e.key);
			if (n >= 1 && n <= q.options.length) { e.preventDefault(); choose(q.id, q.options[n - 1].id); return; }
			if (e.key === 'Backspace' || e.key === 'ArrowLeft') { e.preventDefault(); showStep(step - 1, 'back'); }
		});

		/* ── boot: a shared ?r= jumps straight to the same result ───── */
		bindSave();
		const shared = decodeAnswers(new URLSearchParams(location.search).get('r'));
		if (shared) {
			Object.assign(answers, shared);
			QUESTION_IDS.forEach(paintSelection);
			renderResults(shared);
			step = QUESTIONS.length + 1;
			const intro = screens.get('intro');
			const res = screens.get('results');
			if (intro) intro.hidden = true;
			if (res) { res.hidden = false; current = res; }
			paintRail(0);
		}
	}
</script>

