---
import { getCollection } from 'astro:content';
import Base from '../../../../layouts/Base.astro';
import Breadcrumb from '../../../../components/Breadcrumb.astro';
import ToolListing from '../../../../components/ToolListing.astro';
import Newsletter from '../../../../components/Newsletter.astro';
import Icon from '../../../../components/Icon.astro';
import { TOOL_CATEGORIES, CATEGORY_ICONS, SUBCATEGORY_INTROS, SITE_TITLE } from '../../../../consts';
import { lowerKeepAI, pricingBreakdown, countBy, subcategoryFallbackIntro, plural } from '../../../../lib/tools';

export async function getStaticPaths() {
	function toSlug(str: string) {
		return str.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
	}
	const allTools = await getCollection('tools');

	const paths: { params: { cat: string; sub: string }; props: any }[] = [];

	for (const category of TOOL_CATEGORIES) {
		for (const subName of category.subcategories) {
			const subSlug = toSlug(subName);
			const tools = allTools.filter(
				(t) => t.data.category === category.slug && t.data.subcategory === subName
			);
			if (tools.length > 0) {
				paths.push({
					params: { cat: category.slug, sub: subSlug },
					props: { category, subName, tools, allTools },
				});
			}
		}
	}

	return paths;
}

const { category, subName, tools, allTools } = Astro.props;
const introText = SUBCATEGORY_INTROS[subName] ?? '';
const intro = introText || subcategoryFallbackIntro(subName, category.name, tools.length);
const isEditorial = !!introText;

const sorted = [...tools].sort((a: any, b: any) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const { free, freemium, paid } = pricingBreakdown(sorted);
const rated = sorted.filter((t: any) => t.data.rating).length;
const icon = CATEGORY_ICONS[category.slug] ?? 'boxes';

/**
 * A subcategory listing one or two tools has nothing a searcher can compare,
 * so it reads as thin content and competes with its own parent category page.
 * Below the threshold we keep the page (it is still a useful browse step) but
 * drop it from the index and the sitemap — it earns its way back in as soon
 * as a third tool is added. Kept in sync by hand with `astro.config.mjs`.
 */
const MIN_TOOLS_FOR_INDEX = 3;
const isThin = tools.length < MIN_TOOLS_FOR_INDEX;

const seoTitle = `${subName} tools — pricing, ratings and what each one does`;
const subLower = lowerKeepAI(subName);
const seoDesc = `${sorted.length} ${subLower} ${sorted.length === 1 ? 'tool' : 'tools'} in the toolbox, each filed with honest pricing, what it does well and where it falls short.`;

// neighbours for the "keep browsing" strip
const catCounts = countBy(allTools, (t: any) => t.data.category);
const others = TOOL_CATEGORIES.filter((c) => c.slug !== category.slug && catCounts[c.slug])
	.sort((a, b) => catCounts[b.slug] - catCounts[a.slug])
	.slice(0, 4);
---
<Base title={`${seoTitle} | ${SITE_TITLE}`} description={seoDesc} noindex={isThin} noNudge>
	<section class="sub-hero">
		<div class="container">
			<Breadcrumb items={[{ name: 'Toolbox', href: '/tools/' }, { name: category.name, href: `/tools/category/${category.slug}/` }, { name: subName }]} />
			<div class="sub-hero__in">
				<div class="sub-hero__copy">
					<a class="eyebrow sub-hero__cat" href={`/tools/category/${category.slug}/`}>{category.name}</a>
					<h1 class="sub-hero__title"><em class="serif">{subName.replace(/^AI /, '')}</em> tools</h1>
					<p class="lead">{intro}</p>
					<ul class="sub-hero__meta" role="list">
						<li><b class="tnum">{sorted.length}</b> {sorted.length === 1 ? 'tool' : 'tools'}</li>
						{rated > 0 && <li><Icon name="badge-check" size={14} /> <b class="tnum">{rated}</b> rated</li>}
						{free > 0 && <li><span class="pill pill--free">Free</span><b class="tnum">{free}</b></li>}
						{freemium > 0 && <li><span class="pill pill--freemium">Freemium</span><b class="tnum">{freemium}</b></li>}
						{paid > 0 && <li><span class="pill pill--paid">Paid</span><b class="tnum">{paid}</b></li>}
						{isEditorial && <li class="sub-hero__ed"><Icon name="pen-line" size={14} /> Editor's note</li>}
					</ul>
				</div>
				<div class="sub-hero__icon" aria-hidden="true"><Icon name={icon} size={30} strokeWidth={1.5} /></div>
			</div>
		</div>
	</section>

	<ToolListing tools={sorted} allTools={allTools} activeCategory={category.slug} activeSub={subName} showCategoryRail defaultSort="rating" />

	{isThin && (
		<section class="container sub-thin">
			<div class="card card--sunk sub-thin__card">
				<Icon name="inbox" size={18} />
				<p>Only {sorted.length} {sorted.length === 1 ? 'tool' : 'tools'} here so far. Browse all <a class="link-u" href={`/tools/category/${category.slug}/`}>{category.name}</a> tools, or <a class="link-u" href="/submit/">suggest one</a> that belongs.</p>
			</div>
		</section>
	)}

	{others.length > 0 && (
		<section class="section section--tight sub-others">
			<div class="container">
				<div class="section-head">
					<div class="section-head__title">
						<span class="eyebrow">Keep browsing</span>
						<h2>Other categories</h2>
					</div>
					<a href="/tools/" class="link-arrow">All {allTools.length} tools <Icon name="arrow-right" size={16} /></a>
				</div>
				<div class="sub-others__grid" data-stagger>
					{others.map((c) => (
						<a href={`/tools/category/${c.slug}/`} class="cat-tile card card--hover">
							<span class="cat-tile__icon"><Icon name={CATEGORY_ICONS[c.slug] ?? 'boxes'} size={20} /></span>
							<span class="cat-tile__name">{c.name}</span>
							<span class="cat-tile__count mono">{plural(catCounts[c.slug])}</span>
							<Icon name="arrow-up-right" size={16} class="cat-tile__arrow" />
						</a>
					))}
				</div>
			</div>
		</section>
	)}

	<Newsletter variant="band" heading="Never miss a *better* option." text="We test new tools constantly, and the ones worth your time go straight into the brief. Three minutes a day, free." />
</Base>

<style>
	.sub-hero { padding: var(--s-8) 0; }
	.sub-hero__in { display: flex; align-items: flex-start; justify-content: space-between; gap: var(--s-8); margin-top: var(--s-6); }
	.sub-hero__copy { display: grid; gap: var(--s-4); justify-items: start; max-width: 72ch; }
	.sub-hero__cat { transition: color var(--dur-2); }
	.sub-hero__cat:hover { color: var(--accent); }
	.sub-hero__title { font-size: var(--text-5xl); text-wrap: balance; }
	.sub-hero__meta { display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-5); font-size: var(--text-sm); color: var(--ink-3); }
	.sub-hero__meta li { display: inline-flex; align-items: center; gap: var(--s-2); }
	.sub-hero__meta b { color: var(--ink); font-weight: 600; }
	.sub-hero__ed { color: var(--accent-ink); }
	.sub-hero__icon { flex-shrink: 0; width: 72px; height: 72px; display: grid; place-items: center; border-radius: var(--r-lg); background: var(--surface); border: 1px solid var(--line); color: var(--accent); box-shadow: var(--shadow-sm); }

	.sub-thin { padding-bottom: var(--s-8); margin-top: calc(var(--s-8) * -1); }
	.sub-thin__card { display: flex; gap: var(--s-3); align-items: flex-start; padding: var(--s-4) var(--s-5); color: var(--ink-2); font-size: var(--text-sm); }
	.sub-thin__card :global(.icon) { flex-shrink: 0; color: var(--ink-3); margin-top: 2px; }

	.sub-others { border-top: 1px solid var(--line); }
	.sub-others__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--s-4); }
	.cat-tile { display: grid; grid-template-columns: auto 1fr auto; grid-template-areas: 'icon name arrow' 'icon count arrow'; column-gap: var(--s-4); row-gap: 2px; align-items: center; padding: var(--s-4) var(--s-5); color: inherit; }
	.cat-tile__icon { grid-area: icon; width: 40px; height: 40px; display: grid; place-items: center; border-radius: var(--r-sm); background: var(--surface-2); color: var(--ink-2); transition: color var(--dur-2), background-color var(--dur-2); }
	.cat-tile:hover .cat-tile__icon { color: var(--accent); background: var(--accent-soft); }
	.cat-tile__name { grid-area: name; font-weight: 600; font-size: var(--text-sm); letter-spacing: -0.01em; }
	.cat-tile__count { grid-area: count; text-transform: none; letter-spacing: 0; }
	.cat-tile :global(.cat-tile__arrow) { grid-area: arrow; color: var(--ink-4); opacity: 0; transform: translate(-4px, 4px); transition: opacity var(--dur-2), transform var(--dur-2) var(--ease-out), color var(--dur-2); }
	.cat-tile:hover :global(.cat-tile__arrow) { opacity: 1; transform: none; color: var(--ink); }

	@media (max-width: 960px) { .sub-others__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
	@media (max-width: 640px) {
		.sub-hero__icon { display: none; }
		.sub-hero__title { font-size: var(--text-4xl); }
		.sub-others__grid { grid-template-columns: 1fr; }
	}
</style>
