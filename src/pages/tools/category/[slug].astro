---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import ToolListing from '../../../components/ToolListing.astro';
import Newsletter from '../../../components/Newsletter.astro';
import Icon from '../../../components/Icon.astro';
import { TOOL_CATEGORIES, CATEGORY_ICONS, SITE_URL } from '../../../consts';
import { categoryLabel, lowerKeepAI, pricingBreakdown, countBy, subcategoriesWithTools, plural } from '../../../lib/tools';

export async function getStaticPaths() {
	return TOOL_CATEGORIES.map((cat) => ({
		params: { slug: cat.slug },
		props: { category: cat },
	}));
}

const { category } = Astro.props;

const allTools = await getCollection('tools');
const tools = allTools
	.filter((t) => t.data.category === category.slug)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const { free, freemium, paid } = pricingBreakdown(tools);
const rated = tools.filter((t) => t.data.rating).length;
const subs = subcategoriesWithTools(allTools, category.slug);
const icon = CATEGORY_ICONS[category.slug] ?? 'boxes';

/**
 * Category names already start with "AI" ("AI Coding"), so any `${name} AI tools`
 * pattern doubles the initialism, and "Others" reads badly. Normalise once and reuse.
 */
const label = categoryLabel(category.name);
const seoTitle = `${label} tools — pricing, ratings and what each one does`;
const labelLower = lowerKeepAI(label);
const seoDesc = `${category.description}. ${tools.length} ${labelLower} tools in the toolbox, each filed with honest pricing, what it does well and where it falls short.`;

// The main browse hubs carry the list of tools they show plus their place in the hierarchy
// (BreadcrumbList comes from <Breadcrumb>).
const itemListSchema = {
	'@context': 'https://schema.org',
	'@type': 'ItemList',
	name: `${label} tools`,
	description: category.description,
	numberOfItems: tools.length,
	itemListElement: tools.map((t, i) => ({
		'@type': 'ListItem',
		position: i + 1,
		name: t.data.name,
		url: `${SITE_URL}/tools/${t.id}/`,
	})),
};

// "Explore other categories" — the biggest neighbours first
const catCounts = countBy(allTools, (t) => t.data.category);
const others = TOOL_CATEGORIES.filter((c) => c.slug !== category.slug && catCounts[c.slug])
	.sort((a, b) => catCounts[b.slug] - catCounts[a.slug])
	.slice(0, 8);
---
<Base title={seoTitle} description={seoDesc} noNudge>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
	</Fragment>

	<section class="cat-hero">
		<div class="container">
			<Breadcrumb items={[{ name: 'Toolbox', href: '/tools/' }, { name: category.name }]} />
			<div class="cat-hero__in">
				<div class="cat-hero__icon" aria-hidden="true"><Icon name={icon} size={34} strokeWidth={1.5} /></div>
				<div class="cat-hero__copy">
					<h1 class="cat-hero__title"><em class="serif">{label.replace(/^AI /, '')}</em> tools</h1>
					<p class="lead">{category.description}. {tools.length} {tools.length === 1 ? 'tool' : 'tools'} in the toolbox{rated ? `, ${rated} rated` : ''} — each tried by a person and filed with honest pricing.</p>
					<ul class="cat-hero__meta" role="list">
						<li><b class="tnum">{tools.length}</b> {tools.length === 1 ? 'tool' : 'tools'}</li>
						{free > 0 && <li><span class="pill pill--free">Free</span><b class="tnum">{free}</b></li>}
						{freemium > 0 && <li><span class="pill pill--freemium">Freemium</span><b class="tnum">{freemium}</b></li>}
						{paid > 0 && <li><span class="pill pill--paid">Paid</span><b class="tnum">{paid}</b></li>}
						{subs.length > 0 && <li><b class="tnum">{subs.length}</b> {subs.length === 1 ? 'subcategory' : 'subcategories'}</li>}
					</ul>
				</div>
			</div>
		</div>
	</section>

	<ToolListing tools={tools} allTools={allTools} activeCategory={category.slug} showCategoryRail defaultSort="rating" />

	{others.length > 0 && (
		<section class="section section--tight cat-others">
			<div class="container">
				<div class="section-head">
					<div class="section-head__title">
						<span class="eyebrow">Keep browsing</span>
						<h2>Explore other categories</h2>
					</div>
					<a href="/tools/" class="link-arrow">All {allTools.length} tools <Icon name="arrow-right" size={16} /></a>
				</div>
				<div class="cat-others__grid" data-stagger>
					{others.map((c) => (
						<a href={`/tools/category/${c.slug}/`} class="cat-tile card card--hover">
							<span class="cat-tile__icon"><Icon name={CATEGORY_ICONS[c.slug] ?? 'boxes'} size={20} /></span>
							<span class="cat-tile__name">{c.name}</span>
							<span class="cat-tile__count mono">{plural(catCounts[c.slug])}</span>
							<Icon name="arrow-up-right" size={16} class="cat-tile__arrow" />
						</a>
					))}
				</div>
			</div>
		</section>
	)}

	<Newsletter variant="band" heading={`New ${label.replace(/^AI /, 'AI ')} tools, in your *inbox*.`} text="The tools worth trying, honest ratings and what changed in AI — all of it goes in the brief. Three minutes a day, free." />
</Base>

<style>
	.cat-hero { padding: var(--s-8) 0 var(--s-8); }
	.cat-hero__in { display: flex; align-items: flex-start; gap: var(--s-6); margin-top: var(--s-6); }
	.cat-hero__icon { flex-shrink: 0; width: 84px; height: 84px; display: grid; place-items: center; border-radius: var(--r-lg); background: var(--surface); border: 1px solid var(--line); color: var(--accent); box-shadow: var(--shadow-sm); }
	.cat-hero__copy { display: grid; gap: var(--s-4); min-width: 0; }
	.cat-hero__title { font-size: var(--text-5xl); text-wrap: balance; }
	.cat-hero__meta { display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-5); font-size: var(--text-sm); color: var(--ink-3); }
	.cat-hero__meta li { display: inline-flex; align-items: center; gap: var(--s-2); }
	.cat-hero__meta b { color: var(--ink); font-weight: 600; }

	.cat-others { border-top: 1px solid var(--line); }
	.cat-others__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--s-4); }
	.cat-tile { display: grid; grid-template-columns: auto 1fr auto; grid-template-areas: 'icon name arrow' 'icon count arrow'; column-gap: var(--s-4); row-gap: 2px; align-items: center; padding: var(--s-4) var(--s-5); color: inherit; }
	.cat-tile__icon { grid-area: icon; width: 40px; height: 40px; display: grid; place-items: center; border-radius: var(--r-sm); background: var(--surface-2); color: var(--ink-2); transition: color var(--dur-2), background-color var(--dur-2); }
	.cat-tile:hover .cat-tile__icon { color: var(--accent); background: var(--accent-soft); }
	.cat-tile__name { grid-area: name; font-weight: 600; font-size: var(--text-sm); letter-spacing: -0.01em; }
	.cat-tile__count { grid-area: count; text-transform: none; letter-spacing: 0; }
	.cat-tile :global(.cat-tile__arrow) { grid-area: arrow; color: var(--ink-4); opacity: 0; transform: translate(-4px, 4px); transition: opacity var(--dur-2), transform var(--dur-2) var(--ease-out), color var(--dur-2); }
	.cat-tile:hover :global(.cat-tile__arrow) { opacity: 1; transform: none; color: var(--ink); }

	@media (max-width: 960px) { .cat-others__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
	@media (max-width: 640px) {
		.cat-hero__in { flex-direction: column; gap: var(--s-4); }
		.cat-hero__icon { width: 64px; height: 64px; }
		.cat-hero__title { font-size: var(--text-4xl); }
		.cat-others__grid { grid-template-columns: 1fr; }
	}
</style>
