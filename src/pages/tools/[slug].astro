---
/**
 * Tool review page. Preserves: SoftwareApplication+Product+editorial Review JSON-LD,
 * BreadcrumbList (via <Breadcrumb>), affiliate rel="sponsored", data-track="visit" GA event,
 * owner-claim link, alternatives link (nofollow), head-to-head links only to indexable vs pages.
 */
import { existsSync } from 'node:fs';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ToolHero from '../../components/ToolHero.astro';
import Toc from '../../components/Toc.astro';
import ProsCons from '../../components/ProsCons.astro';
import ToolCard from '../../components/ToolCard.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import ShareBar from '../../components/ShareBar.astro';
import Newsletter from '../../components/Newsletter.astro';
import Stars from '../../components/Stars.astro';
import Icon from '../../components/Icon.astro';
import { TOOL_CATEGORIES, CATEGORY_ICONS, SITE_TITLE, SITE_URL } from '../../consts';
import { RATING_CRITERIA } from '../../data/rating-criteria';
import { relatedArticlesForTool } from '../../lib/related-articles';
import { ogUrl } from '../../og/url';

type Tool = CollectionEntry<'tools'>;

export async function getStaticPaths() {
	const tools = await getCollection('tools');
	return tools.map((tool) => ({ params: { slug: tool.id }, props: { tool } }));
}

const { tool } = Astro.props as { tool: Tool };
const d = tool.data;
const { Content, headings } = await render(tool);

/* Same slug rule as tools/category/[cat]/[sub].astro */
function toSlug(str: string) {
	return str.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
}

/** "AI Chatbot" → "AI chatbot": keep initialisms, lowercase the rest, so generated
 *  sentences read like English instead of a database field. */
const speak = (str: string) => str.split(' ').map((w) => (/^[A-Z0-9.]{2,}$/.test(w) ? w : w.toLowerCase())).join(' ');

const category = TOOL_CATEGORIES.find((c) => c.slug === d.category);
const subHref = d.subcategory && category?.subcategories.includes(d.subcategory)
	? `/tools/category/${category.slug}/${toSlug(d.subcategory)}/`
	: undefined;
const visitUrl = d.affiliateUrl ?? d.url;
const isAffiliate = !!d.affiliateUrl;
const visitRel = `noopener noreferrer${isAffiliate ? ' sponsored' : ''}`;
const shot = existsSync(`public/tools/${tool.id}.jpg`) ? `/tools/${tool.id}.jpg` : null;
const logo = existsSync(`public/logos/${tool.id}.png`) ? `/logos/${tool.id}.png` : null;
const pageUrl = `${SITE_URL}/tools/${tool.id}/`;
const pricingLabel = { free: 'Free', freemium: 'Freemium', paid: 'Paid' }[d.pricing];
const lastUpdated = d.updatedDate ?? d.pubDate;

const allTools = await getCollection('tools');
const others = allTools.filter((t) => t.id !== tool.id);
const byRank = (a: Tool, b: Tool) =>
	(b.data.rating ?? 0) - (a.data.rating ?? 0) ||
	Number(b.data.featured) - Number(a.data.featured) ||
	b.data.pubDate.valueOf() - a.data.pubDate.valueOf();

/* Alternatives: same subcategory first (top by rating), topped up from the category. */
const sameSub = d.subcategory ? others.filter((t) => t.data.subcategory === d.subcategory).sort(byRank) : [];
const sameCat = others.filter((t) => t.data.category === d.category).sort(byRank);
const alternatives = [...sameSub, ...sameCat.filter((t) => !sameSub.includes(t))].slice(0, 4);
const altIds = new Set(alternatives.map((t) => t.id));
/* Alternatives page exists only when the tool has ≥ 2 category peers (mirrors its getStaticPaths). */
const hasAlternativesPage = sameCat.length >= 2;

/* "More in {category}": 4 cards, avoiding the ones already shown as alternatives when possible.
 * ToolCard drops the media block when a tool has no screenshot, so a mixed row reads as
 * broken — prefer tools that have one, and fall back to a uniform text-only row if not. */
const hasShot = (t: Tool) => existsSync(`public/tools/${t.id}.jpg`);
const morePool = sameCat.filter((t) => !altIds.has(t.id));
const moreSource = morePool.length >= 4 ? morePool : sameCat;
const moreIn = [...moreSource.filter(hasShot), ...moreSource.filter((t) => !hasShot(t))].slice(0, 4);
const moreMedia = moreIn.every(hasShot);

/**
 * Editorial briefs that mention this tool (src/data/briefs/<date>.json → items[].tools).
 * Item anchors follow the same id rule as src/lib/brief.ts (slugify of the headline),
 * so each link lands on `/news/<date>/#<item id>`. Renders nothing when there is no match.
 */
type BriefItemFile = { headline: string; tools?: string[] };
type BriefFile = { date: string; items?: BriefItemFile[] };
const briefSlug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '').slice(0, 60);
const briefModules = import.meta.glob<{ default?: BriefFile } & BriefFile>('../../data/briefs/*.json', { eager: true });
const briefMentions = Object.values(briefModules)
	.map((m) => (m.default ?? m) as BriefFile)
	.flatMap((b) => (b.items ?? [])
		.filter((it) => (it.tools ?? []).includes(tool.id))
		.map((it) => ({ date: b.date, headline: it.headline, id: briefSlug(it.headline) })))
	.sort((x, y) => y.date.localeCompare(x.date))
	.slice(0, 3);
const briefDate = (iso: string) => new Date(`${iso}T00:00:00Z`).toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });

const allPosts = await getCollection('blog');
const relatedPosts = relatedArticlesForTool(tool, allPosts, 3);

/**
 * Comparison pages are generated for every same-subcategory pair, but only the
 * rated ones are indexable (see src/pages/tools/vs/[slug].astro `isTestBatch`).
 * Link to those so they are reachable by crawl rather than sitemap alone.
 */
const sortedIds = allTools.map((t) => t.id);
const headToHead = d.rating
	? others
		.filter((t) => !!t.data.rating && (t.data.subcategory ?? t.data.category) === (d.subcategory ?? d.category))
		.map((t) => {
			// Pair slug order follows collection order, matching getStaticPaths.
			const [first, second] = sortedIds.indexOf(tool.id) < sortedIds.indexOf(t.id) ? [tool.id, t.id] : [t.id, tool.id];
			return { name: t.data.name, slug: t.id, href: `/tools/vs/${first}-vs-${second}/` };
		})
	: [];

/* SEO strings */
const year = lastUpdated.getFullYear();
const seoTitle = `${d.name} Review (${year}): Features, Pricing & Alternatives`;
const subcatLabel = d.subcategory ?? category?.name ?? 'AI Tool';
const seoDescription = `${d.name} is a ${pricingLabel.toLowerCase()} ${speak(subcatLabel)}. ${d.description} See features, pricing, pros & cons.`;

/* Structured data — SoftwareApplication + Product with an editorial Review */
function notesList(items?: string[]) {
	if (!items?.length) return undefined;
	return { '@type': 'ItemList', itemListElement: items.map((name, i) => ({ '@type': 'ListItem', position: i + 1, name })) };
}
const positiveNotes = notesList(d.pros);
const negativeNotes = notesList(d.cons);
const rating = d.rating;

/**
 * Our scores are editorial (see /rating-methodology/), not visitor-submitted,
 * so they belong in a `Review` authored by AI Briefs — not `aggregateRating`,
 * which Google reserves for ratings a site actually collects from users.
 */
const editorialReview = (rating || positiveNotes || negativeNotes) ? {
	'@type': 'Review',
	...(rating && { reviewRating: { '@type': 'Rating', ratingValue: rating.toFixed(1), bestRating: '5', worstRating: '1' } }),
	author: { '@type': 'Organization', name: SITE_TITLE, url: SITE_URL },
	publisher: { '@type': 'Organization', name: SITE_TITLE, url: SITE_URL },
	datePublished: d.pubDate.toISOString(),
	...(d.updatedDate && { dateModified: d.updatedDate.toISOString() }),
	url: pageUrl,
	...(positiveNotes && { positiveNotes }),
	...(negativeNotes && { negativeNotes }),
} : null;

/**
 * Offer: free and freemium tiers genuinely start at 0. Paid tools have no single
 * list price we can vouch for, so we omit `price` (never invent one) and mark the
 * offer category instead.
 */
const offer = {
	'@type': 'Offer',
	priceCurrency: 'USD',
	...(d.pricing === 'paid' ? { category: 'paid' } : { price: '0' }),
	availability: 'https://schema.org/OnlineOnly',
	url: pageUrl,
};

const softwareSchema: Record<string, unknown> = {
	'@context': 'https://schema.org',
	// Dual-typed so the page is eligible for Product review snippets as well as software metadata.
	'@type': ['SoftwareApplication', 'Product'],
	name: d.name,
	description: d.description,
	url: d.url,
	...(shot && { image: `${SITE_URL}${shot}` }),
	applicationCategory: 'AIApplication',
	operatingSystem: 'Web',
	inLanguage: 'en-US',
	datePublished: d.pubDate.toISOString(),
	...(d.updatedDate && { dateModified: d.updatedDate.toISOString() }),
	offers: offer,
	...(editorialReview && { review: editorialReview }),
};

const crumbs = [
	{ name: 'AI Tools', href: '/tools/' },
	...(category ? [{ name: category.name, href: `/tools/category/${category.slug}/` }] : []),
	{ name: d.name, href: `/tools/${tool.id}/` },
];
const updatedShort = lastUpdated.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
const cardProps = (t: Tool) => ({
	slug: t.id, name: t.data.name, description: t.data.description, category: t.data.category, subcategory: t.data.subcategory,
	pricing: t.data.pricing, rating: t.data.rating, ratingCount: t.data.ratingCount, tags: t.data.tags, featured: t.data.featured,
	sponsored: t.data.sponsored, verified: t.data.verified, pubDate: t.data.pubDate,
});
---
<Base
	title={seoTitle}
	description={seoDescription}
	image={ogUrl('tool', tool.id)}
	type="website"
	publishDate={d.pubDate}
	updatedDate={d.updatedDate}
	bodyClass="has-cta-bar"

	noNudge>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
	</Fragment>

	<ToolHero
		slug={tool.id} name={d.name} description={d.description}
		category={category && { slug: category.slug, name: category.name }}
		subcategory={d.subcategory} subHref={subHref}
		pricing={d.pricing} rating={d.rating} ratingCount={d.ratingCount}
		verified={d.verified} featured={d.featured} sponsored={d.sponsored}
		updated={lastUpdated} url={d.url} visitUrl={visitUrl} isAffiliate={isAffiliate}
		shot={shot} logo={logo} shareUrl={pageUrl} crumbs={crumbs}
	/>

	<div class="container tp">
		<aside class="tp__rail" aria-label="Table of contents">
			<div class="tp__rail-sticky">
				<Toc headings={headings} />
			</div>
		</aside>

		<article class="tp__body">
			{headings.some((h) => h.depth === 2) && (
				<details class="tp__toc-mobile card">
					<summary><Icon name="list" size={16} /> On this page <Icon name="chevron-down" size={16} class="tp__toc-chev" /></summary>
					<Toc headings={headings} title="" backToTop={false} />
				</details>
			)}
			<div class="prose tp__prose">
				<Content />
			</div>

			{rating && (
				<aside class="tp__how card card--sunk" aria-label="How we rate">
					<div class="tp__how-head">
						<span class="meta">Editorial score</span>
						<span class="tp__how-score"><Stars rating={rating} size={14} /></span>
					</div>
					<p class="tp__how-text">Scored on five weighted criteria after hands-on testing. Paid listings get no scoring advantage.</p>
					<ul role="list" class="tp__how-list">
						{RATING_CRITERIA.map((c) => (
							<li><Icon name={c.icon} size={14} /><span>{c.name}</span><span class="tnum muted">{c.weight}%</span></li>
						))}
					</ul>
					<a href="/rating-methodology/" class="link-arrow">How we rate <Icon name="arrow-right" /></a>
				</aside>
			)}
		</article>

		<aside class="tp__side" data-sticky-side>
			<!-- At a glance -->
			<section class="card card--pad glance" aria-label="At a glance">
				<h2 class="h4 glance__title">At a glance</h2>
				<dl class="glance__list">
					<div class="glance__row">
						<dt>Category</dt>
						<dd>{category ? <a href={`/tools/category/${category.slug}/`} class="glance__link"><Icon name={CATEGORY_ICONS[category.slug] ?? 'boxes'} size={14} /> {category.name}</a> : d.category}</dd>
					</div>
					{d.subcategory && (
						<div class="glance__row">
							<dt>Type</dt>
							<dd>{subHref ? <a href={subHref} class="glance__link">{d.subcategory}</a> : d.subcategory}</dd>
						</div>
					)}
					<div class="glance__row">
						<dt>Pricing</dt>
						<dd><span class:list={['pill', `pill--${d.pricing}`]}>{pricingLabel}</span></dd>
					</div>
					<div class="glance__row">
						<dt>Rating</dt>
						<dd>{rating ? <Stars rating={rating} size={13} /> : <span class="muted">Not yet rated</span>}</dd>
					</div>
					{d.pros?.[0] && (
						<div class="glance__row glance__row--wrap">
							<dt>Best for</dt>
							<dd>{d.pros[0]}</dd>
						</div>
					)}
					<div class="glance__row">
						<dt>Updated</dt>
						<dd><time datetime={lastUpdated.toISOString()}>{updatedShort}</time></dd>
					</div>
				</dl>
				<div class="glance__actions">
					<a href={visitUrl} target="_blank" rel={visitRel} class="btn btn--accent w-full" data-track="visit">Visit website <Icon name="arrow-up-right" class="icon--arrow" /></a>
					{hasAlternativesPage && (
						<a href={`/tools/alternatives/${tool.id}/`} rel="nofollow" class="btn btn--ghost w-full">See all alternatives</a>
					)}
				</div>
				<a href={`/contact/?subject=claim&tool=${encodeURIComponent(d.name)}`} rel="nofollow" class="glance__claim">
					<Icon name="badge-check" size={13} /> Are you the owner of this tool?
				</a>
			</section>

			{briefMentions.length > 0 && (
				<section class="card card--pad news" aria-label="In the brief">
					<span class="eyebrow">In the brief</span>
					<p class="news__sub muted">{d.name} came up in {briefMentions.length === 1 ? 'a recent daily brief' : `${briefMentions.length} recent daily briefs`}.</p>
					<ul role="list" class="news__list">
						{briefMentions.map((m) => (
							<li>
								<a href={`/news/${m.date}/#${m.id}`} class="news__item">
									<time class="news__date mono" datetime={m.date}>{briefDate(m.date)}</time>
									<span class="news__headline">{m.headline}</span>
									<Icon name="arrow-right" size={14} class="news__arrow" />
								</a>
							</li>
						))}
					</ul>
					<a href="/news/" class="link-arrow news__all">Today's brief <Icon name="arrow-right" /></a>
				</section>
			)}

			<ProsCons pros={d.pros} cons={d.cons} />

			{alternatives.length > 0 && (
				<section class="card card--pad alts" aria-label="Alternatives">
					<div class="between alts__head">
						<h2 class="h4">Alternatives</h2>
						{hasAlternativesPage && <a href={`/tools/alternatives/${tool.id}/`} rel="nofollow" class="link-arrow alts__all">See all <Icon name="arrow-right" /></a>}
					</div>
					<p class="alts__sub muted">{sameSub.length ? `Other ${d.subcategory} tools, ranked.` : `Other ${category?.name ?? 'AI'} tools, ranked.`}</p>
					<div class="alts__list">
						{alternatives.map((t) => <ToolCard {...cardProps(t)} variant="mini" />)}
					</div>
				</section>
			)}

			{headToHead.length > 0 && (
				<section class="card card--pad h2h" aria-label="Head-to-head comparisons">
					<h2 class="h4">Compare</h2>
					<p class="alts__sub muted">Side-by-side with other rated {speak(d.subcategory ?? category?.name ?? 'AI')} tools.</p>
					<div class="h2h__list">
						{headToHead.map((h) => (
							<a href={h.href} class="chip h2h__chip"><Icon name="git-compare" size={13} /> {d.name} vs {h.name}</a>
						))}
					</div>
				</section>
			)}

			<Newsletter variant="card" heading="The tools worth *trying*." text="What changed in AI, why it matters, and what to do about it — in the brief, three minutes a day." id="newsletter-tool" />
		</aside>
	</div>

	{moreIn.length > 0 && (
		<section class="section section--tight tp__more">
			<div class="container">
				<div class="section-head">
					<div class="section-head__title">
						<span class="eyebrow">Same category</span>
						<h2>More in {category?.name ?? 'AI tools'}</h2>
					</div>
					{category && <a href={`/tools/category/${category.slug}/`} class="link-arrow">All {category.name.replace(/^AI /, '')} tools <Icon name="arrow-right" /></a>}
				</div>
				<div class="tp__grid" data-stagger>
					{moreIn.map((t) => <ToolCard {...cardProps(t)} variant="grid" media={moreMedia} />)}
				</div>
			</div>
		</section>
	)}

	{relatedPosts.length > 0 && (
		<section class="section section--tight tp__articles">
			<div class="container">
				<div class="section-head">
					<div class="section-head__title">
						<span class="eyebrow">Go deeper</span>
						<h2>Related articles</h2>
					</div>
					<a href="/blog/" class="link-arrow">All articles <Icon name="arrow-right" /></a>
				</div>
				<div class="tp__grid tp__grid--3" data-stagger>
					{relatedPosts.map((p) => (
						<ArticleCard
							slug={p.id} title={p.data.title} description={p.data.description} category={p.data.category}
							pubDate={p.data.pubDate} readingTime={p.data.readingTime} heroImage={p.data.heroImage} variant="grid"
						/>
					))}
				</div>
			</div>
		</section>
	)}

	<section class="section section--tight tp__nl">
		<div class="container">
			<Newsletter variant="band" heading="New tools land in the *brief*." text="What changed in AI, why it matters, and the tools worth trying — three minutes a day, in plain English." id="newsletter-tool-band" />
		</div>
	</section>

	<div class="container tp__share-wrap">
		<div class="tp__share">
			<div class="tp__share-copy">
				<span class="meta">Share this review</span>
				<p>Know someone weighing up {d.name}? Send them this page.</p>
			</div>
			<ShareBar title={`${d.name} review — ${SITE_TITLE}`} url={pageUrl} />
		</div>
	</div>
</Base>

<script>
	/**
	 * Sticky sidebar that is taller than the viewport: stick to the bottom edge
	 * instead of clipping (top = viewport height − sidebar height).
	 */
	function stickySide() {
		const side = document.querySelector<HTMLElement>('[data-sticky-side]');
		if (!side) return;
		const apply = () => {
			const header = document.querySelector<HTMLElement>('.site-header');
			const gap = (header?.offsetHeight ?? 64) + 24;
			const h = side.offsetHeight;
			const vh = window.innerHeight;
			side.style.top = h + gap + 24 > vh ? `${Math.min(gap, vh - h - 24)}px` : `${gap}px`;
		};
		apply();
		addEventListener('resize', apply, { passive: true });
		if ('ResizeObserver' in window) new ResizeObserver(apply).observe(side);
	}
	stickySide();
	document.addEventListener('astro:page-load', stickySide);
</script>

<style is:global>
	/* room for the mobile sticky CTA bar; lift the compare tray and toasts above it */
	@media (max-width: 860px) {
		body.has-cta-bar { padding-bottom: 76px; }
		body.has-cta-bar #compare-tray { bottom: 86px; }
		body.has-cta-bar #toast-host { bottom: 92px; }
	}
</style>

<style>
	.tp {
		display: grid; grid-template-columns: 184px minmax(0, 1fr) 320px; column-gap: var(--s-12);
		padding-block: var(--s-12) var(--s-16); align-items: start;
	}
	.tp__rail { display: block; }
	.tp__rail-sticky { position: sticky; top: calc(var(--header-h, 64px) + 32px); }
	.tp__body { min-width: 0; display: grid; gap: var(--s-10); }
	.tp__prose { max-width: none; }
	.tp__prose :global(h2:first-child) { margin-top: 0; }
	.tp__toc-mobile { display: none; padding: 0; overflow: hidden; }
	.tp__toc-mobile summary { display: flex; align-items: center; gap: 8px; padding: 14px 18px; font-weight: 600; font-size: var(--text-sm); cursor: pointer; list-style: none; }
	.tp__toc-mobile summary::-webkit-details-marker { display: none; }
	/* <Icon> roots never carry the parent scope — :global or the rule is dead. */
	.tp__toc-mobile summary :global(.tp__toc-chev) { margin-left: auto; transition: transform var(--dur-2); }
	.tp__toc-mobile[open] summary :global(.tp__toc-chev) { transform: rotate(180deg); }
	.tp__toc-mobile > :global(.toc) { padding: 4px 18px 16px; border-top: 1px solid var(--line); }
	.tp__toc-mobile > :global(.toc .toc__title) { display: none; }

	/* how we rate */
	.tp__how { padding: var(--s-5) var(--s-6); display: grid; gap: var(--s-3); }
	.tp__how-head { display: flex; align-items: center; justify-content: space-between; gap: var(--s-4); }
	.tp__how-text { font-size: var(--text-sm); color: var(--ink-2); max-width: 60ch; }
	.tp__how-list { display: flex; flex-wrap: wrap; gap: 6px 18px; font-size: var(--text-xs); color: var(--ink-2); }
	.tp__how-list li { display: inline-flex; align-items: center; gap: 6px; }
	.tp__how-list li :global(.icon) { color: var(--ink-3); }
	.tp__how .link-arrow { font-size: var(--text-sm); }

	/* sidebar */
	.tp__side { display: grid; gap: var(--s-5); position: sticky; top: calc(var(--header-h, 64px) + 24px); }
	.glance__title { margin-bottom: var(--s-4); }
	.glance__list { display: grid; }
	.glance__row { display: flex; align-items: center; justify-content: space-between; gap: var(--s-4); padding: 10px 0; border-top: 1px solid var(--line); font-size: var(--text-sm); }
	.glance__row--wrap { flex-direction: column; align-items: flex-start; gap: 4px; }
	.glance__row dt { color: var(--ink-3); white-space: nowrap; }
	.glance__row dd { color: var(--ink); font-weight: 500; text-align: right; min-width: 0; }
	.glance__row--wrap dd { text-align: left; font-weight: 500; line-height: 1.45; }
	.glance__link { display: inline-flex; align-items: center; gap: 6px; color: var(--ink); text-decoration: underline; text-decoration-color: transparent; text-underline-offset: 3px; transition: text-decoration-color var(--dur-2); }
	.glance__link:hover { text-decoration-color: var(--line-strong); }
	.glance__actions { display: grid; gap: 8px; margin-top: var(--s-4); }
	.glance__claim { display: inline-flex; align-items: center; gap: 6px; margin-top: var(--s-4); font-size: var(--text-xs); color: var(--ink-3); transition: color var(--dur-2); }
	.glance__claim:hover { color: var(--ink); }

