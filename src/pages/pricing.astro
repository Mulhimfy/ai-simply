---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import Faq from '../components/Faq.astro';
import { SITE_TITLE, TOOL_LISTING } from '../consts';

const toolCount = (await getCollection('tools')).length;

const tiers = [
	{
		name: 'Read the brief',
		price: '$0',
		per: 'forever',
		blurb: 'What changed in AI today, why it matters, and what to do about it. Three minutes, every morning.',
		features: [
			'Today\'s brief and the full archive',
			`The Toolbox — ${toolCount} tools we've tested and rated`,
			'Explainers, comparisons and alternatives',
			'The brief in your inbox, free',
			'No account, no paywall, no tracking wall',
		],
		cta: { label: 'Read today\'s brief', href: '/', style: 'btn--ghost' },
		accent: false,
	},
	{
		name: 'List in the Toolbox',
		price: TOOL_LISTING.price,
		per: `/ ${TOOL_LISTING.interval}`,
		blurb: 'For tool makers. A permanent page in the reference section readers open when the brief points at something worth trying.',
		features: [
			'A permanent page for your tool',
			`Listed among ${toolCount} AI tools`,
			'Placement on category and subcategory pages',
			'Included in search, comparisons and alternatives',
			'A followed link to your site, indexed in our sitemap',
			'Cancel any time from the customer portal',
		],
		cta: { label: 'List your tool', href: '/submit/', style: 'btn--accent' },
		accent: true,
		fine: `Renews at ${TOOL_LISTING.price} every ${TOOL_LISTING.interval} until cancelled. Non-refundable.`,
	},
	{
		name: 'Featured',
		price: 'Waitlist',
		per: 'opens soon',
		blurb: 'Top placement, a mention in the brief\'s "what to try", and the numbers to show for it. Not on sale yet.',
		features: [
			'Priority placement in the Toolbox',
			'Category page top slot',
			'Featured badge on the tool card',
			'A mention in the newsletter',
			'Performance analytics',
		],
		cta: { label: 'Join the waitlist', href: '/contact/?subject=Featured+Listing', style: 'btn--ghost' },
		accent: false,
		soon: true,
	},
];

const trust = [
	{ icon: 'book-open', text: 'The brief is free and always will be' },
	{ icon: 'shield-check', text: 'Paying never changes a rating' },
	{ icon: 'user-check', text: 'Every listing reviewed by a human' },
	{ icon: 'clock', text: '48-hour review, cancel any time' },
];

/** The ten billing/policy answers, kept word-for-word — this is the plain-English mirror of the Terms. */
const faq = [
	{
		q: `Is ${SITE_TITLE} really free to use?`,
		a: `Free to read, yes. Browsing all ${toolCount} tools, reading reviews, tutorials, and articles costs nothing — no account or credit card required. Getting your own tool listed in the directory is the paid part, at ${TOOL_LISTING.priceLabel}.`,
	},
	{
		q: 'How do I submit my AI tool?',
		a: 'Use our <a href="/submit/">Submit a Tool</a> form. Fill in your tool\'s name, URL, description, category, and pricing model, then complete checkout. We review every submission manually and typically respond within 48 hours.',
	},
	{
		q: 'How does billing for a listing work?',
		a: `A listing is a subscription: ${TOOL_LISTING.price} ${TOOL_LISTING.currency} charged today and again every ${TOOL_LISTING.interval} until you cancel. Payment is handled by Polar, our merchant of record, and your receipt email contains a link to the customer portal where you can cancel or update your card.`,
	},
	{
		q: 'Can I get a refund?',
		a: 'No. All listing payments are non-refundable, including part-months and unused time. You can cancel at any point to stop future charges — there\'s no minimum term and no cancellation fee.',
	},
	{
		q: 'How do I cancel?',
		a: `Go to the <a href="${TOOL_LISTING.portalUrl}" target="_blank" rel="noopener noreferrer">Polar customer portal</a> — the link is also in the footer of every page and in your receipt email. Sign in with the email you paid with and cancel there. It takes a moment, there's no minimum term, and you don't need to contact us first.`,
	},
	{
		q: 'What happens to my listing if I cancel?',
		a: `Your tool stays live for the rest of the ${TOOL_LISTING.interval} you've already paid for. At the start of the next billing period the listing is automatically removed from the directory, along with its tool page, category placements, and sitemap entry.`,
	},
	{
		q: 'What makes a tool eligible for listing?',
		a: 'Any legitimate, working AI-powered tool is eligible. We list tools across all 21 categories — from productivity and coding to health and legal. We don\'t list tools that are broken, scams, or in extreme early access with no working product.',
	},
	{
		q: 'When will featured listings be available?',
		a: 'We\'re currently finalising our featured listing packages. <a href="/contact/?subject=Featured+Listing">Contact us</a> to be added to the waitlist and receive an early-adopter rate when we launch.',
	},
	{
		q: 'Do featured listings affect tool ratings?',
		a: 'No. Our editorial ratings and reviews are completely independent of any commercial relationship. A tool cannot pay for a higher rating. See our <a href="/rating-methodology/">rating methodology</a> for full details.',
	},
	{
		q: 'Can I update my tool\'s information after submission?',
		a: 'Yes. Use our <a href="/contact/">contact form</a> with the subject "Update Listing" and include the tool name and what needs to change.',
	},
];
---

<Base
	title={`Pricing | ${SITE_TITLE}`}
	description={`The brief is free, forever. Listing your tool in the Toolbox costs ${TOOL_LISTING.priceLabel} — cancel any time.`}

	noNudge>
	<PageHero
		crumbs={[{ name: 'Pricing' }]}
		eyebrow="Pricing"
		title="The brief is free. Listings are what *pay* for it."
		lead="Readers pay nothing, ever. Tool makers pay for a page in the Toolbox — which is how this site stays independent and unsponsored."
		align="center"
	/>

	<section class="section section--tight" aria-label="Plans">
		<div class="container">
			<div class="tiers" data-stagger>
				{tiers.map((t) => (
					<article class:list={['tier', { 'tier--accent': t.accent, 'tier--soon': t.soon }]} data-reveal>
						{t.accent && <span class="tier__flag">For tool makers</span>}
						<header class="tier__head">
							<h2 class="tier__name">{t.name}</h2>
							<p class="tier__price">
								<span class="tier__amt tnum">{t.price}</span>
								<span class="tier__per">{t.per}</span>
							</p>
							<p class="tier__blurb">{t.blurb}</p>
						</header>
						<ul class="tier__list" role="list">
							{t.features.map((f) => (
								<li><Icon name="check" size={15} /><span>{f}</span></li>
							))}
						</ul>
						<div class="tier__foot">
							<a href={t.cta.href} class:list={['btn', t.cta.style, 'w-full']}>{t.cta.label}</a>
							{t.fine && <p class="tier__fine">{t.fine}</p>}
						</div>
					</article>
				))}
			</div>

			<ul class="trust" role="list">
				{trust.map((t) => (
					<li><Icon name={t.icon} size={16} /> {t.text}</li>
				))}
			</ul>
		</div>
	</section>

	<section class="section section--tight" aria-label="Frequently asked questions">
		<div class="container container--narrow">
			<div class="section-head">
				<div class="section-head__title">
					<span class="eyebrow">Questions</span>
					<h2>Billing, cancelling and the <em class="serif">fine print</em></h2>
					<p class="section-head__desc">The plain-English version. The binding version is in the <a href="/terms/" class="link-u">Terms of Service</a>.</p>
				</div>
			</div>
			<Faq items={faq} heading={false} jsonld />
			<p class="faq-foot">
				Still unsure? <a href="/contact/" class="link-u">Ask us</a> — we answer within one or two business days.
			</p>
		</div>
	</section>
</Base>

<style>
	.tiers { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: var(--s-5); row-gap: var(--s-6); align-items: stretch; }
	@media (max-width: 980px) { .tiers { grid-template-columns: minmax(0, 1fr); max-width: 560px; margin-inline: auto; } }

	.tier {
		position: relative; display: flex; flex-direction: column; gap: var(--s-6);
		background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-xl);
		padding: clamp(1.5rem, 1.2rem + 1.2vw, 2rem);
		box-shadow: var(--shadow-sm);
		transition: transform var(--dur-3) var(--ease-out), box-shadow var(--dur-3) var(--ease-out), border-color var(--dur-3) var(--ease-out);
	}
	/* subgrid so the price, the feature rule and the button line up across all
	   three cards even though the third price is a word, not a number */
	@media (min-width: 981px) {
		.tiers { grid-template-rows: auto auto 1fr; }
		.tier { display: grid; grid-template-rows: subgrid; grid-row: span 3; }
	}
	.tier:hover { transform: translateY(-3px); box-shadow: var(--shadow-lg); }
	.tier--accent { border-color: transparent; box-shadow: var(--shadow-glow); background: linear-gradient(180deg, var(--accent-soft) 0%, var(--surface) 42%); }
	.tier--soon { background: var(--surface-2); box-shadow: none; }
	.tier--soon:hover { box-shadow: var(--shadow-md); }
	.tier__flag {
		position: absolute; top: -11px; left: clamp(1.5rem, 1.2rem + 1.2vw, 2rem);
		background: var(--accent); color: var(--on-accent);
		font-family: var(--font-mono); font-size: 0.625rem; letter-spacing: 0.1em; text-transform: uppercase; font-weight: 600;
		padding: 3px 10px; border-radius: var(--r-full);
	}
	.tier__head { display: grid; gap: var(--s-3); }
	.tier__name { font-size: var(--text-lg); }
	/* the row keeps the height of a full-size price so the three blurbs, rules
	   and prices sit on the same lines whatever the third tier says */
	.tier__price { display: flex; align-items: baseline; gap: var(--s-2); flex-wrap: wrap; min-height: var(--text-4xl); }
	.tier__amt { font-size: var(--text-4xl); font-weight: 600; letter-spacing: -0.045em; line-height: 1; color: var(--ink); }
	.tier--soon .tier__price { align-items: last baseline; }
	.tier--soon .tier__amt { font-size: var(--text-2xl); color: var(--ink-2); }
	.tier__per { font-size: var(--text-sm); color: var(--ink-3); }
	.tier__blurb { font-size: var(--text-sm); color: var(--ink-3); line-height: 1.55; }

	.tier__list { display: grid; gap: var(--s-3); padding-top: var(--s-5); border-top: 1px solid var(--line); }
	.tier__list li { display: flex; align-items: flex-start; gap: var(--s-3); font-size: var(--text-sm); color: var(--ink-2); line-height: 1.5; }
	.tier__list :global(.icon) { flex-shrink: 0; margin-top: 3px; color: var(--accent); }
	.tier--soon .tier__list :global(.icon) { color: var(--ink-4); }

	.tier__foot { margin-top: auto; display: grid; gap: var(--s-3); align-content: start; }
	/* in the subgrid the row already reaches the bottom: keep the three buttons on one line */
	@media (min-width: 981px) { .tier__foot { margin-top: 0; } }
	.tier__fine { font-size: var(--text-xs); color: var(--ink-3); text-align: center; line-height: 1.5; }

	.trust {
		display: flex; flex-wrap: wrap; justify-content: center; gap: var(--s-4) var(--s-8);
		margin-top: var(--s-10); padding-top: var(--s-6); border-top: 1px solid var(--line);
	}
	.trust li { display: inline-flex; align-items: center; gap: var(--s-2); font-size: var(--text-sm); color: var(--ink-3); }
	.trust :global(.icon) { color: var(--accent); }

	.faq-foot { margin-top: var(--s-8); font-size: var(--text-sm); color: var(--ink-3); }
</style>
