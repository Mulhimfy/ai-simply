---
/**
 * /saved/ — "My tools". Per-visitor, noindex.
 * Reads localStorage['aib-saved'] ({slug: name}) and renders cards from
 * /search-index.json entirely client-side. `?t=slug,slug` renders someone
 * else's list read-only with a "Save all to mine" action. Also surfaces the
 * quiz match stored in localStorage['aib-quiz-result'] when present.
 */
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
---
<Base title="My tools" description="The tools you saved, in one place. Stored in this browser, no account needed." noindex noNudge>
	<section class="sv-hero">
		<div class="sv-hero__bg bg-grid" aria-hidden="true"></div>
		<div class="glow sv-hero__glow" aria-hidden="true"></div>
		<div class="container sv-hero__inner">
			<div class="sv-hero__text">
				<span class="eyebrow" data-sv-eyebrow>My tools</span>
				<h1 class="sv-hero__title" data-sv-title>Your <em class="serif">shortlist</em>.</h1>
				<p class="lead" data-sv-lead>Tools you bookmarked across AI Briefs. Saved in this browser, no account needed.</p>
				<p class="sv-meta mono" data-sv-meta hidden></p>
			</div>
			<div class="sv-actions" data-sv-actions hidden>
				<button type="button" class="btn btn--ghost btn--sm" data-sv-share><Icon name="link" /> Share this list</button>
				<button type="button" class="btn btn--ghost btn--sm" data-sv-export><Icon name="copy" /> Copy as text</button>
				<button type="button" class="btn btn--ghost btn--sm sv-clear" data-sv-clear><Icon name="trash-2" /> Clear</button>
			</div>
			<div class="sv-actions" data-sv-shared-actions hidden>
				<button type="button" class="btn btn--accent btn--sm" data-sv-save-all><Icon name="bookmark-plus" /> Save all to mine</button>
				<a class="btn btn--ghost btn--sm" href="/saved/"><Icon name="bookmark" /> View my tools</a>
			</div>
		</div>
	</section>

	<section class="sv-body">
		<div class="container">
			<div class="sv-quiz" data-sv-quiz hidden></div>

			<div class="sv-grid" data-sv-grid role="list" aria-label="Saved tools"></div>

			<div class="sv-empty" data-sv-empty hidden>
				<div class="sv-illo" aria-hidden="true">
					<div class="sv-illo__card sv-illo__card--back"><span></span><i></i><i></i></div>
					<div class="sv-illo__card sv-illo__card--mid"><span></span><i></i><i></i></div>
					<div class="sv-illo__card sv-illo__card--front">
						<span></span><i></i><i></i>
						<b class="sv-illo__mark"><Icon name="bookmark" size={16} strokeWidth={2.2} /></b>
					</div>
				</div>
				<h2 class="sv-empty__title" data-sv-empty-title>Nothing saved <em class="serif">yet</em>.</h2>
				<p class="sv-empty__text" data-sv-empty-text>Tap the bookmark on any tool to keep it here. Your list stays in this browser and you can share it with a link.</p>
				<div class="sv-empty__actions">
					<a href="/" class="btn btn--accent"><Icon name="newspaper" /> Read today's brief</a>
					<a href="/tools/" class="btn btn--ghost"><Icon name="layout-grid" /> Browse the toolbox</a>
				</div>
				<a href="/tools/quiz/" class="link-arrow sv-empty__browse">Not sure? Take “What to try” <Icon name="arrow-right" /></a>
			</div>

			<noscript>
				<div class="card card--pad sv-noscript">
					<p><strong>My tools needs JavaScript.</strong> Saved tools live in your browser's storage, so we can't show them without it.</p>
					<p><a href="/tools/" class="link-u">Browse the toolbox instead</a>.</p>
				</div>
			</noscript>

			<template id="sv-icons">
				<Icon name="arrow-right" size={14} />
				<Icon name="x" size={16} />
				<Icon name="bookmark" size={16} />
				<Icon name="bookmark-plus" size={16} />
				<Icon name="rotate-ccw" size={14} />
			</template>
		</div>
	</section>
</Base>

<script>
	type Tool = { n: string; d: string; u: string; c: string; cs: string; p: 'free' | 'freemium' | 'paid'; r: number | null; l: string | null; t?: string[] };
	type Idx = { tools: Tool[] };
	const KEY = 'aib-saved';
	const QUIZ_KEY = 'aib-quiz-result';
	const STAR = 'M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.4 6.1 20.6l1.3-6.6L2.5 9.4l6.6-.8z';
	const OWN = { eyebrow: 'My tools', title: 'Your <em class="serif">shortlist</em>.', lead: 'Tools you bookmarked across AI Briefs. Saved in this browser, no account needed.' };
	const SHARED = { eyebrow: 'Shared list', title: 'A shortlist, <em class="serif">shared</em> with you.', lead: 'Someone picked these on AI Briefs. Save the ones you like, or add the whole list to yours.' };

	const $ = <T extends HTMLElement = HTMLElement>(sel: string) => document.querySelector<T>(sel);
	const esc = (s: unknown) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string));
	const toast = (m: string) => (window as any).__aib?.toast?.(m);
	const icons: Record<string, string> = {};
	function icon(name: string) {
		if (!icons[name]) { const t = document.getElementById('sv-icons') as HTMLTemplateElement | null; icons[name] = t?.content.querySelector(`.icon-${name}`)?.outerHTML || ''; }
		return icons[name];
	}

	function saved(): Record<string, string> { try { return JSON.parse(localStorage.getItem(KEY) || '{}'); } catch { return {}; } }
	function writeSaved(s: Record<string, string>) {
		try { localStorage.setItem(KEY, JSON.stringify(s)); } catch {}
		lastSig = null; // the list changed → let the next render() run
		document.dispatchEvent(new CustomEvent('aib:saved-change', { detail: s }));
	}
	function slugOf(u: string) { return u.replace(/^\/tools\//, '').replace(/\/$/, ''); }
	function hue(slug: string) { let h = 0; for (const ch of slug) h = (h * 31 + ch.charCodeAt(0)) % 360; return h; }

	let idxP: Promise<Idx> | null = null;
	function loadIndex() { if (!idxP) idxP = fetch('/search-index.json').then((r) => r.json()); return idxP; }

	/* ── rendering ─────────────────────────────────────────────────────── */
	function logoHtml(t: Tool | null, slug: string, name: string, size = 48) {
		const inner = t?.l
			? `<img src="${esc(t.l)}" alt="" width="${Math.round(size * 0.6)}" height="${Math.round(size * 0.6)}" loading="lazy" decoding="async">`
			: `<span class="sv-letter">${esc((name.trim()[0] || '?').toUpperCase())}</span>`;
		return `<span class="logo-mark sv-logo" style="--mark:${size}px;--lm-h:${hue(slug)}" aria-hidden="true">${inner}</span>`;
	}
	function stars(r: number, i: number) {
		const v = Math.max(0, Math.min(5, r));
		let html = '<span class="stars" aria-hidden="true">';
		for (let k = 1; k <= 5; k++) {
			const s = v >= k ? 'full' : v >= k - 0.5 ? 'half' : 'empty';
			const id = `sv-half-${i}-${k}`;
			html += `<svg width="12" height="12" viewBox="0 0 24 24" class="icon${s === 'empty' ? ' is-empty' : ''}">${s === 'half' ? `<defs><linearGradient id="${id}"><stop offset="50%" stop-color="currentColor"/><stop offset="50%" stop-color="transparent"/></linearGradient></defs>` : ''}<path d="${STAR}" fill="${s === 'full' ? 'currentColor' : s === 'half' ? `url(#${id})` : 'transparent'}" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" opacity="${s === 'empty' ? 0.35 : 1}"/></svg>`;
		}
		return html + '</span>';
	}
	function card(t: Tool | null, slug: string, name: string, i: number, mode: 'own' | 'shared', mine: Record<string, string>) {
		const url = t?.u || `/tools/${slug}/`;
		const label = t ? { free: 'Free', freemium: 'Freemium', paid: 'Paid' }[t.p] : '';
		const num = String(i + 1).padStart(2, '0');
		const inMine = !!mine[slug];
		const action = mode === 'own'
			? `<button type="button" class="sv-card__rm" data-sv-remove="${esc(slug)}" aria-label="Remove ${esc(name)} from saved" title="Remove">${icon('x')}</button>`
			: `<button type="button" class="sv-card__toggle" data-sv-toggle="${esc(slug)}" data-sv-name="${esc(name)}" aria-pressed="${inMine}" aria-label="${inMine ? 'Saved' : 'Save'} ${esc(name)}" title="${inMine ? 'Saved to my tools' : 'Save to my tools'}">${icon('bookmark')}</button>`;
		return `<article class="sv-card" role="listitem" data-slug="${esc(slug)}" data-reveal style="--i:${Math.min(i, 12)}">
			<span class="sv-card__num mono">${num}</span>
			<a class="sv-card__link" href="${esc(url)}" aria-label="${esc(name)}${t ? ' — ' + esc(t.d) : ''}">
				<div class="sv-card__top">
					${logoHtml(t, slug, name)}
					<div class="sv-card__id">
						<h3 class="sv-card__name">${esc(name)}</h3>
						<span class="sv-card__cat">${t ? esc(t.c) : 'No longer listed'}</span>
					</div>
					${t ? `<span class="pill pill--${t.p} sv-card__price">${label}</span>` : ''}
				</div>
				<p class="sv-card__desc">${t ? esc(t.d) : 'This tool has been removed from the toolbox. You can still remove it from your list.'}</p>
			</a>
			<div class="sv-card__foot">
				${t?.r ? `<span class="rating" aria-label="Rated ${t.r.toFixed(1)} out of 5">${stars(t.r, i)}<span class="rating__num tnum">${t.r.toFixed(1)}</span></span>` : `<span class="sv-card__unrated">Not yet rated</span>`}
				<div class="sv-card__actions">
					<a class="btn btn--soft btn--sm" href="${esc(url)}">Details ${icon('arrow-right')}</a>
					${action}
				</div>
			</div>
		</article>`;
	}
	function skeletons(n: number) {
		let html = '';
		for (let i = 0; i < Math.min(n, 9); i++) html += `<div class="sv-card sv-card--skel" aria-hidden="true"><div class="sv-card__top"><span class="shimmer sv-skel-logo"></span><div class="sv-card__id"><span class="shimmer sv-skel-line" style="width:55%"></span><span class="shimmer sv-skel-line" style="width:35%;height:10px"></span></div></div><span class="shimmer sv-skel-line"></span><span class="shimmer sv-skel-line" style="width:80%"></span></div>`;
		return html;
	}
	function reveal() {
		const aib = (window as any).__aib;
		if (aib?.reveal) aib.reveal(); else document.querySelectorAll('[data-reveal]').forEach((el) => el.classList.add('is-in'));
	}

	/* ── quiz result card (tolerant of the shape the quiz stores) ───────── */
	function quizResult(): { slug: string; tier?: string; at?: number; r?: string } | null {
		try {
			const raw = localStorage.getItem(QUIZ_KEY); if (!raw) return null;
			let j: any; try { j = JSON.parse(raw); } catch { j = raw; }
			if (typeof j === 'string') return { slug: j };
			const first = (v: any) => (Array.isArray(v) ? v[0] : v);
			const top = first(j.slug ?? j.top ?? j.match ?? j.tool ?? j.best ?? j.results ?? j.matches);
			const slug = typeof top === 'string' ? top : top?.slug || top?.id;
			if (!slug) return null;
			const at = Number(j.at ?? j.ts ?? j.date ?? j.time) || undefined;
			return { slug, tier: j.tier || j.label || (typeof top === 'object' && top?.tier) || 'Best match', at, r: typeof j.r === 'string' ? j.r : undefined };
		} catch { return null; }
	}
	async function paintQuiz() {
		const host = $('[data-sv-quiz]'); const q = quizResult();
		if (!host || !q) return;
		const idx = await loadIndex();
		const t = idx.tools.find((x) => slugOf(x.u) === q.slug);
		if (!t) return;
		const when = q.at ? new Date(q.at).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : '';
		host.innerHTML = `<div class="sv-quiz__card card card--ink" data-reveal="scale">
			<div class="sv-quiz__glow" aria-hidden="true"></div>
			${logoHtml(t, q.slug, t.n, 56)}
			<div class="sv-quiz__body">
				<span class="eyebrow">Your quiz match${when ? ` · ${esc(when)}` : ''}</span>
				<h2 class="sv-quiz__title">${esc(t.n)} <span class="pill pill--accent">${esc(q.tier || 'Best match')}</span></h2>
				<p class="sv-quiz__desc">${esc(t.d)}</p>
			</div>
			<div class="sv-quiz__actions">
				<a class="btn btn--accent btn--sm" href="${esc(t.u)}">See ${esc(t.n)} ${icon('arrow-right')}</a>
				<a class="btn btn--ghost btn--sm" href="/tools/quiz/${q.r ? '?r=' + encodeURIComponent(q.r) : ''}">${icon('rotate-ccw')} Retake</a>
			</div>
		</div>`;
		host.hidden = false;
		reveal();
	}

	/* ── modes ──────────────────────────────────────────────────────────── */
	function setHero(o: { eyebrow: string; title: string; lead: string; meta?: string }) {
		const e = $('[data-sv-eyebrow]'), t = $('[data-sv-title]'), l = $('[data-sv-lead]'), m = $('[data-sv-meta]');
		if (e) e.textContent = o.eyebrow; if (t) t.innerHTML = o.title; if (l) l.textContent = o.lead;
		if (m) { m.textContent = o.meta || ''; m.hidden = !o.meta; }
	}
	function metaFor(tools: (Tool | null)[]) {
		const n = tools.length; const c: Record<string, number> = { free: 0, freemium: 0, paid: 0 };
		for (const t of tools) if (t) c[t.p]++;
		const parts = [`${n} tool${n === 1 ? '' : 's'}`];
		for (const k of ['free', 'freemium', 'paid'] as const) if (c[k]) parts.push(`${c[k]} ${k}`);
		return parts.join(' · ');
	}
	function showEmpty(title: string, text: string) {
		const e = $('[data-sv-empty]'); if (!e) return;
		const t = $('[data-sv-empty-title]'), p = $('[data-sv-empty-text]');
		if (t) t.innerHTML = title; if (p) p.textContent = text;
		e.hidden = false; reveal();
	}

	async function renderOwn(animate = false) {
		const grid = $('[data-sv-grid]')!; const empty = $('[data-sv-empty]')!; const actions = $('[data-sv-actions]')!;
		const s = saved(); const slugs = Object.keys(s);
		setHero(OWN);
		if (!slugs.length) {
			grid.innerHTML = ''; actions.hidden = true;
			showEmpty('Nothing saved <em class="serif">yet</em>.', 'Tap the bookmark on any tool to keep it here. Your list stays in this browser and you can share it with a link.');
			return;
		}
		empty.hidden = true;
		if (!grid.children.length) grid.innerHTML = skeletons(slugs.length);
		const idx = await loadIndex();
		const bySlug = new Map(idx.tools.map((t) => [slugOf(t.u), t]));
		const tools = slugs.map((sl) => bySlug.get(sl) || null);
		grid.innerHTML = slugs.map((sl, i) => card(tools[i], sl, tools[i]?.n || s[sl] || sl, i, 'own', s)).join('');
		setHero({ ...OWN, meta: metaFor(tools) });
		actions.hidden = false;
		if (!animate) grid.querySelectorAll('[data-reveal]').forEach((el) => el.classList.add('is-in')); else reveal();
	}

	async function renderShared(list: string[]) {
		const grid = $('[data-sv-grid]')!; const actions = $('[data-sv-shared-actions]')!;
		setHero(SHARED);
		grid.innerHTML = skeletons(list.length);
		const idx = await loadIndex();
		const bySlug = new Map(idx.tools.map((t) => [slugOf(t.u), t]));
		const known = list.filter((sl) => bySlug.has(sl));
		if (!known.length) {
			grid.innerHTML = '';
			showEmpty('Nothing to show <em class="serif">here</em>.', "This link doesn't include any tools we recognise. Browse the toolbox to build your own list.");
			return;
		}
		const mine = saved();
		grid.innerHTML = known.map((sl, i) => card(bySlug.get(sl)!, sl, bySlug.get(sl)!.n, i, 'shared', mine)).join('');
		setHero({ ...SHARED, meta: metaFor(known.map((sl) => bySlug.get(sl)!)) });
		actions.hidden = false;
		const all = known.every((sl) => mine[sl]);
		const btn = $('[data-sv-save-all]') as HTMLButtonElement | null; if (btn) { btn.disabled = all; if (all) btn.innerHTML = `${icon('bookmark')} All saved`; }
		reveal();
	}

	/* ── actions ────────────────────────────────────────────────────────── */
	function shareUrl(slugs: string[]) { return `${location.origin}/saved/?t=${slugs.map(encodeURIComponent).join(',')}`; }
	async function copy(text: string, msg: string) {
		try { await navigator.clipboard.writeText(text); toast(msg); } catch { toast('Copy failed — your browser blocked clipboard access'); }
	}
	async function exportText() {
		const s = saved(); const slugs = Object.keys(s); if (!slugs.length) return;
		const idx = await loadIndex(); const bySlug = new Map(idx.tools.map((t) => [slugOf(t.u), t]));
		const lines = slugs.map((sl, i) => { const t = bySlug.get(sl); return `${i + 1}. ${t?.n || s[sl]}${t ? ` — ${t.c} · ${t.p}` : ''} · ${location.origin}${t?.u || `/tools/${sl}/`}`; });
		copy(`My AI tools — AI Briefs\n\n${lines.join('\n')}\n\nShared list: ${shareUrl(slugs)}`, 'List copied as text');
	}
	function removeOne(slug: string) {
		const s = saved(); const name = s[slug]; delete s[slug]; writeSaved(s);
		const el = document.querySelector<HTMLElement>(`.sv-card[data-slug="${CSS.escape(slug)}"]`);
		toast(name ? `Removed ${name}` : 'Removed');
		if (!el) { renderOwn(); return; }
		el.classList.add('is-leaving');
		setTimeout(() => { el.remove(); renderOwn(); }, 260);
	}

	function sharedList(): string[] {
		const t = new URLSearchParams(location.search).get('t');
		return t ? [...new Set(t.split(',').map((x) => x.trim().toLowerCase()).filter((x) => /^[a-z0-9-]+$/.test(x)))] : [];
	}
	function onSavedPage() { return !!$('[data-sv-grid]'); }

	function bindOnce() {
		if ((window as any).__aibSavedBound) return;
		(window as any).__aibSavedBound = true;

		document.addEventListener('click', async (e) => {
			const t = e.target as HTMLElement;
			if (!t.closest('.sv-hero, .sv-body')) return;
			const rm = t.closest<HTMLElement>('[data-sv-remove]'); if (rm) { removeOne(rm.dataset.svRemove!); return; }
			const tg = t.closest<HTMLElement>('[data-sv-toggle]');
			if (tg) {
				const s = saved(); const slug = tg.dataset.svToggle!; const on = !s[slug];
				if (on) s[slug] = tg.dataset.svName || slug; else delete s[slug];
				writeSaved(s); tg.setAttribute('aria-pressed', String(on)); tg.setAttribute('aria-label', `${on ? 'Saved' : 'Save'} ${tg.dataset.svName}`);
				tg.classList.remove('is-pop'); void tg.offsetWidth; tg.classList.add('is-pop');
				toast(on ? `Saved ${tg.dataset.svName} · view in My tools` : 'Removed from saved');
				const btn = $('[data-sv-save-all]') as HTMLButtonElement | null; if (btn && !on) { btn.disabled = false; btn.innerHTML = `${icon('bookmark-plus')} Save all to mine`; }
				return;
			}
			if (t.closest('[data-sv-share]')) {
				const slugs = Object.keys(saved()); if (!slugs.length) return;
				const url = shareUrl(slugs);
				if ((navigator as any).share && matchMedia('(hover: none)').matches) { try { await (navigator as any).share({ title: 'My AI tools — AI Briefs', url }); return; } catch {} }
				copy(url, 'Link copied — anyone with it can see your list');
				return;
			}
			if (t.closest('[data-sv-export]')) { exportText(); return; }
			if (t.closest('[data-sv-clear]')) {
				const n = Object.keys(saved()).length;
				if (!n || !confirm(`Remove all ${n} saved tool${n === 1 ? '' : 's'}?`)) return;
				writeSaved({}); toast('List cleared'); renderOwn(true); return;
			}
			if (t.closest('[data-sv-save-all]')) {
				const s = saved(); let added = 0;
				document.querySelectorAll<HTMLElement>('[data-sv-toggle]').forEach((b) => { const sl = b.dataset.svToggle!; if (!s[sl]) { s[sl] = b.dataset.svName || sl; added++; } b.setAttribute('aria-pressed', 'true'); b.setAttribute('aria-label', `Saved ${b.dataset.svName}`); });
				writeSaved(s);
				const btn = t.closest<HTMLButtonElement>('[data-sv-save-all]')!; btn.disabled = true; btn.innerHTML = `${icon('bookmark')} All saved`;
				toast(added ? `Saved ${added} tool${added === 1 ? '' : 's'} to My tools` : 'Already in your list');
				return;
			}
		});
		// other tabs
		window.addEventListener('storage', (e) => { if (e.key === KEY && onSavedPage() && !sharedList().length) renderOwn(); });
	}

	/** What the grid currently shows — lets us skip the duplicate render that the
	 *  module's own run + the first `astro:page-load` would otherwise cause.
	 *  A view transition swaps in a fresh (empty) grid while this module keeps
	 *  running, so the signature has to be cleared with the DOM or the page comes
	 *  back blank. */
	let lastSig: string | null = null;
	document.addEventListener('astro:after-swap', () => { lastSig = null; });
	function sig() { const l = sharedList(); return l.length ? `t:${l.join(',')}` : `own:${Object.keys(saved()).join(',')}`; }
	function render(animate = false) {
		if (!onSavedPage()) return;
		bindOnce();
		const s = sig();
		if (s === lastSig) return;
		lastSig = s;
		const list = sharedList();
		if (list.length) renderShared(list); else renderOwn(animate);
		paintQuiz();
	}
	render(true);
	document.addEventListener('astro:page-load', () => render(true));
</script>

<style is:global>
	/* hero */
	.sv-hero { position: relative; overflow: hidden; padding-block: var(--s-12) var(--s-10); border-bottom: 1px solid var(--line); }
	.sv-hero__bg { position: absolute; inset: 0; opacity: 0.7; pointer-events: none; }
	.sv-hero__glow { top: -160px; right: -80px; width: 420px; height: 420px; opacity: 0.55; }
	.sv-hero__inner { position: relative; display: flex; align-items: flex-end; justify-content: space-between; gap: var(--s-8); flex-wrap: wrap; }
	.sv-hero__text { display: grid; gap: var(--s-4); max-width: 640px; }
	.sv-hero__title { font-size: var(--text-4xl); }
	.sv-meta { margin-top: calc(var(--s-1) * -1); }
	.sv-actions { display: flex; gap: var(--s-2); flex-wrap: wrap; }
	.sv-clear { --btn-fg: var(--ink-3); }
	.sv-clear:hover { --btn-fg: var(--bad); border-color: var(--bad); background: var(--bad-soft); }

	/* body */
	/* Everything below is rendered from localStorage after hydration. Reserve the
	   height of the empty state so revealing it does not shove the footer down
	   (this was the whole of the page's 0.097 CLS). */
