---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { SITE_TITLE, TOOL_LISTING } from '../../consts';
---

<Base
	title={`Submission received | ${SITE_TITLE}`}
	description="Your AI tool listing subscription is active. We'll review your tool and publish it within 48 hours."
	noindex
	noNudge
>
	<meta slot="head" name="robots" content="noindex, nofollow" />

	<div class="container container--prose success-body">

		<!-- Paid + confirmed -->
		<article class="card card--pad success" id="ok-card" hidden>
			<div class="success__mark success__mark--good"><Icon name="check" size={28} strokeWidth={2.25} /></div>
			<span class="eyebrow">Payment received</span>
			<h1 class="success__title">You're in.</h1>
			<p class="lead">
				Your subscription is active and <strong id="ok-tool">your tool</strong> is queued for review.
				A receipt is on its way to your inbox from Polar.
			</p>

			<dl class="receipt">
				<div><dt>Submission reference</dt><dd><code id="ok-ref">—</code></dd></div>
				<div><dt>Checkout ID</dt><dd><code id="ok-checkout">—</code></dd></div>
				<div><dt>Plan</dt><dd>{TOOL_LISTING.priceLabel}, renews automatically</dd></div>
			</dl>

			<h2 class="success__h2">What happens next</h2>
			<ol class="next" role="list">
				<li><span class="next__num tnum">1</span><div><strong>We review your tool</strong><p>We check it's working, legitimate, and meets our <a href="/terms/" class="link-u">listing criteria</a>.</p></div></li>
				<li><span class="next__num tnum">2</span><div><strong>It goes live</strong><p>Usually within 48 hours. We'll email you the link to your listing page.</p></div></li>
				<li><span class="next__num tnum">3</span><div><strong>It stays live while you're subscribed</strong><p>See below for exactly how cancelling works.</p></div></li>
			</ol>

			<div class="terms-box">
				<h3 class="terms-box__title"><Icon name="info" size={15} /> Your subscription, in plain English</h3>
				<ul class="terms-box__list" role="list">
					<li>You'll be charged <strong>{TOOL_LISTING.price} {TOOL_LISTING.currency} every {TOOL_LISTING.interval}</strong> until you cancel.</li>
					<li><strong>Payments are non-refundable</strong>, including part-months and unused time.</li>
					<li>Cancel any time from the <a href={TOOL_LISTING.portalUrl} target="_blank" rel="noopener">Polar customer portal</a> — the link is also in your receipt email.</li>
					<li>When you cancel, your listing stays live for the rest of the {TOOL_LISTING.interval} you've paid for, then is <strong>automatically removed</strong> from the Toolbox at the start of the next billing period.</li>
				</ul>
			</div>

			<div class="cta-row">
				<a href="/" class="btn btn--accent">Read today's brief <Icon name="arrow-right" class="icon--arrow" /></a>
				<a href="/tools/" class="btn btn--ghost">Open the Toolbox</a>
				<a href="/contact/" class="btn btn--ghost">Contact us</a>
			</div>
		</article>

		<!-- Landed here without a checkout id -->
		<article class="card card--pad success success--warn" id="unknown-card" hidden>
			<div class="success__mark success__mark--warn"><Icon name="circle-alert" size={26} strokeWidth={2} /></div>
			<span class="eyebrow">No checkout reference</span>
			<h1 class="success__title">We couldn't confirm a payment.</h1>
			<p class="lead">
				This page is shown after a completed checkout, but no checkout reference came through with it.
				If you've just paid, your receipt email from Polar is the confirmation that counts — nothing is lost.
			</p>
			<div class="cta-row">
				<a href="/submit/" class="btn btn--accent">Back to the listing form <Icon name="arrow-right" class="icon--arrow" /></a>
				<a href="/contact/" class="btn btn--ghost">Contact us</a>
			</div>
		</article>

	</div>
</Base>

<script define:vars={{ FORMSPREE_URL: TOOL_LISTING.formspreeUrl }} data-astro-rerun>
const params = new URLSearchParams(window.location.search);
const checkoutId = params.get('checkout_id');

let submission = null;
try { submission = JSON.parse(sessionStorage.getItem('aib_submission') || 'null'); } catch {}

if (checkoutId) {
	document.getElementById('ok-card').hidden = false;
	document.getElementById('ok-checkout').textContent = checkoutId;
	if (submission) {
		document.getElementById('ok-tool').textContent = submission.name;
		document.getElementById('ok-ref').textContent = submission.ref;
	} else {
		document.getElementById('ok-ref').textContent = 'see your receipt email';
	}

	// Tell the editorial inbox this submission is PAID, so it can be matched to the
	// details captured at step 1. Fires once per checkout id.
	const firedKey = `aib_paid_notified_${checkoutId}`;
	if (!sessionStorage.getItem(firedKey)) {
		const body = new FormData();
		body.append('_subject', `PAID — tool listing ${submission ? submission.name : ''}`.trim());
		body.append('payment-status', 'PAID — checkout completed');
		body.append('checkout-id', checkoutId);
		body.append('listing-ref', submission ? submission.ref : '(unknown — sessionStorage empty)');
		if (submission) {
			body.append('tool-name', submission.name);
			body.append('tool-url', submission.url);
			body.append('submitter-email', submission.email);
			body.append('tool-category', submission.category);
			body.append('tool-pricing', submission.pricing);
			body.append('tool-description', submission.description);
		}
		fetch(FORMSPREE_URL, { method: 'POST', body, headers: { Accept: 'application/json' } })
			.then(() => { try { sessionStorage.setItem(firedKey, '1'); } catch {} })
			.catch(() => {});
	}
} else {
	document.getElementById('unknown-card').hidden = false;
}
</script>

<style>
	.success-body { padding-block: clamp(2.5rem, 2rem + 3vw, 5rem) var(--section); }
	.success { padding: clamp(1.5rem, 1.2rem + 2.5vw, 2.75rem); display: grid; gap: var(--s-4); }
	.success__mark {
		width: 56px; height: 56px; border-radius: 50%; display: grid; place-items: center;
		background: var(--good-soft); color: var(--good); margin-bottom: var(--s-2);
	}
	.success__mark--warn { background: var(--warn-soft); color: var(--warn); }
	.success__title { font-size: var(--text-3xl); }
	.success__h2 { font-size: var(--text-lg); margin-top: var(--s-4); }

	.receipt { border: 1px solid var(--line); border-radius: var(--r-md); overflow: hidden; margin-top: var(--s-2); }
	.receipt > div { display: flex; justify-content: space-between; align-items: center; gap: var(--s-4); padding: var(--s-3) var(--s-4); font-size: var(--text-sm); }
	.receipt > div + div { border-top: 1px solid var(--line); }
	.receipt dt { color: var(--ink-3); }
	.receipt dd { margin: 0; font-weight: 600; text-align: right; word-break: break-all; }
	.receipt code { font-family: var(--font-mono); font-size: 0.78rem; background: var(--surface-2); border: 1px solid var(--line); padding: 0.15rem 0.45rem; border-radius: 6px; }

	.next { display: grid; gap: var(--s-4); }
	.next li { display: flex; align-items: flex-start; gap: var(--s-3); }
	.next__num { flex-shrink: 0; display: grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; background: var(--ink); color: var(--bg); font-family: var(--font-mono); font-size: 0.7rem; font-weight: 600; margin-top: 1px; }
	.next strong { display: block; font-size: var(--text-base); margin-bottom: 2px; }
	.next p { font-size: var(--text-sm); color: var(--ink-3); line-height: 1.55; }

	.terms-box { background: var(--warn-soft); border-left: 3px solid var(--warn); border-radius: var(--r-md); padding: var(--s-5); }
	.terms-box__title { display: flex; align-items: center; gap: 6px; font-size: var(--text-sm); color: var(--warn); margin-bottom: var(--s-3); }
	.terms-box__list { display: grid; gap: var(--s-3); padding-left: 1.1em; }
	.terms-box__list li { font-size: var(--text-sm); line-height: 1.6; color: var(--ink-2); }
	.terms-box__list li::marker { color: var(--warn); }
	.terms-box__list strong { color: var(--ink); }
	.terms-box__list a { color: var(--accent-ink); text-decoration: underline; text-underline-offset: 0.18em; font-weight: 600; }

	.cta-row { display: flex; gap: var(--s-3); flex-wrap: wrap; margin-top: var(--s-2); }
	@media (max-width: 520px) { .cta-row .btn { width: 100%; } }
</style>
