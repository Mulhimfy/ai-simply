---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import Faq from '../../components/Faq.astro';
import { SITE_TITLE, TOOL_CATEGORIES, TOOL_LISTING } from '../../consts';

const toolCount = (await getCollection('tools')).length;

const included = [
	{ icon: 'file-text', text: 'A permanent page for your tool, written to the same template we use for everything else' },
	{ icon: 'layout-grid', text: `Listed in the Toolbox alongside ${toolCount} other tools` },
	{ icon: 'folder-tree', text: 'Placement on your category and subcategory pages' },
	{ icon: 'search', text: 'Included in site search, comparisons and alternatives' },
	{ icon: 'link', text: 'A followed link to your site' },
	{ icon: 'globe', text: 'Indexed in our sitemap' },
];

const criteria = [
	{ ok: true, text: 'AI is a core feature, not a label' },
	{ ok: true, text: 'A working product or public demo' },
	{ ok: true, text: 'A clear, published pricing model' },
	{ ok: false, text: 'No broken, parked or scam sites' },
	{ ok: false, text: 'No pure white-label repackaging' },
];

const faq = [
	{ q: 'Does paying change my rating?', a: 'No. A listing buys a page in the Toolbox, not a score, a ranking or a mention in the brief. Ratings come from hands-on testing — see the <a href="/rating-methodology/">rating methodology</a>.' },
	{ q: 'When does my tool go live?', a: 'Usually within 48 hours. We check the tool works and meets the listing criteria first; if it does not, we cancel the subscription so you are not billed again.' },
	{ q: 'How do I cancel?', a: `Any time, from the <a href="${TOOL_LISTING.portalUrl}" target="_blank" rel="noopener noreferrer">Polar customer portal</a> — sign in with the email you paid with. No minimum term, no cancellation fee.` },
	{ q: 'What happens to the listing when I cancel?', a: `It stays live until the end of the ${TOOL_LISTING.interval} you have already paid for, then comes down automatically at the start of the next billing period.` },
	{ q: 'Are payments refundable?', a: 'No. All listing payments are final and non-refundable, including part-months and unused time. Cancel before your renewal date to stop future charges.' },
];
---

<Base
	title={`List your tool in the Toolbox | ${SITE_TITLE}`}
	description={`Add your AI tool to the AI Briefs Toolbox — ${toolCount} tools we test and rate. ${TOOL_LISTING.priceLabel}, cancel any time.`}
	noNudge
>
	<PageHero
		crumbs={[{ name: 'Submit a tool' }]}
		eyebrow="Toolbox listing"
		title="Get your tool in the *Toolbox*."
		lead={`The Toolbox is the reference section readers open when the brief mentions something worth trying. A listing puts your tool in it — ${TOOL_LISTING.priceLabel}, cancel any time.`}
	>
		<div class="hero-points">
			<span><Icon name="check" size={15} /> Details first, payment second</span>
			<span><Icon name="check" size={15} /> Reviewed by a human within 48h</span>
			<span><Icon name="check" size={15} /> Never affects our ratings</span>
		</div>
	</PageHero>

	<div class="container submit-body">
		<div class="submit-grid">
			<div class="submit-col">

				<ol class="stepper" id="stepper" role="list">
					<li class="stepper__item is-active" data-step="1"><span class="stepper__num">1</span> Your tool's details</li>
					<li class="stepper__line" aria-hidden="true"></li>
					<li class="stepper__item" data-step="2"><span class="stepper__num">2</span> Payment</li>
				</ol>

				<!-- ============ STEP 1 — details ============ -->
				<section class="card card--pad panel" id="step-1" aria-label="Your tool's details">
					<p class="panel__intro">
						Tell us about your tool first — nothing is charged on this step. Once your details are saved
						you'll see the price and go through to secure checkout.
					</p>

					<div id="form-error" class="note note--bad" hidden>
						<Icon name="triangle-alert" size={16} />
						<span>Something went wrong saving your details. Please try again or <a href="/contact/">contact us</a> directly.</span>
					</div>

					<form id="submit-form" action={TOOL_LISTING.formspreeUrl} method="POST" novalidate>
						<input type="hidden" name="_subject" value="Tool submission — DETAILS SAVED (unpaid)" />
						<input type="hidden" name="listing-ref" id="listing-ref" value="" />
						<input type="hidden" name="payment-status" value="not paid yet — details step only" />

						<div class="field-row">
							<div class="field">
								<label class="field__label" for="tool-name">Tool name <span class="req" aria-hidden="true">*</span></label>
								<input class="input" type="text" id="tool-name" name="tool-name" required placeholder="e.g. My AI Tool" autocomplete="off" />
							</div>
							<div class="field">
								<label class="field__label" for="tool-url">Website URL <span class="req" aria-hidden="true">*</span></label>
								<input class="input" type="url" id="tool-url" name="tool-url" required placeholder="https://mytool.ai" />
							</div>
						</div>

						<div class="field">
							<div class="field__top">
								<label class="field__label" for="tool-description">Short description <span class="req" aria-hidden="true">*</span></label>
								<span class="field__count mono" id="char-count">0 / 160</span>
							</div>
							<textarea
								class="input"
								id="tool-description"
								name="tool-description"
								required
								maxlength="160"
								rows="3"
								placeholder="What does it do, and who is it for? Be specific."
							></textarea>
						</div>

						<div class="field-row">
							<div class="field">
								<label class="field__label" for="tool-category">Category <span class="req" aria-hidden="true">*</span></label>
								<div class="select-wrap">
									<select class="input" id="tool-category" name="tool-category" required>
										<option value="">Select a category…</option>
										{TOOL_CATEGORIES.map((cat) => <option value={cat.slug}>{cat.name}</option>)}
									</select>
									<Icon name="chevron-down" size={16} class="select-wrap__icon" />
								</div>
							</div>
							<div class="field">
								<label class="field__label" for="tool-pricing">Pricing model <span class="req" aria-hidden="true">*</span></label>
								<div class="select-wrap">
									<select class="input" id="tool-pricing" name="tool-pricing" required>
										<option value="">Select pricing…</option>
										<option value="free">Free</option>
										<option value="freemium">Freemium (free + paid tiers)</option>
										<option value="paid">Paid only</option>
									</select>
									<Icon name="chevron-down" size={16} class="select-wrap__icon" />
								</div>
							</div>
						</div>

						<div class="field">
							<label class="field__label" for="submitter-email">Your email <span class="req" aria-hidden="true">*</span></label>
							<input class="input" type="email" id="submitter-email" name="submitter-email" required placeholder="you@example.com" autocomplete="email" />
							<span class="field__hint">Use the same email at checkout so we can match your payment to this submission.</span>
						</div>

						<div class="field">
							<label class="field__label" for="additional-info">Additional info <span class="field__opt">optional</span></label>
							<textarea
								class="input"
								id="additional-info"
								name="additional-info"
								rows="2"
								placeholder="Anything else we should know? Key features, launch date, special use cases…"
							></textarea>
						</div>

						<label class="check">
							<input type="checkbox" id="terms-check" name="terms-agreed" value="yes" required />
							<span class="check__box" aria-hidden="true"><Icon name="check" size={13} /></span>
							<span class="check__text">I confirm this tool is real, working, and I'm authorised to submit it. I agree to the <a href="/terms/" target="_blank" rel="noopener">Terms of Service</a>.</span>
						</label>

						<button type="submit" class="btn btn--accent btn--lg w-full" id="submit-btn">
							Continue to payment <Icon name="arrow-right" class="icon--arrow" />
						</button>
						<p class="btn-sub">Step 1 of 2 — you won't be charged yet.</p>
					</form>
				</section>

				<!-- ============ STEP 2 — payment ============ -->
				<section class="card card--pad panel" id="step-2" hidden aria-label="Payment">
					<div class="note note--good">
						<Icon name="check" size={16} />
						<span>Details saved for <strong id="saved-name">your tool</strong>. Reference <code id="saved-ref">—</code></span>
					</div>

					<h2 class="panel__title">Complete your listing</h2>

					<div class="order">
						<div class="order__row">
							<div>
								<strong>Toolbox listing</strong>
								<span class="order__sub" id="order-sub">Listed among {toolCount} AI tools</span>
							</div>
							<div class="order__price">
								<span class="order__amt tnum">{TOOL_LISTING.price}</span>
								<span class="order__per">per {TOOL_LISTING.interval}</span>
							</div>
						</div>
						<div class="order__total">
							<span>Due today</span>
							<strong class="tnum">{TOOL_LISTING.price} {TOOL_LISTING.currency}</strong>
						</div>
					</div>

					<div class="terms-box">
						<h3 class="terms-box__title"><Icon name="info" size={15} /> Before you pay — please read</h3>
						<ul class="terms-box__list" role="list">
							<li>
								<strong>This is a recurring subscription.</strong> You are charged
								{TOOL_LISTING.price} {TOOL_LISTING.currency} today and <strong>{TOOL_LISTING.price} every {TOOL_LISTING.interval} after that</strong>,
								automatically, until you cancel.
							</li>
							<li>
								<strong>All payments are non-refundable.</strong> We do not issue refunds or partial
								refunds — including for unused time, part-months, or after a cancellation.
							</li>
							<li>
								<strong>You can cancel any time</strong> from the Polar customer portal linked in your
								receipt email. There is no minimum term and no cancellation fee.
							</li>
							<li>
								<strong>Cancelling removes the listing.</strong> Your tool stays live until the end of the
								{TOOL_LISTING.interval} you have already paid for, then it is automatically taken down from
								the Toolbox at the start of the next billing period.
							</li>
						</ul>
					</div>

					<div class="ack-field">
						<label class="check">
							<input type="checkbox" id="billing-ack" />
							<span class="check__box" aria-hidden="true"><Icon name="check" size={13} /></span>
							<span class="check__text">
								I understand this is a <strong>{TOOL_LISTING.price} {TOOL_LISTING.currency} subscription that renews
								every {TOOL_LISTING.interval} until I cancel</strong>, and that <strong>all payments are non-refundable</strong>.
							</span>
						</label>
					</div>

					<a href="#" class="btn btn--accent btn--lg w-full pay-btn is-disabled" id="pay-btn" aria-disabled="true">
						Pay {TOOL_LISTING.price} and continue <Icon name="arrow-right" class="icon--arrow" />
					</a>
					<p class="btn-sub"><Icon name="lock" size={12} /> Secure checkout by Polar. Card details never touch our servers.</p>

					<button type="button" class="link-back" id="back-btn"><Icon name="arrow-left" size={14} /> Edit my details</button>
				</section>
			</div>

			<!-- Sidebar -->
			<aside class="submit-side">
				<div class="card card--pad side side--price">
					<span class="meta">What it costs</span>
					<p class="side__price"><span class="side__amt tnum">{TOOL_LISTING.price}</span><span class="side__per">/ {TOOL_LISTING.interval}</span></p>
					<p class="side__note">Renews automatically. Cancel any time — payments are non-refundable.</p>
				</div>

				<div class="card card--pad side">
					<h2 class="side__title">What you get</h2>
					<ul class="ilist" role="list">
						{included.map((i) => (
							<li><Icon name={i.icon} size={15} /><span>{i.text}</span></li>
						))}
					</ul>
				</div>

				<div class="card card--pad side side--sunk">
					<h2 class="side__title">What happens next</h2>
					<ol class="steps" role="list">
						<li>
							<span class="steps__num tnum">1</span>
							<div><strong>You pay and we review</strong><p>We check the tool is working, legitimate, and meets our listing criteria.</p></div>
						</li>
						<li>
							<span class="steps__num tnum">2</span>
							<div><strong>Your tool goes live</strong><p>Usually within 48 hours. You'll get an email with the link to your listing.</p></div>
						</li>
						<li>
							<span class="steps__num tnum">3</span>
							<div><strong>It stays live while subscribed</strong><p>Cancel whenever you like — the listing runs to the end of the paid period, then comes down automatically.</p></div>
						</li>
					</ol>
				</div>

				<div class="card card--pad side">
					<h2 class="side__title">Listing criteria</h2>
					<ul class="ilist" role="list">
						{criteria.map((c) => (
							<li class:list={{ 'is-no': !c.ok }}><Icon name={c.ok ? 'check' : 'x'} size={15} /><span>{c.text}</span></li>
						))}
					</ul>
				</div>

				<div class="card card--pad side">
					<h2 class="side__title">Already listed?</h2>
					<p class="side__body">
						To cancel or change your card, use the
						<a href={TOOL_LISTING.portalUrl} target="_blank" rel="noopener noreferrer" class="link-u">Polar customer portal</a> —
						sign in with the email you paid with. To edit your tool's details,
						<a href="/contact/" class="link-u">contact us</a> with "Update Listing" as the subject.
					</p>
				</div>
			</aside>
		</div>

		<section class="section--tight submit-faq" aria-label="Listing questions">
			<div class="section-head">
				<div class="section-head__title">
					<span class="eyebrow">Before you buy</span>
					<h2>Questions people ask</h2>
				</div>
				<a href="/pricing/" class="link-arrow">All pricing questions <Icon name="arrow-right" size={16} /></a>
			</div>
			<Faq items={faq} heading={false} jsonld={false} />
		</section>
	</div>
</Base>

<script define:vars={{ CHECKOUT_URL: TOOL_LISTING.checkoutUrl }} data-astro-rerun>
// ---- Character counter -------------------------------------------------
const textarea = document.getElementById('tool-description');
const counter = document.getElementById('char-count');
textarea?.addEventListener('input', () => {
	const len = textarea.value.length;
	counter.textContent = `${len} / 160`;
	counter.classList.toggle('is-near', len > 140);
});

// ---- Elements ----------------------------------------------------------
const form = document.getElementById('submit-form');
const btn = document.getElementById('submit-btn');
const errorEl = document.getElementById('form-error');
const step1 = document.getElementById('step-1');
const step2 = document.getElementById('step-2');
const stepper = document.getElementById('stepper');
const payBtn = document.getElementById('pay-btn');
const ack = document.getElementById('billing-ack');
const backBtn = document.getElementById('back-btn');

/** Short human-readable reference so a payment can be matched to a submission. */
function makeRef() {
	const rnd = Math.random().toString(36).slice(2, 7).toUpperCase();
	const stamp = Date.now().toString(36).slice(-4).toUpperCase();
	return `AIB-${stamp}${rnd}`;
}

function showStep(n) {
	step1.hidden = n !== 1;
	step2.hidden = n !== 2;
	stepper.querySelectorAll('.stepper__item').forEach(li => {
		li.classList.toggle('is-active', Number(li.dataset.step) === n);
		li.classList.toggle('is-done', Number(li.dataset.step) < n);
	});
	window.scrollTo({ top: stepper.offsetTop - 90, behavior: 'smooth' });
}

// ---- Step 1: save details, then reveal payment -------------------------
form?.addEventListener('submit', async (e) => {
	e.preventDefault();

	// Validation styling only appears once someone has tried to submit.
	form.classList.add('was-validated');

	const urlInput = document.getElementById('tool-url');
	try { new URL(urlInput.value); } catch {
		urlInput.setCustomValidity('Please enter a valid URL including https://');
		urlInput.reportValidity();
		return;
	}
	urlInput.setCustomValidity('');
	if (!form.reportValidity()) return;

	const ref = makeRef();
	document.getElementById('listing-ref').value = ref;

	const btnLabel = btn.innerHTML; // keep the icon: restoring text alone loses it
	btn.disabled = true;
	btn.textContent = 'Saving…';
	errorEl.hidden = true;

	try {
		const res = await fetch(form.action, {
			method: 'POST',
			body: new FormData(form),
			headers: { Accept: 'application/json' },
		});
		if (!res.ok) throw new Error('bad response');

		const submission = {
			ref,
			name: document.getElementById('tool-name').value.trim(),
			url: urlInput.value.trim(),
			email: document.getElementById('submitter-email').value.trim(),
			category: document.getElementById('tool-category').value,
			pricing: document.getElementById('tool-pricing').value,
			description: textarea.value.trim(),
		};
		try { sessionStorage.setItem('aib_submission', JSON.stringify(submission)); } catch {}

		// Fill in the payment step
		document.getElementById('saved-name').textContent = submission.name;
		document.getElementById('saved-ref').textContent = ref;
		document.getElementById('order-sub').textContent = `Listing for ${submission.name}`;

		// Hand the buyer's email + our reference to Polar so the payment can be matched back.
		const checkout = new URL(CHECKOUT_URL);
		checkout.searchParams.set('customer_email', submission.email);
		checkout.searchParams.set('reference_id', ref);
		payBtn.href = checkout.toString();

		showStep(2);
	} catch {
		errorEl.hidden = false;
		errorEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
	} finally {
		btn.disabled = false;
		btn.innerHTML = btnLabel;
	}
});

// ---- Step 2: gate checkout behind the billing acknowledgement ----------
ack?.addEventListener('change', () => {
	payBtn.classList.toggle('is-disabled', !ack.checked);
	payBtn.setAttribute('aria-disabled', String(!ack.checked));
});

payBtn?.addEventListener('click', (e) => {
	if (!ack.checked) {
		e.preventDefault();
		ack.closest('.ack-field').classList.add('shake');
		setTimeout(() => ack.closest('.ack-field').classList.remove('shake'), 500);
	}
});

backBtn?.addEventListener('click', () => showStep(1));
</script>

<style>
	.hero-points { display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-5); margin-top: var(--s-2); }
	.hero-points span { display: inline-flex; align-items: center; gap: 6px; font-size: var(--text-sm); color: var(--ink-3); }
	.hero-points :global(.icon) { color: var(--accent); }

	.submit-body { padding-block: clamp(2rem, 1.5rem + 2.5vw, 3.5rem) var(--section); }
	.submit-grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--s-8); align-items: start; }
	@media (min-width: 960px) { .submit-grid { grid-template-columns: minmax(0, 1fr) 340px; gap: var(--s-10); } }
	.submit-col { min-width: 0; display: grid; gap: var(--s-6); }

	/* ── Stepper ── */
	.stepper { display: flex; align-items: center; gap: var(--s-3); list-style: none; padding: 0; flex-wrap: wrap; }
	.stepper__item {
		display: inline-flex; align-items: center; gap: var(--s-2);
		font-size: var(--text-sm); font-weight: 600; color: var(--ink-4);
		transition: color var(--dur-2) var(--ease-out);
	}
	.stepper__num {
		display: grid; place-items: center; width: 26px; height: 26px; border-radius: 50%;
		font-family: var(--font-mono); font-size: 0.7rem; font-weight: 600;
		background: var(--surface-2); color: var(--ink-3); border: 1px solid var(--line);
		transition: background-color var(--dur-2) var(--ease-out), color var(--dur-2) var(--ease-out);
	}
	.stepper__item.is-active { color: var(--ink); }
	.stepper__item.is-active .stepper__num { background: var(--accent); color: var(--on-accent); border-color: transparent; }
	.stepper__item.is-done .stepper__num { background: var(--ink); color: var(--bg); border-color: transparent; }
	.stepper__line { flex: 1; min-width: 24px; height: 1px; background: var(--line-2); list-style: none; }

	/* ── Panels ── */
	.panel { padding: clamp(1.25rem, 1rem + 2vw, 2.25rem); }
	.panel__intro { color: var(--ink-3); font-size: var(--text-base); margin-bottom: var(--s-6); max-width: 60ch; }
	.panel__title { font-size: var(--text-xl); margin-bottom: var(--s-5); }

	.note {
		display: flex; align-items: flex-start; gap: var(--s-2);
		padding: var(--s-3) var(--s-4); border-radius: var(--r-md);
		font-size: var(--text-sm); margin-bottom: var(--s-5); line-height: 1.5;
	}
	.note :global(.icon) { flex-shrink: 0; margin-top: 3px; }
	.note--bad { background: var(--bad-soft); color: var(--bad); }
	.note--bad :global(a) { color: inherit; font-weight: 600; text-decoration: underline; }
	.note--good { background: var(--good-soft); color: var(--good); }
	.note--good code { font-family: var(--font-mono); font-size: 0.8em; background: rgba(0, 0, 0, 0.08); padding: 0.1em 0.4em; border-radius: 5px; }
	:root[data-theme='dark'] .note--good code { background: rgba(255, 255, 255, 0.1); }

	/* ── Fields ── */
	.field-row { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-4); }
	@media (max-width: 640px) { .field-row { grid-template-columns: 1fr; } }
	.field { display: grid; gap: var(--s-2); margin-bottom: var(--s-5); align-content: start; }
	.field__top { display: flex; align-items: baseline; justify-content: space-between; gap: var(--s-3); }
	.field__label { font-size: var(--text-sm); font-weight: 600; color: var(--ink); }
	.field__opt { font-weight: 400; color: var(--ink-4); font-size: var(--text-xs); margin-left: 4px; }
	.field__hint { font-size: var(--text-xs); color: var(--ink-3); }
	.field__count { color: var(--ink-4); }
	.field__count.is-near { color: var(--accent-ink); }
	.req { color: var(--accent); }
	textarea.input { min-height: 96px; }

	.select-wrap { position: relative; }
	.select-wrap select.input { appearance: none; -webkit-appearance: none; padding-right: 44px; cursor: pointer; }
	:global(.select-wrap__icon) { position: absolute; right: 14px; top: 50%; translate: 0 -50%; pointer-events: none; color: var(--ink-3); }

	/* validation only after a submit attempt */
	.was-validated .input:invalid { border-color: var(--bad); box-shadow: 0 0 0 3px var(--bad-soft); }
	.was-validated .check input:invalid + .check__box { border-color: var(--bad); }

	/* ── Checkbox ── */
	.check { display: flex; align-items: flex-start; gap: var(--s-3); cursor: pointer; margin-bottom: var(--s-5); }
	.check input { position: absolute; opacity: 0; width: 0; height: 0; }
	.check__box {
		flex-shrink: 0; width: 20px; height: 20px; margin-top: 2px;
		border: 1.5px solid var(--line-strong); border-radius: 6px;
		display: grid; place-items: center; color: transparent;
		transition: background-color var(--dur-2) var(--ease-out), border-color var(--dur-2) var(--ease-out), color var(--dur-2) var(--ease-out);
	}
	.check:hover .check__box { border-color: var(--accent); }
	.check input:checked + .check__box { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }
