---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { SITE_TITLE, TOOL_CATEGORIES, TOOL_LISTING } from '../../consts';
---

<!doctype html>
<html lang="en">
<head>
	<BaseHead
		title={`Submit a Tool | ${SITE_TITLE}`}
		description={`List your AI tool in the AI Briefs directory alongside 200+ other tools. ${TOOL_LISTING.priceLabel}, cancel anytime.`}
	/>
</head>
<body>
<Header />

<section class="page-header">
	<div class="container">
		<Breadcrumb crumbs={[{ label: 'Home', href: '/' }, { label: 'Submit a Tool' }]} />
		<h1>Submit a Tool</h1>
		<p>Get your AI tool listed alongside 200+ others. {TOOL_LISTING.priceLabel} — cancel anytime.</p>
	</div>
</section>

<main class="container submit-body">
	<div class="submit-grid">

		<div class="submit-col">

			<!-- Step indicator -->
			<ol class="stepper" id="stepper">
				<li class="stepper__item is-active" data-step="1"><span>1</span> Your tool's details</li>
				<li class="stepper__item" data-step="2"><span>2</span> Payment</li>
			</ol>

			<!-- ============ STEP 1 — details ============ -->
			<div class="submit-card" id="step-1">
				<p class="submit-intro">
					Tell us about your tool first — nothing is charged on this step. Once your details are saved
					you'll be shown the price and taken to secure checkout.
				</p>

				<div id="form-error" class="form-error" hidden>
					Something went wrong saving your details. Please try again or <a href="/contact/">contact us</a> directly.
				</div>

				<form id="submit-form" action={TOOL_LISTING.formspreeUrl} method="POST" novalidate>
					<input type="hidden" name="_subject" value="Tool submission — DETAILS SAVED (unpaid)" />
					<input type="hidden" name="listing-ref" id="listing-ref" value="" />
					<input type="hidden" name="payment-status" value="not paid yet — details step only" />

					<div class="field-row">
						<div class="field">
							<label for="tool-name">Tool Name <span class="req">*</span></label>
							<input type="text" id="tool-name" name="tool-name" required placeholder="e.g. My AI Tool" autocomplete="off" />
						</div>
						<div class="field">
							<label for="tool-url">Website URL <span class="req">*</span></label>
							<input type="url" id="tool-url" name="tool-url" required placeholder="https://mytool.ai" />
						</div>
					</div>

					<div class="field">
						<label for="tool-description">
							Short Description <span class="req">*</span>
							<span class="char-count" id="char-count">0 / 160</span>
						</label>
						<textarea
							id="tool-description"
							name="tool-description"
							required
							maxlength="160"
							rows="3"
							placeholder="What does it do, and who is it for? Be specific. (max 160 characters)"
						></textarea>
					</div>

					<div class="field-row">
						<div class="field">
							<label for="tool-category">Category <span class="req">*</span></label>
							<select id="tool-category" name="tool-category" required>
								<option value="">Select a category…</option>
								{TOOL_CATEGORIES.map(cat => (
									<option value={cat.slug}>{cat.emoji} {cat.name}</option>
								))}
							</select>
						</div>
						<div class="field">
							<label for="tool-pricing">Pricing Model <span class="req">*</span></label>
							<select id="tool-pricing" name="tool-pricing" required>
								<option value="">Select pricing…</option>
								<option value="free">Free</option>
								<option value="freemium">Freemium (free + paid tiers)</option>
								<option value="paid">Paid only</option>
							</select>
						</div>
					</div>

					<div class="field">
						<label for="submitter-email">Your Email <span class="req">*</span></label>
						<input type="email" id="submitter-email" name="submitter-email" required placeholder="you@example.com" autocomplete="email" />
						<span class="field-hint">Use the same email at checkout so we can match your payment to this submission.</span>
					</div>

					<div class="field">
						<label for="additional-info">Additional Info <span class="optional">(optional)</span></label>
						<textarea
							id="additional-info"
							name="additional-info"
							rows="2"
							placeholder="Anything else we should know? Key features, launch date, special use cases…"
						></textarea>
					</div>

					<div class="field field--checkbox">
						<label class="checkbox-label">
							<input type="checkbox" id="terms-check" name="terms-agreed" value="yes" required />
							<span>I confirm this tool is real, working, and I'm authorised to submit it. I agree to the <a href="/terms/" target="_blank">Terms of Service</a>.</span>
						</label>
					</div>

					<button type="submit" class="btn btn--primary submit-btn" id="submit-btn">
						Continue to payment →
					</button>
					<p class="btn-sub">Step 1 of 2 — you won't be charged yet.</p>
				</form>
			</div>

			<!-- ============ STEP 2 — payment ============ -->
			<div class="submit-card pay-card" id="step-2" hidden>
				<div class="saved-note">
					<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
					Details saved for <strong id="saved-name">your tool</strong>. Reference <code id="saved-ref">—</code>
				</div>

				<h2 class="pay-title">Complete your listing</h2>

				<div class="order-box">
					<div class="order-row">
						<div>
							<strong>AI Briefs directory listing</strong>
							<span class="order-sub" id="order-sub">Listed among 200+ AI tools</span>
						</div>
						<div class="order-price">
							<span class="amt">{TOOL_LISTING.price}</span>
							<span class="per">per {TOOL_LISTING.interval}</span>
						</div>
					</div>
					<div class="order-total">
						<span>Due today</span>
						<strong>{TOOL_LISTING.price} {TOOL_LISTING.currency}</strong>
					</div>
				</div>

				<div class="terms-box">
					<h3>Before you pay — please read</h3>
					<ul>
						<li>
							<strong>This is a recurring subscription.</strong> You are charged
							{TOOL_LISTING.price} {TOOL_LISTING.currency} today and <strong>{TOOL_LISTING.price} every {TOOL_LISTING.interval} after that</strong>,
							automatically, until you cancel.
						</li>
						<li>
							<strong>All payments are non-refundable.</strong> We do not issue refunds or partial
							refunds — including for unused time, part-months, or after a cancellation.
						</li>
						<li>
							<strong>You can cancel any time</strong> from the Polar customer portal linked in your
							receipt email. There is no minimum term and no cancellation fee.
						</li>
						<li>
							<strong>Cancelling removes the listing.</strong> Your tool stays live until the end of the
							{TOOL_LISTING.interval} you have already paid for, then it is automatically taken down from
							the directory at the start of the next billing period.
						</li>
						<li>
							Listings are still reviewed. If your tool doesn't meet our
							<a href="/terms/">listing criteria</a> we'll cancel the subscription before the first
							renewal so you are not billed again.
						</li>
					</ul>
				</div>

				<div class="field field--checkbox ack-field">
					<label class="checkbox-label">
						<input type="checkbox" id="billing-ack" />
						<span>
							I understand this is a <strong>{TOOL_LISTING.price} {TOOL_LISTING.currency} subscription that renews
							every {TOOL_LISTING.interval} until I cancel</strong>, and that <strong>all payments are non-refundable</strong>.
						</span>
					</label>
				</div>

				<a href="#" class="btn btn--primary submit-btn pay-btn is-disabled" id="pay-btn" aria-disabled="true">
					Pay {TOOL_LISTING.price} and continue →
				</a>
				<p class="btn-sub">Secure checkout by Polar. Card details never touch our servers.</p>

				<button type="button" class="link-back" id="back-btn">← Edit my details</button>
			</div>

		</div>

		<!-- Sidebar -->
		<aside class="submit-sidebar">
			<div class="info-block info-block--price">
				<h3>What it costs</h3>
				<div class="side-price"><span class="amt">{TOOL_LISTING.price}</span><span class="per">/ {TOOL_LISTING.interval}</span></div>
				<p class="side-note">Renews automatically. Cancel any time — non-refundable.</p>
			</div>

			<div class="info-block">
				<h3>What you get</h3>
				<ul class="criteria-list">
					<li>✓ A permanent page for your tool</li>
					<li>✓ Listed among 200+ AI tools</li>
					<li>✓ Shown on your category pages</li>
					<li>✓ Included in search &amp; comparisons</li>
					<li>✓ Indexed in our sitemap</li>
					<li>✓ Followed link to your site</li>
				</ul>
			</div>

			<div class="info-block info-block--alt">
				<h3>What happens next?</h3>
				<ol class="steps-list">
					<li>
						<span class="step-num">1</span>
						<div>
							<strong>You pay and we review</strong>
							<p>We check the tool is working, legitimate, and meets our listing criteria.</p>
						</div>
					</li>
					<li>
						<span class="step-num">2</span>
						<div>
							<strong>Your tool goes live</strong>
							<p>Usually within 48 hours. You'll get an email with the link to your listing.</p>
						</div>
					</li>
					<li>
						<span class="step-num">3</span>
						<div>
							<strong>It stays live while subscribed</strong>
							<p>Cancel whenever you like — the listing runs to the end of the paid period, then comes down automatically.</p>
						</div>
					</li>
				</ol>
			</div>

			<div class="info-block">
				<h3>Listing criteria</h3>
				<ul class="criteria-list">
					<li>✓ Must use AI as a core feature</li>
					<li>✓ Must have a working product or demo</li>
					<li>✓ Must have a clear pricing model</li>
					<li>✗ No broken, parked, or scam sites</li>
					<li>✗ No pure white-label repackaging</li>
				</ul>
			</div>

			<div class="info-block">
				<h3>Already listed?</h3>
				<p>Need to update your tool's info or cancel? <a href="/contact/">Contact us</a> with "Update Listing" as the subject.</p>
			</div>
		</aside>

	</div>
</main>

<Footer />
</body>
</html>

<script define:vars={{ CHECKOUT_URL: TOOL_LISTING.checkoutUrl }} data-astro-rerun>
// ---- Character counter -------------------------------------------------
const textarea = document.getElementById('tool-description');
const counter = document.getElementById('char-count');
textarea?.addEventListener('input', () => {
	const len = textarea.value.length;
	counter.textContent = `${len} / 160`;
	counter.style.color = len > 140 ? '#e53e3e' : 'rgb(var(--gray))';
});

// ---- Elements ----------------------------------------------------------
const form = document.getElementById('submit-form');
const btn = document.getElementById('submit-btn');
const errorEl = document.getElementById('form-error');
const step1 = document.getElementById('step-1');
const step2 = document.getElementById('step-2');
const stepper = document.getElementById('stepper');
const payBtn = document.getElementById('pay-btn');
const ack = document.getElementById('billing-ack');
const backBtn = document.getElementById('back-btn');

/** Short human-readable reference so a payment can be matched to a submission. */
function makeRef() {
	const rnd = Math.random().toString(36).slice(2, 7).toUpperCase();
	const stamp = Date.now().toString(36).slice(-4).toUpperCase();
	return `AIB-${stamp}${rnd}`;
}

function showStep(n) {
	step1.hidden = n !== 1;
	step2.hidden = n !== 2;
	stepper.querySelectorAll('.stepper__item').forEach(li => {
		li.classList.toggle('is-active', Number(li.dataset.step) === n);
		li.classList.toggle('is-done', Number(li.dataset.step) < n);
	});
	window.scrollTo({ top: stepper.offsetTop - 90, behavior: 'smooth' });
}

// ---- Step 1: save details, then reveal payment -------------------------
form?.addEventListener('submit', async (e) => {
	e.preventDefault();

	const urlInput = document.getElementById('tool-url');
	try { new URL(urlInput.value); } catch {
		urlInput.setCustomValidity('Please enter a valid URL including https://');
		urlInput.reportValidity();
		return;
	}
	urlInput.setCustomValidity('');
	if (!form.reportValidity()) return;

	const ref = makeRef();
	document.getElementById('listing-ref').value = ref;

	btn.disabled = true;
	btn.textContent = 'Saving…';
	errorEl.hidden = true;

	try {
		const res = await fetch(form.action, {
			method: 'POST',
			body: new FormData(form),
			headers: { Accept: 'application/json' },
		});
		if (!res.ok) throw new Error('bad response');

		const submission = {
			ref,
			name: document.getElementById('tool-name').value.trim(),
			url: urlInput.value.trim(),
			email: document.getElementById('submitter-email').value.trim(),
			category: document.getElementById('tool-category').value,
			pricing: document.getElementById('tool-pricing').value,
			description: textarea.value.trim(),
		};
		try { sessionStorage.setItem('aib_submission', JSON.stringify(submission)); } catch {}

		// Fill in the payment step
		document.getElementById('saved-name').textContent = submission.name;
		document.getElementById('saved-ref').textContent = ref;
		document.getElementById('order-sub').textContent = `Listing for ${submission.name}`;

		// Hand the buyer's email + our reference to Polar so the payment can be matched back.
		const checkout = new URL(CHECKOUT_URL);
		checkout.searchParams.set('customer_email', submission.email);
		checkout.searchParams.set('reference_id', ref);
		payBtn.href = checkout.toString();

		showStep(2);
	} catch {
		errorEl.hidden = false;
		errorEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
	} finally {
		btn.disabled = false;
		btn.textContent = 'Continue to payment →';
	}
});

// ---- Step 2: gate checkout behind the billing acknowledgement ----------
ack?.addEventListener('change', () => {
	payBtn.classList.toggle('is-disabled', !ack.checked);
	payBtn.setAttribute('aria-disabled', String(!ack.checked));
});

payBtn?.addEventListener('click', (e) => {
	if (!ack.checked) {
		e.preventDefault();
		ack.closest('.ack-field').classList.add('shake');
		setTimeout(() => ack.closest('.ack-field').classList.remove('shake'), 500);
	}
});

backBtn?.addEventListener('click', () => showStep(1));
</script>

<style>
.page-header {
	background: linear-gradient(135deg, var(--primary-light) 0%, var(--bg) 100%);
	border-bottom: 1px solid var(--border);
	padding: 2.5rem 0 2rem;
}
.page-header h1 { font-size: clamp(1.8rem, 4vw, 2.4rem); margin: 0.5rem 0 0.4rem; }
.page-header p { color: rgb(var(--gray)); }

.submit-body { padding: 2.5rem 0 5rem; }

.submit-grid {
	display: grid;
	grid-template-columns: 1fr;
	gap: 2rem;
}
@media (min-width: 900px) {
	.submit-grid { grid-template-columns: 1fr 300px; align-items: start; }
}
.submit-col { min-width: 0; }

/* Stepper */
.stepper {
	list-style: none; padding: 0; margin: 0 0 1.25rem;
	display: flex; gap: 0.5rem; flex-wrap: wrap;
}
.stepper__item {
	display: flex; align-items: center; gap: 0.5rem;
	font-size: 0.82rem; font-weight: 600;
	color: rgb(var(--gray));
	padding: 0.45rem 0.9rem 0.45rem 0.45rem;
	border: 1px solid var(--border);
	border-radius: 999px;
	background: var(--bg);
}
.stepper__item span {
	width: 22px; height: 22px; flex-shrink: 0;
	border-radius: 50%;
	display: flex; align-items: center; justify-content: center;
	font-size: 0.72rem; font-weight: 800;
	background: var(--bg-alt); color: rgb(var(--gray));
}
.stepper__item.is-active { color: rgb(var(--black)); border-color: var(--primary); }
.stepper__item.is-active span { background: var(--primary); color: #fff; }
.stepper__item.is-done span { background: #00875a; color: #fff; }

/* Cards */
.submit-card {
	background: var(--bg);
	border: 1px solid var(--border);
	border-radius: var(--radius);
	padding: 2rem;
}
.submit-intro { color: rgb(var(--gray)); font-size: 0.93rem; margin-bottom: 1.5rem; line-height: 1.65; }

.form-error {
	background: #fff0f0; color: #c53030;
	border: 1px solid #c5303033;
	border-radius: var(--radius);
	padding: 0.85rem 1rem;
	font-size: 0.9rem;
	margin-bottom: 1.25rem;
}
.form-error a { color: #c53030; font-weight: 600; }

.field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
@media (max-width: 600px) { .field-row { grid-template-columns: 1fr; } }

.field { display: flex; flex-direction: column; gap: 0.35rem; margin-bottom: 1rem; }
.field label { font-size: 0.85rem; font-weight: 700; color: rgb(var(--black)); display: flex; align-items: center; justify-content: space-between; }
.req { color: #e53e3e; }
.optional { font-weight: 400; color: rgb(var(--gray)); font-size: 0.78rem; }
.char-count { font-size: 0.75rem; font-weight: 400; color: rgb(var(--gray)); }
.field-hint { font-size: 0.75rem; color: rgb(var(--gray)); margin-top: 0.1rem; }

.field input,
.field select,
.field textarea {
	padding: 0.65rem 0.9rem;
	border: 1.5px solid var(--border);
	border-radius: var(--radius);
	font-size: 0.9rem;
	font-family: inherit;
	background: var(--bg);
	color: rgb(var(--black));
	transition: border-color 0.15s;
	width: 100%;
}
.field input:focus,
.field select:focus,
.field textarea:focus { outline: none; border-color: var(--primary); }
.field textarea { resize: vertical; min-height: 80px; }

.field--checkbox { flex-direction: row; align-items: flex-start; gap: 0; }
.checkbox-label {
	display: flex; align-items: flex-start; gap: 0.6rem;
	font-size: 0.83rem; color: rgb(var(--gray-dark));
	cursor: pointer; line-height: 1.55;
}
.checkbox-label input[type="checkbox"] { width: 16px; height: 16px; flex-shrink: 0; margin-top: 2px; accent-color: var(--primary); cursor: pointer; }
.checkbox-label a { color: var(--primary); }

.submit-btn {
	width: 100%; padding: 0.9rem;
	font-size: 1rem; cursor: pointer;
	margin-top: 0.25rem;
}
.submit-btn:disabled { opacity: 0.6; cursor: not-allowed; }
.btn-sub { text-align: center; font-size: 0.76rem; color: rgb(var(--gray)); margin: 0.6rem 0 0; }

/* ---- Payment step ---- */
.saved-note {
	display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;
	background: #e0f5ee; color: #00875a;
	border: 1px solid #00875a33;
	border-radius: var(--radius);
	padding: 0.75rem 1rem;
	font-size: 0.85rem; font-weight: 600;
	margin-bottom: 1.5rem;
}
.saved-note code { background: #00875a1a; padding: 0.1rem 0.4rem; border-radius: 4px; font-size: 0.8rem; }

.pay-title { font-size: 1.25rem; margin: 0 0 1rem; }

.order-box {
	border: 1px solid var(--border);
	border-radius: var(--radius);
	overflow: hidden;
	margin-bottom: 1.25rem;
}
.order-row {
	display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem;
	padding: 1rem 1.1rem;
}
.order-row strong { display: block; font-size: 0.92rem; }
.order-sub { display: block; font-size: 0.8rem; color: rgb(var(--gray)); margin-top: 0.15rem; }
.order-price { text-align: right; white-space: nowrap; }
.order-price .amt { display: block; font-size: 1.15rem; font-weight: 800; }
.order-price .per { font-size: 0.75rem; color: rgb(var(--gray)); }
.order-total {
	display: flex; justify-content: space-between; align-items: center;
	padding: 0.85rem 1.1rem;
	background: var(--bg-alt);
	border-top: 1px solid var(--border);
	font-size: 0.9rem;
}
.order-total strong { font-size: 1rem; }

.terms-box {
	background: #fffaf0;
	border: 1px solid #dd6b2033;
	border-left: 3px solid #dd6b20;
	border-radius: var(--radius);
	padding: 1.1rem 1.25rem;
	margin-bottom: 1.25rem;
}
.terms-box h3 { font-size: 0.9rem; margin: 0 0 0.7rem; color: #9c4221; }
.terms-box ul { margin: 0; padding-left: 1.1rem; display: flex; flex-direction: column; gap: 0.55rem; }
.terms-box li { font-size: 0.84rem; line-height: 1.6; color: rgb(var(--gray-dark)); }
.terms-box a { color: #9c4221; font-weight: 600; }

.ack-field { margin-bottom: 1.1rem; border-radius: var(--radius); }
.ack-field.shake { animation: shake 0.4s; }
@keyframes shake {
	0%, 100% { transform: translateX(0); }
	25% { transform: translateX(-5px); }
	75% { transform: translateX(5px); }
}

.pay-btn { display: block; text-align: center; text-decoration: none; }
.pay-btn.is-disabled { opacity: 0.5; cursor: not-allowed; }

.link-back {
	display: block; margin: 1.1rem auto 0;
	background: none; border: none;
	color: rgb(var(--gray)); font-size: 0.83rem;
	cursor: pointer; font-family: inherit;
	text-decoration: underline;
}

/* Sidebar */
.submit-sidebar { display: flex; flex-direction: column; gap: 1rem; }
.info-block {
	padding: 1.25rem 1.4rem;
	border: 1px solid var(--border);
	border-radius: var(--radius);
	background: var(--bg);
}
.info-block--alt { background: var(--bg-alt); }
.info-block--price { border-color: var(--primary); }
.info-block h3 { font-size: 0.95rem; margin-bottom: 0.85rem; }
.info-block p { font-size: 0.83rem; color: rgb(var(--gray-dark)); margin: 0; line-height: 1.6; }
.info-block a { color: var(--primary); font-weight: 600; }

.side-price { display: flex; align-items: baseline; gap: 0.35rem; margin-bottom: 0.4rem; }
.side-price .amt { font-size: 1.75rem; font-weight: 800; color: rgb(var(--black)); }
.side-price .per { font-size: 0.85rem; color: rgb(var(--gray)); }
.side-note { font-size: 0.78rem !important; color: rgb(var(--gray)) !important; }

.steps-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.85rem; }
.steps-list li { display: flex; align-items: flex-start; gap: 0.75rem; }
.step-num {
	width: 24px; height: 24px;
	background: var(--primary);
	color: #fff;
	border-radius: 50%;
	display: flex; align-items: center; justify-content: center;
	font-size: 0.75rem; font-weight: 800;
	flex-shrink: 0; margin-top: 1px;
}
.steps-list strong { display: block; font-size: 0.85rem; margin-bottom: 0.2rem; }
