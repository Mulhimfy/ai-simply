---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import Stars from '../components/Stars.astro';
import { SITE_TITLE, SITE_URL } from '../consts';
import { RATING_CRITERIA, RATING_PROCESS } from '../data/rating-criteria';

const totalWeight = RATING_CRITERIA.reduce((n, c) => n + c.weight, 0);
/** Heaviest first — the page is about what counts most. */
const criteria = [...RATING_CRITERIA].sort((a, b) => b.weight - a.weight);

const bands = [
	{ rating: 5, label: 'Exceptional', range: '5.0', text: 'Best in its category on output quality, ease of use and value. We would recommend it without a caveat.' },
	{ rating: 4.5, label: 'Very good', range: '4.0 – 4.9', text: 'A strong performer with minor gaps. The right answer for most people, most of the time.' },
	{ rating: 3.5, label: 'Good', range: '3.0 – 3.9', text: 'Solid, with real limitations. Worth it for a specific need rather than as a default choice.' },
	{ rating: 2.5, label: 'Below average', range: '2.0 – 2.9', text: 'Has potential but falls short somewhere that matters. Check the alternatives first.' },
	{ rating: 1.5, label: 'Poor', range: '1.0 – 1.9', text: 'Significant problems with quality, reliability or pricing. We would not recommend it today.' },
];

const ld = {
	'@context': 'https://schema.org',
	'@type': 'WebPage',
	name: 'Rating methodology',
	url: `${SITE_URL}/rating-methodology/`,
	description: `How ${SITE_TITLE} scores AI tools: five weighted criteria, hands-on testing, and no paid influence.`,
};
---

<Base
	title={`Rating methodology — how we score AI tools | ${SITE_TITLE}`}
	description="Five weighted criteria, hands-on testing by at least two editors, and a rating that money cannot move. Exactly how every score in the Toolbox is produced."

	noNudge>
	<script type="application/ld+json" slot="head" set:html={JSON.stringify(ld)} />

	<PageHero
		crumbs={[{ name: 'Rating methodology' }]}
		eyebrow="Ratings"
		title="How we *score* a tool"
		lead="Every star rating in the Toolbox is a weighted average of the same five criteria, applied by hand after we have used the tool on real work. Here is the whole formula, including what it deliberately ignores."
	>
		<div class="hero-points">
			<span><Icon name="scale" size={15} /> Five criteria, fixed weights</span>
			<span><Icon name="hand" size={15} /> Two editors, one week minimum</span>
			<span><Icon name="shield-check" size={15} /> Paying changes nothing</span>
		</div>
	</PageHero>

	<section class="section section--tight" aria-labelledby="crit-title">
		<div class="container">
			<div class="section-head">
				<div class="section-head__title">
					<span class="eyebrow">The formula</span>
					<h2 id="crit-title">Five criteria, weighted</h2>
					<p class="section-head__desc">
						Each tool is scored out of 5.0 on each criterion, then combined into one weighted average and rounded
						to a single decimal place. The weights below add up to {totalWeight}% and do not change between tools.
					</p>
				</div>
			</div>

			<div class="weights" aria-hidden="true">
				{criteria.map((c) => (
					<span class="weights__seg" style={`--w:${c.weight}`} data-name={c.name}>
						<span class="weights__pct tnum">{c.weight}%</span>
					</span>
				))}
			</div>

			<ol class="crits" role="list" data-stagger>
				{criteria.map((c) => (
					<li class="crit card card--pad" data-reveal>
						<div class="crit__head">
							<span class="crit__icon"><Icon name={c.icon} size={19} /></span>
							<div class="crit__id">
								<h3 class="crit__name">{c.name}</h3>
								<p class="crit__short">{c.short}</p>
							</div>
							<span class="crit__w tnum">{c.weight}<span class="crit__w-unit">%</span></span>
						</div>
						<div class="crit__bar" role="presentation"><span style={`--w:${c.weight * 2}%`}></span></div>
						<p class="crit__desc">{c.description}</p>
					</li>
				))}
			</ol>
		</div>
	</section>

	<section class="section section--tight" aria-labelledby="scale-title">
		<div class="container">
			<div class="section-head">
				<div class="section-head__title">
					<span class="eyebrow">The scale</span>
					<h2 id="scale-title">What the <em class="serif">stars</em> mean</h2>
					<p class="section-head__desc">A 3.0 is a genuinely useful tool with caveats, not a failure. We use the whole scale.</p>
				</div>
				<a href="/tools/top-rated/" class="link-arrow">See the top-rated tools <Icon name="arrow-right" size={16} /></a>
			</div>
			<ul class="bands" role="list" data-stagger>
				{bands.map((b) => (
					<li class="band" data-reveal>
						<span class="band__stars"><Stars rating={b.rating} size={16} showNumber={false} /></span>
						<span class="band__range tnum">{b.range}</span>
						<div class="band__copy">
							<h3 class="band__label">{b.label}</h3>
							<p class="band__text">{b.text}</p>
						</div>
					</li>
				))}
			</ul>
		</div>
	</section>

	<section class="section section--tight" aria-labelledby="process-title">
		<div class="container">
			<div class="section-head">
				<div class="section-head__title">
					<span class="eyebrow">The process</span>
					<h2 id="process-title">From “someone submitted this” to a <em class="serif">number</em></h2>
				</div>
			</div>
			<ol class="steps" role="list" data-stagger>
				{RATING_PROCESS.map((s) => (
					<li class="pstep" data-reveal>
						<span class="pstep__n tnum">{String(s.step).padStart(2, '0')}</span>
						<h3 class="pstep__title">{s.name}</h3>
						<p class="pstep__text">{s.text}</p>
					</li>
				))}
			</ol>
		</div>
	</section>

	<section class="section section--tight" aria-labelledby="indep-title">
		<div class="container container--narrow">
			<article class="indep card card--pad">
				<span class="indep__icon"><Icon name="shield-check" size={22} /></span>
				<span class="eyebrow">Independence</span>
				<h2 class="indep__title" id="indep-title">What money buys, and what it doesn't</h2>
				<p>
					{SITE_TITLE} is funded by tool makers who pay for a listing in the Toolbox, and by affiliate links that
					are labelled where they appear. That pays for the site. It does not buy a score.
				</p>
				<ul class="indep__list" role="list">
					<li><Icon name="check" size={15} /> A paid listing gets a page, and nothing else a free listing wouldn't get.</li>
					<li><Icon name="check" size={15} /> A rating is never raised, lowered or withheld because of a commercial relationship.</li>
					<li><Icon name="check" size={15} /> Sponsored and affiliate placements are labelled on the page they appear on.</li>
					<li><Icon name="check" size={15} /> A listing whose tool stops working is removed — the payment is not refunded, and that is not a reason to keep it up.</li>
				</ul>
				<p class="indep__foot">
					Think a rating is wrong or out of date? <a href="/contact/" class="link-u">Tell us what we missed</a> —
					that is how most re-tests start. The commercial terms are in the
					<a href="/terms/" class="link-u">Terms of Service</a>.
				</p>
			</article>
		</div>
	</section>
</Base>

<style>
	.hero-points { display: flex; flex-wrap: wrap; gap: var(--s-3) var(--s-6); }
	.hero-points span { display: inline-flex; align-items: center; gap: 8px; font-size: var(--text-sm); color: var(--ink-2); }
	.hero-points :global(.icon) { color: var(--accent); flex-shrink: 0; }

	/* ── Weight bar ── */
	.weights {
		display: flex; height: 44px; margin-bottom: var(--s-8);
		border-radius: var(--r-full); overflow: hidden; border: 1px solid var(--line);
	}
	.weights__seg {
		flex: var(--w) 1 0; display: grid; place-items: center; min-width: 0;
		background: var(--accent); color: var(--on-accent);
		border-right: 2px solid var(--bg);
	}
	.weights__seg:last-child { border-right: 0; }
	.weights__pct { font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 600; }

	/* ── Criteria ── */
	.crits { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-5); }
	@media (max-width: 860px) { .crits { grid-template-columns: minmax(0, 1fr); } }
	.crit { display: grid; gap: var(--s-4); align-content: start; }
	.crit:first-child { grid-column: 1 / -1; }
	.crit__head { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; gap: var(--s-4); align-items: start; }
	.crit__icon {
		display: grid; place-items: center; width: 42px; height: 42px; border-radius: var(--r-sm);
		background: var(--accent-soft); color: var(--accent-ink);
	}
	.crit__id { min-width: 0; display: grid; gap: 3px; }
	.crit__name { font-size: var(--text-lg); }
	.crit__short { font-size: var(--text-sm); color: var(--ink-3); line-height: 1.5; }
	.crit__w {
		font-size: var(--text-2xl); font-weight: 600; letter-spacing: -0.04em; line-height: 1; color: var(--ink);
	}
	.crit__w-unit { font-size: var(--text-sm); color: var(--ink-3); margin-left: 1px; }
	.crit__bar { height: 5px; border-radius: var(--r-full); background: var(--surface-2); overflow: hidden; }
	.crit__bar > span { display: block; height: 100%; width: min(100%, var(--w)); border-radius: inherit; background: var(--accent); }
	.crit__desc { font-size: var(--text-sm); color: var(--ink-2); line-height: 1.7; }

	/* ── Star bands ── */
	.bands { border-top: 1px solid var(--line); }
	.band {
		display: grid; grid-template-columns: 110px 92px minmax(0, 1fr); gap: var(--s-5);
		align-items: baseline; padding: var(--s-5) 0; border-bottom: 1px solid var(--line);
	}
	.band__stars { color: var(--accent); line-height: 1; }
	.band__range { font-family: var(--font-mono); font-size: var(--text-sm); color: var(--ink-3); }
	.band__label { font-size: var(--text-base); margin-bottom: 3px; }
	.band__text { font-size: var(--text-sm); color: var(--ink-3); line-height: 1.6; }
	@media (max-width: 700px) {
		.band { grid-template-columns: auto auto; gap: var(--s-2) var(--s-4); align-items: center; }
		.band__copy { grid-column: 1 / -1; }
	}

	/* ── Process ── */
	.steps { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--s-6); }
	@media (max-width: 900px) { .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-8) var(--s-6); } }
	@media (max-width: 540px) { .steps { grid-template-columns: minmax(0, 1fr); } }
	.pstep { display: grid; gap: var(--s-2); align-content: start; padding-top: var(--s-4); border-top: 2px solid var(--line-2); }
	.pstep__n { font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 600; color: var(--accent); letter-spacing: 0.04em; }
	.pstep__title { font-size: var(--text-base); }
	.pstep__text { font-size: var(--text-sm); color: var(--ink-3); line-height: 1.65; }

	/* ── Independence ── */
	.indep { display: grid; gap: var(--s-4); padding: clamp(1.5rem, 1.2rem + 2.4vw, 2.75rem); }
	.indep__icon {
		display: grid; place-items: center; width: 48px; height: 48px; border-radius: var(--r-full);
		background: var(--good-soft); color: var(--good);
	}
	.indep__title { font-size: var(--text-2xl); }
	.indep p { color: var(--ink-2); line-height: 1.7; }
	.indep__list { display: grid; gap: var(--s-3); padding-top: var(--s-2); }
	.indep__list li { display: flex; align-items: flex-start; gap: var(--s-3); font-size: var(--text-sm); color: var(--ink-2); line-height: 1.55; }
	.indep__list :global(.icon) { flex-shrink: 0; margin-top: 3px; color: var(--good); }
	.indep__foot {
		font-size: var(--text-sm); color: var(--ink-3); line-height: 1.7;
		padding-top: var(--s-4); border-top: 1px solid var(--line);
	}
</style>
