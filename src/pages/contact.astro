---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { SITE_TITLE, TOOL_LISTING } from '../consts';

/** Formspree endpoint — same inbox as the listing form. Do not change. */
const FORMSPREE_URL = 'https://formspree.io/f/xkopzklp';

/** `value` is what lands in the inbox; `?subject=` matches on it (case-insensitively). */
const subjects = [
	{ value: 'Update Listing', label: 'Claim or update a listing' },
	{ value: 'Submit a Tool', label: 'Suggest a tool for the Toolbox' },
	{ value: 'Report an Error', label: 'Report an error or a broken link' },
	{ value: 'Featured Listing', label: 'Featured listing (waitlist)' },
	{ value: 'Advertising / Partnership', label: 'Advertising or partnership' },
	{ value: 'Press Enquiry', label: 'Press enquiry' },
	{ value: 'Technical Issue', label: 'Something on the site is broken' },
	{ value: 'General Question', label: 'Something else' },
];

const routes = [
	{
		icon: 'credit-card',
		title: 'Billing and cancelling',
		body: 'Cancel a listing, change a card or find a receipt — all self-serve in the Polar customer portal. Sign in with the email you paid with.',
		href: TOOL_LISTING.portalUrl,
		cta: 'Open the customer portal',
		external: true,
	},
	{
		icon: 'plus',
		title: 'List your tool',
		body: `A page in the Toolbox is ${TOOL_LISTING.priceLabel}, reviewed by a human within 48 hours, cancel any time.`,
		href: '/submit/',
		cta: 'Submit a tool',
	},
	{
		icon: 'star',
		title: 'Think a rating is wrong?',
		body: 'Tell us what we got wrong and we will re-test. Ratings are never changed for money — see how they are made.',
		href: '/rating-methodology/',
		cta: 'Read the methodology',
	},
];
---

<Base
	title={`Contact | ${SITE_TITLE}`}
	description="Get in touch with AI Briefs — report an error, claim a listing, suggest a tool, or ask about billing."
	noNudge
>
	<PageHero
		crumbs={[{ name: 'Contact' }]}
		eyebrow="Contact"
		title="Tell us what we got *wrong*."
		lead="Corrections, claims, tool suggestions, billing questions and press — this form reaches a person. We answer within one or two business days."
	/>

	<div class="container contact-body">
		<div class="contact-grid">
			<section class="card card--pad panel" aria-labelledby="form-title">
				<h2 class="panel__title" id="form-title">Send a message</h2>

				<div id="claim-note" class="note note--accent" hidden>
					<Icon name="badge-check" size={16} />
					<span>You're claiming the listing for <strong id="claim-tool">this tool</strong>. Tell us what needs to change and email us from an address at the tool's domain if you can — it makes verification instant.</span>
				</div>

				<form id="contact-form" action={FORMSPREE_URL} method="POST" novalidate>
					<div class="field-row">
						<div class="field">
							<label class="field__label" for="name">Your name <span class="req" aria-hidden="true">*</span></label>
							<input class="input" type="text" id="name" name="name" required placeholder="Jane Smith" autocomplete="name" />
						</div>
						<div class="field">
							<label class="field__label" for="email">Email address <span class="req" aria-hidden="true">*</span></label>
							<input class="input" type="email" id="email" name="email" required placeholder="jane@example.com" autocomplete="email" />
						</div>
					</div>

					<div class="field">
						<label class="field__label" for="subject">What's this about? <span class="req" aria-hidden="true">*</span></label>
						<div class="select-wrap">
							<select class="input" id="subject" name="subject" required>
								<option value="" disabled selected>Select a topic…</option>
								{subjects.map((s) => <option value={s.value}>{s.label}</option>)}
							</select>
							<Icon name="chevron-down" size={16} class="select-wrap__icon" />
						</div>
					</div>

					<div class="field">
						<label class="field__label" for="message">Message <span class="req" aria-hidden="true">*</span></label>
						<textarea class="input" id="message" name="message" rows="7" required placeholder="Be specific — a URL and what you expected to see is usually enough."></textarea>
					</div>

					<input type="hidden" name="_subject" value="New contact from AI Briefs" />
					<input type="hidden" name="tool" id="tool-field" value="" />

					<div class="form-foot">
						<button type="submit" class="btn btn--accent btn--lg" id="submit-btn">Send message <Icon name="arrow-right" class="icon--arrow" /></button>
						<p class="form-note"><Icon name="clock" size={13} /> We reply within 1–2 business days.</p>
					</div>

					<div id="form-success" class="note note--good" hidden>
						<Icon name="check" size={16} />
						<span>Message sent. We'll be in touch at the address you gave us.</span>
					</div>
					<div id="form-error" class="note note--bad" hidden>
						<Icon name="triangle-alert" size={16} />
						<span>Something went wrong sending that. Try again, or email <a href="mailto:hello@getaibriefs.com">hello@getaibriefs.com</a> directly.</span>
					</div>
				</form>
			</section>

			<aside class="contact-aside" aria-label="Other ways to get this sorted">
				<p class="aside__lead meta">Faster than the form</p>
				{routes.map((r) => (
					<article class="route card card--pad card--sunk">
						<span class="route__icon"><Icon name={r.icon} size={16} /></span>
						<h3 class="route__title">{r.title}</h3>
						<p class="route__body">{r.body}</p>
						<a
							href={r.href}
							class="link-arrow route__cta"
							target={r.external ? '_blank' : undefined}
							rel={r.external ? 'noopener noreferrer' : undefined}
						>{r.cta} <Icon name={r.external ? 'external-link' : 'arrow-right'} size={15} /></a>
					</article>
				))}
				<p class="aside__fine">
					Prefer email? <a href="mailto:hello@getaibriefs.com" class="link-u">hello@getaibriefs.com</a>.
					We don't have a phone number and we don't take unsolicited guest posts.
				</p>
			</aside>
		</div>
	</div>
</Base>

<script data-astro-rerun>
const form = document.getElementById('contact-form');
const btn = document.getElementById('submit-btn');
const success = document.getElementById('form-success');
const error = document.getElementById('form-error');
const select = document.getElementById('subject');
const message = document.getElementById('message');

// ---- Prefill from the query string ------------------------------------
// `?subject=Featured+Listing` matches an option value directly.
// `?subject=claim&tool=Name` (from every tool page) maps to "Update Listing".
const params = new URLSearchParams(location.search);
const pre = (params.get('subject') || '').trim();
const tool = (params.get('tool') || '').trim().slice(0, 120);

const ALIASES = {
	claim: 'Update Listing',
	'claim listing': 'Update Listing',
	update: 'Update Listing',
	error: 'Report an Error',
	press: 'Press Enquiry',
	featured: 'Featured Listing',
};

if (pre && select) {
	const wanted = (ALIASES[pre.toLowerCase()] || pre).toLowerCase();
	const match = Array.from(select.options).find((o) => o.value.toLowerCase() === wanted);
	if (match) select.value = match.value;
}

if (tool) {
	const toolField = document.getElementById('tool-field');
	if (toolField) toolField.value = tool;
	const isClaim = ALIASES[pre.toLowerCase()] === 'Update Listing' || pre.toLowerCase() === 'update listing';
	if (message && !message.value) {
		message.value = isClaim
			? `I'd like to claim the listing for ${tool}.\n\nWhat needs changing:\n- `
			: `About ${tool}:\n\n`;
	}
	if (isClaim) {
		const note = document.getElementById('claim-note');
		const name = document.getElementById('claim-tool');
		if (name) name.textContent = tool;
		if (note) note.hidden = false;
	}
}

// ---- Submit ------------------------------------------------------------
form?.addEventListener('submit', async (e) => {
	e.preventDefault();
	form.classList.add('was-validated');
	if (!form.checkValidity()) {
		form.querySelector(':invalid')?.focus();
		return;
	}
	btn.disabled = true;
	btn.textContent = 'Sending…';
	success.hidden = true;
	error.hidden = true;
	try {
		const res = await fetch(form.action, {
			method: 'POST',
			body: new FormData(form),
			headers: { Accept: 'application/json' },
		});
		if (res.ok) {
			success.hidden = false;
			form.reset();
			form.classList.remove('was-validated');
		} else {
			error.hidden = false;
		}
	} catch {
		error.hidden = false;
	} finally {
		btn.disabled = false;
		btn.textContent = 'Send message';
	}
});
</script>

<style>
	.contact-body { padding-block: clamp(2rem, 1.6rem + 2.4vw, 3.5rem) var(--section); }
	.contact-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 320px); gap: var(--s-10); align-items: start; }
	@media (max-width: 940px) { .contact-grid { grid-template-columns: minmax(0, 1fr); gap: var(--s-8); } }

	.panel { padding: clamp(1.25rem, 1rem + 2vw, 2.25rem); }
	.panel__title { font-size: var(--text-xl); margin-bottom: var(--s-6); }

	/* ── Notes ── */
	.note {
		display: flex; align-items: flex-start; gap: var(--s-3);
		padding: var(--s-4); border-radius: var(--r-md);
		font-size: var(--text-sm); line-height: 1.6; margin-bottom: var(--s-6);
	}
	.note :global(.icon) { flex-shrink: 0; margin-top: 3px; }
	.note--accent { background: var(--accent-soft); color: var(--ink-2); }
	.note--accent :global(.icon) { color: var(--accent); }
	.note--accent strong { color: var(--ink); }
	.note--good { background: var(--good-soft); color: var(--good); margin: var(--s-5) 0 0; }
	.note--bad { background: var(--bad-soft); color: var(--bad); margin: var(--s-5) 0 0; }
	.note--bad :global(a) { color: inherit; font-weight: 600; text-decoration: underline; }

	/* ── Fields ── */
	.field-row { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-4); }
	@media (max-width: 640px) { .field-row { grid-template-columns: 1fr; } }
	.field { display: grid; gap: var(--s-2); margin-bottom: var(--s-5); align-content: start; }
	.field__label { font-size: var(--text-sm); font-weight: 600; color: var(--ink); }
	.req { color: var(--accent); }

	.select-wrap { position: relative; }
	.select-wrap select { appearance: none; padding-right: 2.75rem; cursor: pointer; }
	:global(.select-wrap__icon) { position: absolute; right: 14px; top: 50%; translate: 0 -50%; color: var(--ink-3); pointer-events: none; }

	textarea.input { min-height: 160px; }

	/* Validation styling only after a submit attempt. */
	.was-validated .input:invalid { border-color: var(--bad); }
	.was-validated .input:invalid:focus { box-shadow: 0 0 0 4px var(--bad-soft); }

	.form-foot { display: flex; align-items: center; gap: var(--s-5); flex-wrap: wrap; margin-top: var(--s-2); }
	.form-note { display: inline-flex; align-items: center; gap: 6px; font-size: var(--text-xs); color: var(--ink-3); }
	@media (max-width: 520px) { .form-foot .btn { width: 100%; } .form-foot { gap: var(--s-3); } }

	/* ── Aside ── */
	.contact-aside { display: grid; gap: var(--s-4); align-content: start; }
	.aside__lead { margin-bottom: calc(var(--s-1) * -1); }
	.route { display: grid; gap: var(--s-2); padding: var(--s-5); }
	.route__icon {
		display: grid; place-items: center; width: 32px; height: 32px; border-radius: var(--r-sm);
		background: var(--surface); border: 1px solid var(--line); color: var(--ink-2); margin-bottom: var(--s-1);
	}
	.route__title { font-size: var(--text-base); }
	.route__body { font-size: var(--text-sm); color: var(--ink-3); line-height: 1.6; }
	.route__cta { font-size: var(--text-sm); margin-top: var(--s-1); }
	.aside__fine { font-size: var(--text-xs); color: var(--ink-3); line-height: 1.7; padding-top: var(--s-2); }
</style>
