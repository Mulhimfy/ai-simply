---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import Newsletter from '../components/Newsletter.astro';
import { SITE_TITLE, SITE_URL, TOOL_CATEGORIES, TOOL_LISTING } from '../consts';
import { RATING_CRITERIA } from '../data/rating-criteria';
import { RSS_FEEDS } from '../utils/news.mjs';

const toolCount = (await getCollection('tools')).length;
const articleCount = (await getCollection('blog')).length;
const categoryCount = TOOL_CATEGORIES.length;
// Lazy glob: we only need the file count, not the contents.
const briefDays = Object.keys(import.meta.glob('../data/news/*.json')).length;

const stats = [
	{ n: briefDays, suffix: '', label: 'Days of briefs', sub: 'archived and searchable' },
	{ n: toolCount, suffix: '', label: 'Tools in the Toolbox', sub: `across ${categoryCount} categories` },
	{ n: articleCount, suffix: '', label: 'Explainers', sub: 'written in plain English' },
	{ n: RSS_FEEDS.length, suffix: '', label: 'Sources swept', sub: 'every morning, before the brief' },
];

const makes = [
	{
		icon: 'newspaper',
		title: 'The daily brief',
		href: '/',
		cta: "Read today's brief",
		body: 'Six things that changed in AI today. Each one gets a headline, why it matters to you, and what to do about it. Pick the angles you care about and the brief reorders itself.',
	},
	{
		icon: 'layout-grid',
		title: 'The Toolbox',
		href: '/tools/',
		cta: 'Open the Toolbox',
		body: `The reference section. ${toolCount} AI tools we have used, rated and written up, so that when the brief says "worth trying" there is somewhere to go and check.`,
	},
	{
		icon: 'book-open',
		title: 'Explainers',
		href: '/blog/',
		cta: 'Read the explainers',
		body: 'Longer pieces for when the brief is not enough — how a thing actually works, what it costs, and which of two tools you should pick.',
	},
];

const process = [
	{
		title: 'Read everything, once',
		body: `Every morning we pull the day's AI reporting from ${RSS_FEEDS.length} sources and group the stories that are really the same story.`,
	},
	{
		title: 'Keep what changed',
		body: 'A launch, a price cut, a rule, a result. If nothing about your week is different because of it, it does not make the brief.',
	},
	{
		title: 'Say why it matters',
		body: 'Each item is written for a person, not a press release: what changed, who it lands on, and what to do about it today.',
	},
	{
		title: 'Cap it at six items',
		body: 'Six, hard cap — that is what fits in three minutes. If a seventh is genuinely bigger than one already in, the weakest one goes.',
	},
];

const standards = [
	{
		icon: 'shield-check',
		title: 'A rating is never for sale',
		body: `Listings pay for the site — ${TOOL_LISTING.priceLabel} for a page in the Toolbox. What that buys is the page. It does not buy a score, a ranking, a place in the brief, or a kind word.`,
	},
	{
		icon: 'hand',
		title: 'We use the tools',
		body: 'Ratings come from at least two editors using a tool on real work for a week, on free and paid tiers. No vendor demos, no cherry-picked screenshots.',
	},
	{
		icon: 'link',
		title: 'Affiliate links are labelled',
		body: 'Some outbound links earn a commission. Those carry rel="sponsored" and a visible label, and they are chosen after the rating, never before it.',
	},
	{
		icon: 'pencil',
		title: 'We correct things in public',
		body: 'Spotted something wrong? Tell us and we fix the page, not the archive. Ratings get re-checked when a tool ships a major change, and at least every six months.',
	},
];

const ld = {
	'@context': 'https://schema.org',
	'@type': 'AboutPage',
	name: `About ${SITE_TITLE}`,
	url: `${SITE_URL}/about/`,
	publisher: {
		'@type': 'Organization',
		name: SITE_TITLE,
		url: SITE_URL,
		description: 'A daily three-minute brief on what changed in AI, why it matters, and what to do about it.',
	},
};
---

<Base
	title={`About ${SITE_TITLE}`}
	description="Know what matters in AI, in three minutes, every day. How the brief is made, how we rate tools, and how the site pays for itself."
>
	<script type="application/ld+json" slot="head" set:html={JSON.stringify(ld)} />

	<PageHero
		crumbs={[{ name: 'About' }]}
		eyebrow="About"
		title="Know what matters in AI. In three *minutes*. Every day."
		lead="AI Briefs is a daily brief, not a news feed. We read the day's AI coverage, throw away everything that does not change anything, and write down what is left — what happened, why it matters to you, and what to do about it."
	>
		<div class="hero-actions">
			<a href="/" class="btn btn--accent">Read today's brief <Icon name="arrow-right" class="icon--arrow" /></a>
			<a href="#how" class="btn btn--ghost">How it's made</a>
		</div>
	</PageHero>

	<section class="section section--tight" aria-label="By the numbers">
		<div class="container">
			<ul class="stats" role="list" data-stagger>
				{stats.map((s) => (
					<li class="stat" data-reveal>
						<span class="stat__n tnum" data-count={s.n} data-suffix={s.suffix}>{s.n}{s.suffix}</span>
						<span class="stat__label">{s.label}</span>
						<span class="stat__sub">{s.sub}</span>
					</li>
				))}
			</ul>
		</div>
	</section>

	<section class="section section--tight" aria-labelledby="makes-title">
		<div class="container">
			<div class="section-head">
				<div class="section-head__title">
					<span class="eyebrow">What's here</span>
					<h2 id="makes-title">One product, two <em class="serif">reference</em> sections</h2>
					<p class="section-head__desc">The brief is the thing. Everything else exists so the brief can be short.</p>
				</div>
			</div>
			<div class="makes" data-stagger>
				{makes.map((m) => (
					<article class="make card card--pad card--hover" data-reveal>
						<span class="make__icon"><Icon name={m.icon} size={20} /></span>
						<h3 class="make__title">{m.title}</h3>
						<p class="make__body">{m.body}</p>
						<a href={m.href} class="link-arrow make__cta">{m.cta} <Icon name="arrow-right" size={16} /></a>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="section section--tight" id="how" aria-labelledby="how-title">
		<div class="container">
			<div class="how">
				<div class="how__copy">
					<span class="eyebrow">Editorial process</span>
					<h2 id="how-title">How the brief gets <em class="serif">made</em></h2>
					<p class="how__lead">
						Same routine every morning. The point is subtraction: most AI news is an announcement about an
						announcement, and the job is to notice the few things that actually move.
					</p>
					<ol class="steps" role="list" data-stagger>
						{process.map((s, i) => (
							<li class="step" data-reveal>
								<span class="step__n tnum">{String(i + 1).padStart(2, '0')}</span>
								<div>
									<h3 class="step__title">{s.title}</h3>
									<p class="step__body">{s.body}</p>
								</div>
							</li>
						))}
					</ol>
				</div>

				<aside class="sources card card--pad card--sunk" aria-labelledby="sources-title">
					<span class="eyebrow">What we read</span>
					<h3 class="sources__title" id="sources-title">The morning sweep</h3>
					<p class="sources__body">
						Every brief starts from the same {RSS_FEEDS.length} feeds, pulled fresh each morning. Days with an
						editorial write-up say so; days without one show the clustered headlines and their coverage count
						rather than invented commentary.
					</p>
					<ul class="sources__list" role="list">
						{RSS_FEEDS.map((f) => (
							<li><Icon name="rss" size={13} /> {f.source}</li>
						))}
					</ul>
					<p class="sources__fine">
						Every item in a brief links out to the reporting it came from. We link to the source, not to a
						rewrite of it.
					</p>
				</aside>
			</div>
		</div>
	</section>

	<section class="section section--tight" aria-labelledby="rate-title">
		<div class="container">
			<div class="section-head">
				<div class="section-head__title">
					<span class="eyebrow">Ratings</span>
					<h2 id="rate-title">How we <em class="serif">score</em> a tool</h2>
					<p class="section-head__desc">Five criteria, fixed weights, applied the same way to every tool in the Toolbox.</p>
				</div>
				<a href="/rating-methodology/" class="link-arrow">Full methodology <Icon name="arrow-right" size={16} /></a>
			</div>
			<ul class="crits" role="list" data-stagger>
				{RATING_CRITERIA.map((c) => (
					<li class="crit" data-reveal>
						<span class="crit__icon"><Icon name={c.icon} size={17} /></span>
						<div class="crit__main">
							<div class="crit__top">
								<h3 class="crit__name">{c.name}</h3>
								<span class="crit__w tnum">{c.weight}%</span>
							</div>
							<div class="crit__bar" role="presentation"><span style={`--w:${c.weight}%`}></span></div>
							<p class="crit__short">{c.short}</p>
						</div>
					</li>
				))}
			</ul>
		</div>
	</section>

	<section class="section section--tight" aria-labelledby="money-title">
		<div class="container">
			<div class="section-head">
				<div class="section-head__title">
					<span class="eyebrow">Independence</span>
					<h2 id="money-title">Who pays, and what that <em class="serif">doesn't</em> buy</h2>
					<p class="section-head__desc">
						Readers pay nothing and never will. The site is funded by tool makers who buy a listing —
						so it matters that you know exactly where the line is.
					</p>
				</div>
				<a href="/pricing/" class="link-arrow">See pricing <Icon name="arrow-right" size={16} /></a>
			</div>
			<div class="standards" data-stagger>
				{standards.map((s) => (
					<article class="standard" data-reveal>
						<span class="standard__icon"><Icon name={s.icon} size={17} /></span>
						<h3 class="standard__title">{s.title}</h3>
						<p class="standard__body">{s.body}</p>
					</article>
				))}
			</div>
			<p class="standards__fine">
				We also run Google Analytics to count pages, and store your theme, saved tools and chosen angles in your own
				browser. The details are in the <a href="/privacy/" class="link-u">privacy policy</a>.
				Think a rating is wrong? <a href="/contact/" class="link-u">Tell us</a> — we would rather fix it than defend it.
			</p>
		</div>
	</section>

	<Newsletter variant="band" />
</Base>

<style>
	.hero-actions { display: flex; flex-wrap: wrap; gap: var(--s-3); }
	@media (max-width: 480px) { .hero-actions .btn { width: 100%; } }

	/* ── Stats ── */
	.stats {
		display: grid; grid-template-columns: repeat(4, minmax(0, 1fr));
		border: 1px solid var(--line); border-radius: var(--r-lg); overflow: hidden;
		background: var(--surface);
	}
	.stat {
		display: grid; gap: 2px; padding: var(--s-6) var(--s-5);
		border-right: 1px solid var(--line);
	}
	.stat:last-child { border-right: 0; }
	.stat__n { font-size: var(--text-3xl); font-weight: 600; letter-spacing: -0.04em; line-height: 1.05; color: var(--ink); }
	.stat__label { font-size: var(--text-sm); font-weight: 600; color: var(--ink); }
	.stat__sub { font-size: var(--text-xs); color: var(--ink-3); }
	@media (max-width: 860px) {
		.stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
		.stat:nth-child(2n) { border-right: 0; }
		.stat:nth-child(-n + 2) { border-bottom: 1px solid var(--line); }
	}

	/* ── What's here ── */
	.makes { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-5); }
	@media (max-width: 900px) { .makes { grid-template-columns: minmax(0, 1fr); } }
	.make { display: flex; flex-direction: column; gap: var(--s-3); }
	.make__icon {
		display: grid; place-items: center; width: 40px; height: 40px; border-radius: var(--r-sm);
		background: var(--accent-soft); color: var(--accent-ink); margin-bottom: var(--s-1);
	}
	.make__title { font-size: var(--text-lg); }
	.make__body { font-size: var(--text-sm); color: var(--ink-2); line-height: 1.65; }
	.make__cta { margin-top: auto; padding-top: var(--s-2); font-size: var(--text-sm); }

	/* ── Process ── */
	.how { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); gap: var(--s-10); align-items: start; }
	@media (max-width: 940px) { .how { grid-template-columns: minmax(0, 1fr); gap: var(--s-8); } }
	.how__copy { display: grid; gap: var(--s-4); }
	.how__lead { color: var(--ink-2); font-size: var(--text-md); line-height: 1.65; max-width: 58ch; }
	.steps { display: grid; gap: var(--s-6); margin-top: var(--s-4); }
	.step { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: var(--s-4); align-items: start; }
	.step__n {
		font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 600; color: var(--accent);
		padding-top: 3px; letter-spacing: 0.04em;
	}
	.step__title { font-size: var(--text-base); margin-bottom: 4px; }
	.step__body { font-size: var(--text-sm); color: var(--ink-3); line-height: 1.6; }

	.sources { display: grid; gap: var(--s-3); align-content: start; position: sticky; top: calc(var(--header-h, 64px) + 24px); }
	@media (max-width: 940px) { .sources { position: static; } }
	.sources__title { font-size: var(--text-lg); }
	.sources__body { font-size: var(--text-sm); color: var(--ink-3); line-height: 1.6; }
	.sources__list {
		display: flex; flex-wrap: wrap; gap: var(--s-2);
		padding-top: var(--s-4); margin-top: var(--s-1); border-top: 1px solid var(--line);
	}
	.sources__list li {
		display: inline-flex; align-items: center; gap: 6px;
		padding: 5px 10px; border-radius: var(--r-full); border: 1px solid var(--line-2);
		font-size: var(--text-xs); font-weight: 500; color: var(--ink-2); background: var(--surface);
	}
	.sources__list :global(.icon) { color: var(--accent); }
	.sources__fine { font-size: var(--text-xs); color: var(--ink-3); line-height: 1.6; padding-top: var(--s-2); }

	/* ── Criteria ── */
	.crits { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: var(--s-4) var(--s-8); }
	.crit { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: var(--s-4); align-items: start; padding-block: var(--s-3); }
	.crit__icon {
		display: grid; place-items: center; width: 36px; height: 36px; border-radius: var(--r-sm);
		border: 1px solid var(--line); background: var(--surface-2); color: var(--ink-2);
	}
	.crit__main { display: grid; gap: var(--s-2); min-width: 0; }
	.crit__top { display: flex; align-items: baseline; justify-content: space-between; gap: var(--s-3); }
	.crit__name { font-size: var(--text-base); }
	.crit__w { font-family: var(--font-mono); font-size: var(--text-xs); font-weight: 600; color: var(--accent-ink); }
	.crit__bar { height: 4px; border-radius: var(--r-full); background: var(--surface-3); overflow: hidden; }
	.crit__bar > span {
		display: block; height: 100%; width: var(--w); border-radius: inherit;
		background: var(--accent); transform-origin: left;
	}
	.crit__short { font-size: var(--text-sm); color: var(--ink-3); line-height: 1.55; }

	/* ── Standards ── */
	.standards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-8) var(--s-10); }
	@media (max-width: 780px) { .standards { grid-template-columns: minmax(0, 1fr); gap: var(--s-6); } }
	.standard { display: grid; gap: var(--s-2); }
	.standard__icon {
		display: grid; place-items: center; width: 34px; height: 34px; border-radius: var(--r-full);
		background: var(--accent-soft); color: var(--accent-ink); margin-bottom: var(--s-1);
	}
	.standard__title { font-size: var(--text-base); }
	.standard__body { font-size: var(--text-sm); color: var(--ink-2); line-height: 1.65; }
	.standards__fine {
		margin-top: var(--s-10); padding-top: var(--s-5); border-top: 1px solid var(--line);
		font-size: var(--text-sm); color: var(--ink-3); line-height: 1.7; max-width: 76ch;
	}
</style>
